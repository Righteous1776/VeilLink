{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeo Agent Exchange Message V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "governance_epoch", "constitution_version", "message_id", "created_at", "sender", "type", "delivery", "priority", "targets", "subject_zh_cn", "body_zh_cn", "references", "in_reply_to", "response_required", "due_before_next_substantive_work"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "governance_epoch": {"type": "integer", "minimum": 1},
    "constitution_version": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "pattern": "^MSG-[0-9]{8}-[0-9]{6}-[A-Za-z0-9._-]+-[A-F0-9]{6,12}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "sender": {"type": "object", "required": ["task_id", "session_id", "profile", "lane", "governor_identity"], "properties": {"task_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}, "lane": {"type": "string", "minLength": 1}, "governor_identity": {"type": ["string", "null"]}}, "additionalProperties": false},
    "type": {"enum": ["INFO", "WORK_REPORT", "REQUIRED_READ", "REQUIRED_RESPONSE", "REPLY", "TASK_REQUEST", "TASK_ASSIGNMENT", "BLOCKER", "HANDOFF", "DECISION", "OWNER_DECISION_REQUIRED"]},
    "delivery": {"enum": ["INFO", "REQUIRED_READ", "REQUIRED_RESPONSE"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(ALL|GOVERNOR|CHIEF_STRATEGIST|GOVERNOR:[A-Za-z0-9._-]+|TASK:[A-Za-z0-9._-]+|PROFILE:[A-Za-z0-9._-]+|LANE:[A-Za-z0-9._-]+)$"}},
    "subject_zh_cn": {"type": "string", "minLength": 1},
    "body_zh_cn": {"type": "string", "minLength": 1},
    "work_report": {"type": ["object", "null"], "properties": {"completed": {"type": "array", "items": {"type": "string"}}, "artifacts": {"type": "array", "items": {"type": "string"}}, "shared_state_changed": {"type": "array", "items": {"type": "string"}}, "not_done": {"type": "array", "items": {"type": "string"}}, "downstream_read": {"type": "array", "items": {"type": "string"}}, "notify_targets": {"type": "array", "items": {"type": "string"}}, "next_recommendation": {"type": "string"}}, "additionalProperties": false},
    "references": {"type": "object", "required": ["branch", "commit", "files", "task_state"], "properties": {"branch": {"type": "string"}, "commit": {"type": "string"}, "files": {"type": "array", "items": {"type": "string"}}, "task_state": {"type": "string"}}, "additionalProperties": false},
    "in_reply_to": {"type": ["string", "null"]},
    "response_required": {"type": "boolean"},
    "due_before_next_substantive_work": {"type": "boolean"},
    "task_request": {"type": ["object", "null"]},
    "task_assignment": {"type": ["object", "null"]},
    "owner_decision_required": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "REPLY"}}}, "then": {"properties": {"in_reply_to": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"type": {"const": "WORK_REPORT"}}}, "then": {"properties": {"work_report": {"type": "object"}}}}
  ]
}
