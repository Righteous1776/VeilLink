{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeo Agent Exchange Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "governance_epoch", "constitution_version", "message_id", "recipient_task_id", "recipient_session_id", "recipient_profile", "recipient_lane", "recipient_governor_identity", "status", "read_at", "response_message_id", "note_zh_cn"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "governance_epoch": {"type": "integer", "minimum": 1},
    "constitution_version": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "pattern": "^MSG-[0-9]{8}-[0-9]{6}-[A-Za-z0-9._-]+-[A-F0-9]{6,12}$"},
    "recipient_task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "recipient_session_id": {"type": "string", "minLength": 1},
    "recipient_profile": {"type": "string", "minLength": 1},
    "recipient_lane": {"type": "string", "minLength": 1},
    "recipient_governor_identity": {"type": ["string", "null"]},
    "status": {"enum": ["READ", "RESPONDED", "NOT_APPLICABLE", "BLOCKED"]},
    "read_at": {"type": "string", "format": "date-time"},
    "response_message_id": {"type": ["string", "null"]},
    "note_zh_cn": {"type": "string"}
  }
}
