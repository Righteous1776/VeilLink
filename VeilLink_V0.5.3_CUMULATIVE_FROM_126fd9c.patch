+enum TacticalTerrain: String, Codable, Hashable {
+    case plain
+    case road
+    case forest
+    case hill
+    case river
+    case ford
+    case camp
+
+    var title: String {
+        switch self {
+        case .plain: return "平原"
+        case .road: return "驿道"
+        case .forest: return "林地"
