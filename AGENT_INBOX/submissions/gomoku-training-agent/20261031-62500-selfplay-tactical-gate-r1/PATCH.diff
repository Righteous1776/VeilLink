+    func testForcedGapBlockPrecedesLearningAndRootRank() {
+        var state = GomokuState()
+        // Black has 7,3 / 7,4 / 7,6 / 7,7; white must occupy 7,5 (index 110).
+        for (ply, index) in [108, 0, 109, 1, 111, 2, 112].enumerated() {
+            XCTAssertTrue(state.apply(index: index, actor: ply.isMultiple(of: 2) ? .host : .guest))
+        }
+        let move = GomokuBot.chooseMove(in: state, for: .guest, budget: .deterministicTest)
+        XCTAssertEqual(move?.index, 110)
+    }
