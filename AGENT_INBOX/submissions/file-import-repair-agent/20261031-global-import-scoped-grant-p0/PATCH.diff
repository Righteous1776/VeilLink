+        // Open the picker grant on the calling task BEFORE crossing the detached
+        // task boundary. Hold it until the coordinated copy has completed.
+        let granted = sourceURL.startAccessingSecurityScopedResource()
+        defer { if granted { sourceURL.stopAccessingSecurityScopedResource() } }
+
+        let worker = Task.detached(priority: .userInitiated) {
+            try materializeWithHeldScope(sourceURL, acceptedExtensions: acceptedExtensions)
+        }
+        return try await withTaskCancellationHandler(
+            operation: { try await worker.value },
+            onCancel: { worker.cancel() }
+        )
+    }
+
+    static func materialize(
+        _ sourceURL: URL,
+        acceptedExtensions: Set<String> = []
+    ) throws -> URL {
+        let granted = sourceURL.startAccessingSecurityScopedResource()
+        defer { if granted { sourceURL.stopAccessingSecurityScopedResource() } }
+        return try materializeWithHeldScope(sourceURL, acceptedExtensions: acceptedExtensions)
+    }
+
+    private static func materializeWithHeldScope(
+        _ sourceURL: URL,
+        acceptedExtensions: Set<String>
+    ) throws -> URL {
+        guard sourceURL.isFileURL else {
+            throw VeilImportedFileAccessError.inaccessible
+        }
+        if Task.isCancelled { throw CancellationError() }
+        let normalizedExtensions = Set(acceptedExtensions.map { $0.lowercased() })
+        if !normalizedExtensions.isEmpty,
+           !normalizedExtensions.contains(sourceURL.pathExtension.lowercased()) {
+            throw VeilImportedFileAccessError.unsupportedExtension(
+                expected: normalizedExtensions.sorted()
+            )
         }
 
