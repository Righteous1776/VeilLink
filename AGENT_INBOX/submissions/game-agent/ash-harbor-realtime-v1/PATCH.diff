+            VStack(spacing: 3) {
+                Text("TIME")
+                    .font(.system(size: 8, weight: .bold, design: .monospaced))
+                    .foregroundColor(.white.opacity(0.42))
+
+                Text("\(Int(model.snapshot.timeRemaining))")
+                    .font(.caption.bold().monospacedDigit())
+                    .foregroundColor(.white)
