+                y: 17
+            )
+        )
+
+        hullPath.addLine(
+            to: CGPoint(
+                x: -39,
+                y: 4
+            )
+        )
+
+        hullPath.addLine(
+            to: CGPoint(
+                x: -39,
+                y: -4
+            )
+        )
+
+        hullPath.addQuadCurve(
+            to: CGPoint(
+                x: -26,
+                y: -15
+            ),
+            control: CGPoint(
+                x: 8,
+                y: -17
+            )
+        )
+
+        hullPath.closeSubpath()
+
+        let hull = SKShapeNode(path: hullPath)
+        hull.fillColor = UIColor(
+            red: 0.18,
+            green: 0.29,
+            blue: 0.34,
+            alpha: 1
+        )
+        hull.strokeColor =
+            UIColor(
+                red: 0.64,
