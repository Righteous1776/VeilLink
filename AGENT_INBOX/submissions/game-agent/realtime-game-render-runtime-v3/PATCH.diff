+    private static func seed(
+        from text: String
+    ) -> UInt64 {
+        var hash: UInt64 =
+            1469598103934665603
+
+        for byte in text.utf8 {
+            hash ^= UInt64(byte)
+            hash &*= 1099511628211
+        }
+
+        return hash
+    }
