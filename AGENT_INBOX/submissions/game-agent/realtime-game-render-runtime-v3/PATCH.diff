+
+    private func buildGridLines() {
+        gridLayer.removeAllChildren()
+
+        for node in state.nodes {
+            if let marker =
+                nodeMarkers[node.id] {
+                gridLayer.addChild(
+                    marker
+                )
+            }
+        }
+
+        gridEdgeNodes.removeAll()
+
+        for edge in state.edges {
+            guard let a = state.nodes.first(
+                where: { $0.id == edge.a }
+            ),
+            let b = state.nodes.first(
+                where: { $0.id == edge.b }
+            ) else {
+                continue
+            }
+
+            let path = CGMutablePath()
+            path.move(
+                to: CGPoint(
+                    x: a.x,
+                    y: a.y
+                )
+            )
+            path.addLine(
+                to: CGPoint(
+                    x: b.x,
+                    y: b.y
+                )
+            )
+
+            let line = SKShapeNode(
+                path: path
+            )
+
+            line.strokeColor = UIColor(
+                red: 0.30,
+                green: 0.08,
+                blue: 0.08,
+                alpha: 0.34
+            )
+            line.lineWidth = 5
+            line.glowWidth = 1
+
+            let key =
+                edgeKey(
+                    edge.a,
+                    edge.b
+                )
+
+            gridLayer.addChild(line)
+            gridEdgeNodes[key] = line
+        }
+    }
+
+    private func rebuildWeather() {
+        weatherLayer.removeAllChildren()
+        rainEmitter = nil
+
+        let rain = SKEmitterNode()
