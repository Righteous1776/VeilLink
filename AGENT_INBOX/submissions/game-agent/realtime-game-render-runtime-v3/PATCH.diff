+        )
+        rain.particlePositionRange =
+            CGVector(
+                dx: size.width * 1.6,
+                dy: 24
+            )
+        rain.particleSpeed = 850
+        rain.particleSpeedRange = 190
+        rain.emissionAngle =
+            -.pi / 2.10
+        rain.emissionAngleRange = 0.05
+        rain.particleAlpha = 0.31
+        rain.particleScale = 0.86
+        rain.particleColor = UIColor(
+            red: 0.65,
+            green: 0.80,
+            blue: 0.94,
+            alpha: 1
