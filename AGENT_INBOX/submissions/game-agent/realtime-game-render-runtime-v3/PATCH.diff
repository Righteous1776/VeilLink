+    }
+
+    private func rebuildParticles() {
+        particleLayer.removeAllChildren()
+
+        let emitter = SKEmitterNode()
+
+        emitter.particleTexture =
+            makeDotTexture(
+                diameter: 4
+            )
+        emitter.particleBirthRate =
+            78 *
+            renderProfile
+                .particleMultiplier
