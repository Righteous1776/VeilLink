+            white: 0.08,
+            alpha: 1
+        )
+        noiseOverlay.colorBlendFactor = 1
+        noiseOverlay.blendMode = .add
+        noiseOverlay.zPosition = 90
+        noiseOverlay.shader =
+            assetRuntime.shader(
+                    named:
+                        "SHKDynamicGrayNoise"
+                )
+        noiseOverlay.alpha =
+            noiseOverlay.shader == nil
+            ? 0
+            : 0.055 *
+                renderProfile
+                    .noiseMultiplier
+
+        let rect = CGRect(
