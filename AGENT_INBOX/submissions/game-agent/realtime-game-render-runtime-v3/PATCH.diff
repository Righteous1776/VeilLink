+                green:
+                    0.025 +
+                    0.018 * depthBand,
+                blue:
+                    0.04 +
+                    0.025 * depthBand,
+                alpha: 0.42
+            )
+            silhouette.strokeColor = .clear
+
+            abyssMid.addChild(
+                silhouette
+            )
+        }
+    }
