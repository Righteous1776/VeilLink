+
+final class SignalDiveScene: SKScene {
+    var onSnapshot: ((SignalDiveSnapshot) -> Void)?
+    var onEvent: ((SignalDiveEvent) -> Void)?
+
+    private var state: SignalDiveState
+    private var input = SignalDiveInput()
