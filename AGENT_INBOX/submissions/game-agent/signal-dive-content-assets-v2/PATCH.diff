+
+        cameraNode.removeAction(
+            forKey: "dive-shake"
+        )
+
+        cameraNode.run(
+            .sequence([
+                .moveBy(
+                    x: amplitude,
+                    y: -amplitude * 0.4,
+                    duration: 0.025
+                ),
+                .moveBy(
+                    x: -amplitude * 1.5,
+                    y: amplitude * 0.7,
+                    duration: 0.035
+                ),
+                .moveBy(
+                    x: amplitude * 0.5,
+                    y: -amplitude * 0.3,
+                    duration: 0.045
+                )
