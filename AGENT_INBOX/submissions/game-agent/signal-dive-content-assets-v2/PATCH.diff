+            )
+        emitter.particleBirthRate = 0
+        emitter.numParticlesToEmit = count
+        emitter.particleLifetime = 0.72
+        emitter.particleSpeed = 105
+        emitter.particleSpeedRange = 64
+        emitter.emissionAngleRange = .pi * 2
