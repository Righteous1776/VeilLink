+    private func contactRadius(
+        _ kind: SignalDiveContact.Kind
+    ) -> CGFloat {
+        switch kind {
+        case .terrain:
+            return 4
+
+        case .beacon:
+            return 6
+
+        case .biological:
+            return 8
+
+        case .massiveUnknown:
