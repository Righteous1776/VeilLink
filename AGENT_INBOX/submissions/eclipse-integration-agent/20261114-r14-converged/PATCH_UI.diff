+}
+
+struct VeilEclipseTraceSheet: View {
+    let isThinking: Bool
+    let matchFinished: Bool
+    let lastCompletedMilliseconds: Int?
+    let actualSearchStartedAt: Date?
+    let committedMoves: [VeilEclipseTracePolicy.PlacedMove]
+    let difficultyTitle: String
+    let searchModeTitle: String
+    /// Only accepts coordinate-free, pre-redacted metrics. R5 integration will
+    /// sanitize engine traces BEFORE sending anything to this view.
+    /// Main currently passes nil and never fabricates depth/node totals.
+    let liveMetrics: VeilEclipseTracePolicy.LiveMetrics?
+    /// Loads a bounded page; returns nil on storage failure. Never reads chess
+    /// advice/analyses; only validated already committed game records.
+    let archivedMatchPage: (Int, Int) -> VeilGomokuMatchArchive.Page?
+
+    @Environment(\.presentationMode) private var presentationMode
+    @ObservedObject private var appearance = VeilAppearanceController.shared
+    @State private var replayPly = 0
+    @State private var playing = false
+    @State private var savedMatches: [VeilGomokuMatchArchive.Match] = []
+    @State private var selectedMatchID: String?
+    @State private var nextOffset: Int? = 0
+    @State private var knownMatchCount = 0
+    @State private var unreadableCount = 0
+
+    private var replayFrames: [VeilEclipseTracePolicy.ReplayFrame] {
+        let stored = savedMatches.first { $0.id == selectedMatchID }
+        return VeilEclipseTracePolicy.replayFrames(
+            stored?.placedMoves ?? committedMoves,
+            matchFinished: matchFinished,
+            separateReadOnlyPanel: true
+        )
+    }
+
+    private func loadArchivePage() {
+        guard matchFinished, let offset = nextOffset else { return }
+        guard let page = archivedMatchPage(offset, 25) else { nextOffset = nil; return }
+        let existingIDs = Set(savedMatches.map(\.id))
+        savedMatches += page.matches.filter { !existingIDs.contains($0.id) }
+        knownMatchCount = page.totalFiles
+        unreadableCount += page.invalidFiles
+        nextOffset = page.nextOffset
+    }
+
+
+    var body: some View {
+        NavigationView {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 16) {
+                    HStack {
+                        Label(matchFinished ? "赛后只读回放" : "对局中 · 无落点提示",
+                              systemImage: matchFinished ? "lock.shield" : "eye.slash")
+                            .foregroundColor(VeilTheme.goldBright)
+                            .font(.caption.weight(.semibold))
+                        Spacer()
+                    }
+                    VeilEclipseComputeConsole(
+                        isComputing: isThinking,
+                        actualSearchStartedAt: actualSearchStartedAt,
+                        liveMetrics: liveMetrics,
+                        compact: false
+                    )
+                    VStack(alignment: .leading, spacing: VeilSpacing.xxs) {
+                        HStack(spacing: VeilSpacing.sm) {
+                            Text("当前棋力档位")
+                                .foregroundColor(VeilTheme.secondaryText)
+                            Spacer(minLength: 4)
+                            Text(VeilEclipseTierPresentation.shortName(difficultyTitle))
+                                .foregroundColor(VeilTheme.text)
+                            Text("· " + searchModeTitle)
+                                .foregroundColor(VeilTheme.secondaryText)
+                        }
+                        .font(.caption)
+                        if VeilEclipseTierPresentation.hasSearchBudgetMultiplier(difficultyTitle) {
+                            Text(VeilEclipseTierPresentation.multiplierDisclosure)
+                                .font(.caption2)
+                                .foregroundColor(VeilTheme.secondaryText)
+                        }
+                    }
+                    .veilCard()
+                    VStack(alignment: .leading, spacing: VeilSpacing.sm) {
+                        HStack(spacing: VeilSpacing.sm) {
+                            metric("完成深度", liveMetrics?.completedDepth.map { "D\($0)" } ?? "—")
+                            metric("搜索节点", liveMetrics?.visitedNodes.map(String.init) ?? "—")
+                            metric("上步耗时", lastCompletedMilliseconds.map { "\($0)ms" } ?? "—")
+                        }
+                        Text(liveMetrics == nil
+                             ? "当前版本尚无实时深度/节点流；数值不会伪造。"
+                             : "真实引擎指标 · 抽象图不代表搜索路径")
+                            .font(.caption2)
+                            .foregroundColor(VeilTheme.secondaryText)
+                    }
+                    .veilCard()
+                    if matchFinished {
+                        VStack(alignment: .leading, spacing: 9) {
+                            HStack {
+                                Text("历次对局 · \(knownMatchCount) 份")
+                                    .font(.headline)
+                                    .foregroundColor(VeilTheme.text)
+                                Spacer()
+                                if selectedMatchID != nil {
+                                    Button("返回本局") {
+                                        selectedMatchID = nil
+                                        replayPly = max(0, replayFrames.count - 1)
+                                        playing = false
+                                    }
+                                    .font(.caption.weight(.semibold))
+                                    .foregroundColor(VeilTheme.goldBright)
+                                }
+                            }
+                            ForEach(savedMatches) { saved in
+                                Button {
+                                    guard saved.isReplayable else { return }
+                                    selectedMatchID = saved.id
+                                    playing = false
+                                    replayPly = saved.moves.count
+                                } label: {
+                                    HStack(spacing: 8) {
+                                        Image(systemName: "clock.arrow.circlepath")
+                                            .foregroundColor(VeilTheme.gold)
+                                        VStack(alignment: .leading, spacing: 2) {
+                                            Text(saved.status.title + " · \(saved.moves.count) 手")
+                                                .font(.caption.weight(.semibold))
+                                            Text(saved.updatedAt.formatted(date: .abbreviated, time: .shortened))
+                                                .font(.caption2)
+                                                .foregroundColor(VeilTheme.secondaryText)
+                                        }
+                                        Spacer()
+                                        Image(systemName: selectedMatchID == saved.id ? "checkmark.circle.fill" : "chevron.right")
+                                            .foregroundColor(VeilTheme.goldBright)
+                                    }
+                                    .foregroundColor(VeilTheme.text)
+                                    .padding(8)
+                                    .background(VeilTheme.subtleFill, in: RoundedRectangle(cornerRadius: 9))
+                                }
+                                .buttonStyle(.plain)
+                                .disabled(!saved.isReplayable)
+                            }
+                            if nextOffset != nil {
+                                Button("加载更多历史对局") { loadArchivePage() }
+                                    .font(.caption.weight(.semibold))
+                                    .foregroundColor(VeilTheme.goldBright)
+                            }
+                            if unreadableCount > 0 {
+                                Text("另有 \(unreadableCount) 份棋谱校验失败，原始文件已保留。")
+                                    .font(.caption2)
+                                    .foregroundColor(VeilTheme.danger)
+                            }
+                        }
+                        .veilCard()
+                    }
+                    if matchFinished && replayFrames.count > 1 {
+                        Divider()
+                        Text("完整棋局 · 已发生落子")
+                            .font(.headline)
+                        Text("以下是存档中真实发生的棋步，不显示未落下的候选点、预测走法或风险提示。")
+                            .font(.caption)
+                            .foregroundColor(VeilTheme.secondaryText)
+                        EclipseCommittedBoard(frame: replayFrames[min(replayPly, replayFrames.count-1)])
+                            .aspectRatio(1, contentMode: .fit)
+                            .veilCard()
+                            .accessibilityLabel("已完成棋局，第 \(replayPly) 手，独立只读棋盘")
+                        HStack {
+                            Text("第 \(replayPly) / \(replayFrames.count - 1) 手")
+                                .font(.subheadline.monospacedDigit())
+                            Spacer()
+                            Button(playing ? "暂停" : "逐步播放") { playing.toggle() }
+                                .buttonStyle(.bordered)
+                        }
+                        Slider(value: Binding(
+                            get: { Double(replayPly) },
+                            set: { replayPly = Int($0); playing = false }
+                        ), in: 0...Double(replayFrames.count - 1), step: 1)
+                        HStack {
+                            Button("上一步") { playing = false; replayPly = max(0, replayPly-1) }
+                                .disabled(replayPly == 0)
+                            Spacer()
+                            Button("下一步") {
+                                playing = false
+                                replayPly = min(replayFrames.count-1, replayPly+1)
+                            }
+                                .disabled(replayPly == replayFrames.count-1)
+                        }
+                        .buttonStyle(.bordered)
+                    } else {
+                        Text(matchFinished ? "本局的已验证走子记录暂不可用。"
+                             : "为保证公平，对局进行时不会显示棋盘推演、推荐点、对方威胁位置或主变路线。赛后才能查看实际棋步。")
+                            .font(.subheadline)
+                            .foregroundColor(VeilTheme.secondaryText)
+                            .padding(.vertical, 12)
+                    }
+                }
+                .frame(maxWidth: 520)
+                .padding(18)
+            }
+            .background(VeilAmbientBackground())
+            .navigationTitle("ECLIPSE // TRACE")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarTrailing) {
+                    Button("完成") { presentationMode.wrappedValue.dismiss() }
+                }
+            }
+        }
+        .onAppear {
+            replayPly = replayFrames.count > 1 ? replayFrames.count - 1 : 0
+            playing = false
+            if matchFinished && savedMatches.isEmpty { loadArchivePage() }
+        }
+        .onDisappear { playing = false }
+        .onReceive(Timer.publish(every: 0.85, on: .main, in: .common).autoconnect()) { _ in
+            guard playing, matchFinished, replayFrames.count > 1 else { return }
+            if replayPly >= replayFrames.count - 1 { playing = false }
+            else { replayPly += 1 }
+        }
+        .accessibilityIdentifier("game.eclipse.trace")
+    }
+
+    private func metric(_ name: String, _ value: String) -> some View {
+        VStack(alignment: .leading, spacing: 5) {
+            Text(name).font(.caption2).foregroundColor(VeilTheme.secondaryText)
+            Text(value).font(.system(.subheadline, design: .monospaced).weight(.semibold))
+                .foregroundColor(VeilTheme.text)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .padding(VeilSpacing.sm)
+        .background(VeilTheme.subtleFill, in: VeilPanelShape(cut: 12, radius: 7))
+    }
+}
+
+/// A separate read-only board. Never overlays the interactive GomokuBoardView.
+private struct EclipseCommittedBoard: View {
+    let frame: VeilEclipseTracePolicy.ReplayFrame
+
+    var body: some View {
+        Canvas(opaque: false) { ctx, size in
+            let side = min(size.width, size.height)
+            let margin = side * 0.055
+            let spacing = (side - margin * 2) / 14
+            let background = CGRect(x: 0, y: 0, width: side, height: side)
+            // Same established board surface used by GomokuBoardView in
+            // VeilLink/UI/MiniGameViews.swift (not an invented light wood skin).
+            ctx.fill(Path(roundedRect: background, cornerRadius: 9),
+                     with: .color(Color(red: 0.42, green: 0.29, blue: 0.15).opacity(0.46)))
+            for step in 0..<15 {
+                let x = margin + CGFloat(step) * spacing
+                var vertical = Path()
+                vertical.move(to: CGPoint(x: x, y: margin))
+                vertical.addLine(to: CGPoint(x: x, y: side-margin))
+                ctx.stroke(vertical, with: .color(Color.white.opacity(0.27)), lineWidth: 0.65)
+                var horizontal = Path()
+                horizontal.move(to: CGPoint(x: margin, y: x))
+                horizontal.addLine(to: CGPoint(x: side-margin, y: x))
+                ctx.stroke(horizontal, with: .color(Color.white.opacity(0.27)), lineWidth: 0.65)
+            }
+            for star in [48, 56, 112, 168, 176] {
+                let x = margin + CGFloat(star % 15) * spacing
+                let y = margin + CGFloat(star / 15) * spacing
+                ctx.fill(Path(ellipseIn: CGRect(x: x-2.1, y: y-2.1,
+                                              width: 4.2, height: 4.2)),
+                         with: .color(Color.white.opacity(0.42)))
+            }
+            for (i, stone) in frame.cells.enumerated() where stone != 0 {
+                let x = margin + CGFloat(i % 15) * spacing
+                let y = margin + CGFloat(i / 15) * spacing
+                let diameter = spacing * 0.82
+                let circle = Path(ellipseIn: CGRect(x: x-diameter/2, y: y-diameter/2,
+                                                   width: diameter, height: diameter))
+                ctx.fill(circle, with: .color(stone == 1
+                    ? Color.black.opacity(0.96) : Color.white.opacity(0.96)))
+                if frame.lastCommittedIndex == i {
+                    let ring = Path(ellipseIn: CGRect(x: x-diameter*0.37, y: y-diameter*0.37,
+                                                     width: diameter*0.74, height: diameter*0.74))
+                    ctx.stroke(ring, with: .color(VeilTheme.gold), lineWidth: 1.7)
+                }
+            }
+        }
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+    }
+}
diff --git a/VeilLink/UI/VeilEclipseTracePolicy.swift b/VeilLink/UI/VeilEclipseTracePolicy.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/UI/VeilEclipseTracePolicy.swift
@@ -0,0 +1,140 @@
+import Foundation
+
+/// The user's live game is NEVER a coaching surface. This policy is kept
+/// outside SwiftUI so privacy/safety rules are unit-testable on Linux and iOS.
+/// A finished game permits a read-only replay of actual, committed moves only.
+enum VeilEclipseTracePolicy {
+    static let size = 15
+    static let capacity = size * size
+
+    struct PlacedMove: Sendable, Equatable {
+        let index: Int
+        /// 1 = black/host, 2 = white/guest.
+        let stone: UInt8
+        init(index: Int, stone: UInt8) {
+            self.index = index
+            self.stone = stone
+        }
+    }
+
+    struct ReplayFrame: Sendable, Equatable {
+        let cells: [UInt8]
+        let lastCommittedIndex: Int?
+        let committedPlyCount: Int
+    }
+
+    enum SearchOrigin: Sendable {
+        case measuredEngine
+        case recordedEngine
+        case exampleOnly
+    }
+
+    /// Internal engine values, never handed directly to the presentation layer.
+    struct RawSearchEvent: Sendable {
+        let origin: SearchOrigin
+        let completedDepth: Int?
+        let visitedNodes: Int?
+        let principalVariation: [Int]
+        let consideredIndices: [Int]
+        let explanation: String?
+    }
+
+    /// The only type the live SwiftUI widget will accept from a searcher.
+    /// It has no coordinate-bearing fields by construction.
+    struct LiveMetrics: Sendable, Equatable {
+        let completedDepth: Int?
+        let visitedNodes: Int?
+    }
+
+    static func liveMetrics(from event: RawSearchEvent?) -> LiveMetrics? {
+        guard let event, event.origin == .measuredEngine else { return nil }
+        return LiveMetrics(
+            completedDepth: event.completedDepth.flatMap { (1...64).contains($0) ? $0 : nil },
+            visitedNodes: event.visitedNodes.flatMap { (0...500_000_000).contains($0) ? $0 : nil }
+        )
+    }
+
+    /// Sanitized public view model. During any active game, ALL coordinates,
+    /// scored candidates, variations and opponent threats are withheld.
+    struct PublicAnalysis: Sendable, Equatable {
+        let completedDepth: Int?
+        let visitedNodes: Int?
+        let canReplaySpatialData: Bool
+        let actualMoves: [Int]
+        let explanation: String?
+    }
+
+    static func publicAnalysis(
+        from event: RawSearchEvent?,
+        matchFinished: Bool,
+        separateReadOnlyPanel: Bool,
+        verifiedReplay: [ReplayFrame]
+    ) -> PublicAnalysis {
+        guard let event, event.origin != .exampleOnly else {
+            return PublicAnalysis(completedDepth: nil, visitedNodes: nil,
+                                  canReplaySpatialData: false,
+                                  actualMoves: [], explanation: nil)
+        }
+        let finishedAndVerified = matchFinished && separateReadOnlyPanel && !verifiedReplay.isEmpty
+        // Recorded/example events are never passed off as live engine progress.
+        let depth = event.origin == .measuredEngine
+            ? event.completedDepth.flatMap { (1...64).contains($0) ? $0 : nil } : nil
+        let nodes = event.origin == .measuredEngine
+            ? event.visitedNodes.flatMap { (0...500_000_000).contains($0) ? $0 : nil } : nil
+        // Never display raw PV/candidate coordinates from a still-running game.
+        // Even after the game, replay ONLY actual played moves, not guesses.
+        let replayedMoves = finishedAndVerified
+            ? verifiedReplay.compactMap(\.lastCommittedIndex) : []
+        return PublicAnalysis(completedDepth: depth, visitedNodes: nodes,
+                              canReplaySpatialData: finishedAndVerified,
+                              actualMoves: replayedMoves,
+                              explanation: nil) // Unreviewed private search text is never a public hint.
+    }
+
+    /// Replay is reconstructed from the saved match journal only after match
+    /// completion. It validates turn order, duplicate cells, terminal moves,
+    /// and that the final board matches the authoritative GomokuState.
+    static func replayFrames(
+        _ moves: [PlacedMove],
+        matchFinished: Bool,
+        separateReadOnlyPanel: Bool,
+        expectedFinalBoard: [UInt8]? = nil
+    ) -> [ReplayFrame] {
+        guard matchFinished, separateReadOnlyPanel,
+              !moves.isEmpty, moves.count <= capacity else { return [] }
+        var board = [UInt8](repeating: 0, count: capacity)
+        var frames: [ReplayFrame] = [ReplayFrame(cells: board, lastCommittedIndex: nil, committedPlyCount: 0)]
+        var next: UInt8 = 1
+        for (offset, move) in moves.enumerated() {
+            guard (0..<capacity).contains(move.index), move.stone == next,
+                  board[move.index] == 0 else { return [] }
+            board[move.index] = move.stone
+            frames.append(ReplayFrame(cells: board, lastCommittedIndex: move.index,
+                                      committedPlyCount: offset + 1))
+            if hasFive(board, through: move.index, stone: next), offset != moves.count - 1 {
+                return [] // A valid completed match has no moves after a win.
+            }
+            next = next == 1 ? 2 : 1
+        }
+        if let expectedFinalBoard, expectedFinalBoard != board { return [] }
+        return frames
+    }
+
+    private static func hasFive(_ board: [UInt8], through index: Int, stone: UInt8) -> Bool {
+        let r = index / size, c = index % size
+        for (dr, dc) in [(0,1), (1,0), (1,1), (1,-1)] {
+            var length = 1
+            for direction in [-1,1] {
+                var rr = r + dr * direction, cc = c + dc * direction
+                while (0..<size).contains(rr), (0..<size).contains(cc),
+                      board[rr * size + cc] == stone {
+                    length += 1
+                    rr += dr * direction
+                    cc += dc * direction
+                }
+            }
+            if length >= 5 { return true }
+        }
+        return false
+    }
+}
diff --git a/VeilLink/UI/VeilEclipseTraceSessionGate.swift b/VeilLink/UI/VeilEclipseTraceSessionGate.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/UI/VeilEclipseTraceSessionGate.swift
@@ -0,0 +1,118 @@
+import Foundation
+
+/// UI-only privacy boundary for future native Gomoku R5/V9 search events.
+/// It cannot receive or expose a proposed move through PublicMetrics.
+/// Not wired to a search producer until the Integration Governor promotes one.
+struct VeilEclipseTraceSessionGate: Sendable {
+    struct Ticket: Hashable, Sendable {
+        let sessionID: String
+        let turn: Int
+        let generation: UInt64
+        let boardFingerprint: UInt64
+
+        init(sessionID: String, turn: Int, generation: UInt64, boardFingerprint: UInt64) {
+            self.sessionID = sessionID
+            self.turn = turn
+            self.generation = generation
+            self.boardFingerprint = boardFingerprint
+        }
+    }
+
+    enum Origin: Sendable {
+        case measuredNative
+        case recorded
+        case demonstration
+    }
+
+    /// Private to the search/telemetry layer. Never bind this type to SwiftUI.
+    struct PrivateEvent: Sendable {
+        let ticket: Ticket
+        let origin: Origin
+        let completedDepth: Int?
+        let visitedNodes: Int?
+        let principalVariation: [Int]
+        let candidateIndices: [Int]
+        let analysisText: String?
+        let isFinal: Bool
+
+        init(ticket: Ticket, origin: Origin, completedDepth: Int?, visitedNodes: Int?,
+             principalVariation: [Int] = [], candidateIndices: [Int] = [],
+             analysisText: String? = nil, isFinal: Bool = false) {
+            self.ticket = ticket
+            self.origin = origin
+            self.completedDepth = completedDepth
+            self.visitedNodes = visitedNodes
+            self.principalVariation = principalVariation
+            self.candidateIndices = candidateIndices
+            self.analysisText = analysisText
+            self.isFinal = isFinal
+        }
+    }
+
+    private(set) var ticket: Ticket?
+    private var acceptedDepth: Int?
+    private var acceptedNodes: Int?
+    private var lastEmittedAtMilliseconds: UInt64?
+    private var finalEventReceived = false
+
+    mutating func begin(_ newTicket: Ticket) {
+        ticket = newTicket.sessionID.isEmpty || newTicket.turn < 0 ? nil : newTicket
+        acceptedDepth = nil
+        acceptedNodes = nil
+        lastEmittedAtMilliseconds = nil
+        finalEventReceived = false
+    }
+
+    mutating func end() {
+        ticket = nil
+        acceptedDepth = nil
+        acceptedNodes = nil
+        lastEmittedAtMilliseconds = nil
+        finalEventReceived = false
+    }
+
+    /// Return only genuine, coordinate-free metrics. Reject stale/late events,
+    /// out-of-order totals, example traces, invalid counts, and updates above 8 Hz.
+    /// `nowMilliseconds` must come from a monotonic clock supplied by the caller.
+    mutating func accept(
+        _ event: PrivateEvent,
+        matchIsPlaying: Bool,
+        nowMilliseconds: UInt64
+    ) -> VeilEclipseTracePolicy.LiveMetrics? {
+        guard matchIsPlaying, let ticket, event.ticket == ticket,
+              event.origin == .measuredNative, !finalEventReceived else { return nil }
+        guard event.completedDepth != nil || event.visitedNodes != nil else { return nil }
+        if let depth = event.completedDepth {
+            guard (1...64).contains(depth), depth >= (acceptedDepth ?? 0) else { return nil }
+        }
+        if let nodes = event.visitedNodes {
+            guard (0...500_000_000).contains(nodes), nodes >= (acceptedNodes ?? 0) else { return nil }
+        }
+        if let last = lastEmittedAtMilliseconds, nowMilliseconds < last { return nil }
+        if let depth = event.completedDepth { acceptedDepth = depth }
+        if let nodes = event.visitedNodes { acceptedNodes = nodes }
+        if event.isFinal { finalEventReceived = true }
+        if !event.isFinal, let last = lastEmittedAtMilliseconds,
+           nowMilliseconds - last < 125 { return nil }
+        lastEmittedAtMilliseconds = nowMilliseconds
+        return VeilEclipseTracePolicy.LiveMetrics(
+            completedDepth: acceptedDepth, visitedNodes: acceptedNodes
+        )
+    }
+}
+
+/// UI labels follow the actual BoardBotDifficulty and BoardSearchMode strings.
+/// V9's 2×/4×/6× are compute-budget factors, not proven playing-strength gains.
+enum VeilEclipseTierPresentation {
+    static func shortName(_ fullTitle: String) -> String {
+        let first = fullTitle.split(separator: "·", maxSplits: 1).first
+            .map { String($0).trimmingCharacters(in: .whitespacesAndNewlines) } ?? ""
+        return first.isEmpty ? "未设置" : first
+    }
+
+    static func hasSearchBudgetMultiplier(_ fullTitle: String) -> Bool {
+        fullTitle.contains("×")
+    }
+
+    static let multiplierDisclosure = "档位倍率表示搜索时间预算，并非已验证的棋力或胜率倍数。"
+}
diff --git a/VeilLink/UI/VeilGomokuMatchArchive.swift b/VeilLink/UI/VeilGomokuMatchArchive.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/UI/VeilGomokuMatchArchive.swift
@@ -0,0 +1,233 @@
+import Foundation
+
+/// Separate, append-only *per-match* history. Does not replace the existing
+/// LocalBoardMatchStore latest-match recovery file or the training database.
+/// Each match has its own UUID-named JSON file; there is NO fixed game-count cap.
+final class VeilGomokuMatchArchive {
+    enum Status: String, Codable, Sendable {
+        case playing, humanWon, aiWon, draw, interrupted
+        var isFinal: Bool { self != .playing }
+        var title: String {
+            switch self {
+            case .playing: return "进行中"
+            case .humanWon: return "玩家获胜"
+            case .aiWon: return "ECLIPSE 获胜"
+            case .draw: return "平局"
+            case .interrupted: return "中断棋局"
+            }
+        }
+    }
+
+    struct Move: Codable, Hashable, Sendable {
+        let index: Int
+        /// 1 = black / host, 2 = white / guest.
+        let stone: UInt8
+        init(index: Int, stone: UInt8) { self.index = index; self.stone = stone }
+    }
+
+    struct Match: Codable, Sendable, Identifiable {
+        static let version = 1
+        let version: Int
+        let id: String
+        let startedAt: Date
+        let updatedAt: Date
+        let completedAt: Date?
+        let status: Status
+        let difficulty: String
+        let humanStone: UInt8
+        let moves: [Move]
+
+        var placedMoves: [VeilEclipseTracePolicy.PlacedMove] {
+            moves.map { .init(index: $0.index, stone: $0.stone) }
+        }
+        var isReplayable: Bool {
+            !VeilEclipseTracePolicy.replayFrames(
+                placedMoves,
+                matchFinished: true,
+                separateReadOnlyPanel: true
+            ).isEmpty
+        }
+    }
+
+    struct Page {
+        let matches: [Match]
+        let totalFiles: Int
+        let nextOffset: Int?
+        let invalidFiles: Int
+    }
+
+    enum ArchiveError: LocalizedError {
+        case invalidSession, invalidMoves, conflict, corrupted, invalidStatus
+        var errorDescription: String? {
+            switch self {
+            case .invalidSession: return "棋局编号无效，未保存。"
+            case .invalidMoves: return "棋谱走子校验未通过，未覆盖原记录。"
+            case .conflict: return "同一棋局的旧记录与新走子不一致，旧记录已保护。"
+            case .corrupted: return "历史棋谱可能损坏，已保留原文件。"
+            case .invalidStatus: return "棋局结果与棋盘不一致，未归档。"
+            }
+        }
+    }
+
+    let directory: URL
+    private let manager: FileManager
+
+    init(directory: URL? = nil, fileManager: FileManager = .default) {
+        self.manager = fileManager
+        if let directory { self.directory = directory }
+        else {
+            let support = fileManager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+                ?? fileManager.temporaryDirectory
+            self.directory = support
+                .appendingPathComponent("VeilLink", isDirectory: true)
+                .appendingPathComponent("GomokuMatchHistoryV1", isDirectory: true)
+        }
+    }
+
+    private func canonicalID(_ sessionID: String) throws -> String {
+        guard let uuid = UUID(uuidString: sessionID) else { throw ArchiveError.invalidSession }
+        return uuid.uuidString
+    }
+
+    private func url(for id: String) throws -> URL {
+        directory.appendingPathComponent(try canonicalID(id) + ".json", isDirectory: false)
+    }
+
+    func read(sessionID: String) throws -> Match? {
+        let path = try url(for: sessionID)
+        guard manager.fileExists(atPath: path.path) else { return nil }
+        // Bound untrusted/recovered archive bytes BEFORE decoding to prevent
+        // oversized or malformed JSON from exhausting memory during pagination.
+        let bytes = try path.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+        guard (1...128_000).contains(bytes) else { throw ArchiveError.corrupted }
+        let data = try Data(contentsOf: path)
+        guard let match = try? JSONDecoder().decode(Match.self, from: data),
+              match.id == (try? canonicalID(sessionID)), validate(match) else {
+            throw ArchiveError.corrupted
+        }
+        return match
+    }
+
+    /// Called after each *committed* player/AI move and when the actual result
+    /// is known. A final match cannot be edited, replaced, or silently reset.
+    @discardableResult
+    func save(
+        sessionID: String,
+        moves: [Move],
+        difficulty: String,
+        humanStone: UInt8,
+        status: Status,
+        now: Date = Date()
+    ) throws -> Match? {
+        guard !moves.isEmpty else { return nil } // no phantom empty games
+        let id = try canonicalID(sessionID)
+        let prior = try read(sessionID: id)
+        if let prior {
+            guard prior.humanStone == humanStone,
+                  prior.moves.count <= moves.count,
+                  Array(moves.prefix(prior.moves.count)) == prior.moves else {
+                throw ArchiveError.conflict
+            }
+            if prior.status.isFinal {
+                // Retry after crash is safe; any alteration of final history is not.
+                guard prior.status == status, prior.moves == moves else { throw ArchiveError.conflict }
+                return prior
+            }
+        }
+        // The device clock may move backwards; retain monotone archive dates.
+        let effectiveNow = max(now, prior?.updatedAt ?? now)
+        let match = Match(
+            version: Match.version, id: id,
+            startedAt: prior?.startedAt ?? now,
+            updatedAt: effectiveNow,
+            completedAt: status.isFinal ? effectiveNow : nil,
+            status: status,
+            difficulty: prior?.difficulty ?? difficulty,
+            humanStone: humanStone, moves: moves
+        )
+        guard validate(match) else { throw ArchiveError.invalidMoves }
+        try manager.createDirectory(at: directory, withIntermediateDirectories: true)
+        let data = try JSONEncoder().encode(match)
+        guard data.count <= 128_000 else { throw ArchiveError.invalidMoves }
+        var options: Data.WritingOptions = [.atomic]
+        #if canImport(UIKit)
+        options.insert(.completeFileProtectionUntilFirstUserAuthentication)
+        #endif
+        try data.write(to: try url(for: id), options: options)
+        return match
+    }
+
+    /// Paged listing reads only the requested slice, so old archives have no
+    /// fixed match-count or storage cap and browsing remains bounded.
+    func page(offset: Int = 0, limit: Int = 30) throws -> Page {
+        guard manager.fileExists(atPath: directory.path) else {
+            return Page(matches: [], totalFiles: 0, nextOffset: nil, invalidFiles: 0)
+        }
+        let files = try manager.contentsOfDirectory(
+            at: directory, includingPropertiesForKeys: [.contentModificationDateKey, .isRegularFileKey],
+            options: [.skipsHiddenFiles]
+        ).filter {
+            $0.pathExtension.lowercased() == "json"
+                && UUID(uuidString: $0.deletingPathExtension().lastPathComponent) != nil
+                && (try? $0.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true
+        }
+            .sorted {
+                let a = (try? $0.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate) ?? .distantPast
+                let b = (try? $1.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate) ?? .distantPast
+                return a == b ? $0.lastPathComponent > $1.lastPathComponent : a > b
+            }
+        let start = min(max(0, offset), files.count)
+        let end = min(files.count, start + min(100, max(1, limit)))
+        var entries: [Match] = []
+        var invalid = 0
+        for url in files[start..<end] {
+            do {
+                if let item = try read(sessionID: url.deletingPathExtension().lastPathComponent) {
+                    entries.append(item)
+                }
+            } catch { invalid += 1 } // Never delete or silently rewrite a corrupt record.
+        }
+        return Page(matches: entries, totalFiles: files.count,
+                    nextOffset: end < files.count ? end : nil, invalidFiles: invalid)
+    }
+
+    private func validate(_ match: Match) -> Bool {
+        guard match.version == Match.version,
+              UUID(uuidString: match.id)?.uuidString == match.id,
+              (1...2).contains(match.humanStone),
+              !match.moves.isEmpty, match.moves.count <= 225,
+              match.completedAt == nil || match.status.isFinal,
+              match.status.isFinal == (match.completedAt != nil),
+              match.updatedAt >= match.startedAt,
+              (match.completedAt == nil || match.completedAt == match.updatedAt)
+        else { return false }
+        let frames = VeilEclipseTracePolicy.replayFrames(match.placedMoves,
+            matchFinished: true, separateReadOnlyPanel: true)
+        guard frames.count == match.moves.count + 1,
+              let board = frames.last?.cells,
+              let last = match.moves.last else { return false }
+        let won = makesFive(board, index: last.index, stone: last.stone)
+        switch match.status {
+        case .humanWon: return won && last.stone == match.humanStone
+        case .aiWon: return won && last.stone != match.humanStone
+        case .draw: return !won && match.moves.count == 225
+        case .interrupted: return !won && match.moves.count < 225
+        case .playing: return true // last winning move may precede status finalization
+        }
+    }
+
+    private func makesFive(_ board: [UInt8], index: Int, stone: UInt8) -> Bool {
+        let row = index / 15, col = index % 15
+        for (dr, dc) in [(1,0), (0,1), (1,1), (1,-1)] {
+            var count = 1
+            for sign in [-1,1] {
+                var r = row + dr * sign, c = col + dc * sign
+                while (0..<15).contains(r), (0..<15).contains(c), board[r*15+c] == stone {
+                    count += 1; r += dr*sign; c += dc*sign
+                }
+            }
+            if count >= 5 { return true }
+        }
+        return false
+    }
+}
