@@ -0,0 +1,74 @@
+import Foundation
+
+/// ECLIPSE R12: bounded, exhaustive immediate-five classification for a
+/// freestyle 15x15 Gomoku PVS leaf. The trained 48-tree move ordering remains
+/// unchanged. Exact winning-completion detection is a *rule* check, not a new
+/// fitted model or a claim about general forced wins.
+///
+/// The caller must supply a valid, nonterminal board and authentic side to move.
+/// Intended as a gated replacement for `depth == 0 -> staticValue` only.
+enum EclipseHorizonQuiescenceR12 {
+    static let size = 15
+    static let capacity = 225
+    private static let axes = [(0, 1), (1, 0), (1, 1), (1, -1)]
+
+    /// The searcher may only treat `ownImmediateWin` and `opponentDoubleFive`
+    /// as proven short results. `forcedBlock` requires an additional quiet
+    /// evaluation after applying the unique legal block; no mate is assumed.
+    enum Probe: Equatable, Sendable {
+        case ownImmediateWin(Int)
+        case opponentDoubleFive([Int])
+        case forcedBlock(Int)
+        case quiet
+    }
+
+    /// Exhaustive over all 572 five-cell windows. Every exact completion
+    /// point is deduplicated so overlapping windows cannot fake two threats.
+    /// Passing invalid content yields nil; callers retain their old baseline.
+    static func inspect(_ cells: [UInt8], toMove: UInt8) -> Probe? {
+        guard cells.count == capacity, toMove == 1 || toMove == 2,
+              cells.allSatisfy({ $0 <= 2 }) else { return nil }
+        var own: Set<Int> = []
+        var enemy: Set<Int> = []
+        for (dr, dc) in axes {
+            for row in 0..<size {
+                for col in 0..<size {
+                    let rLast = row + dr * 4, cLast = col + dc * 4
+                    guard (0..<size).contains(rLast), (0..<size).contains(cLast) else { continue }
+                    var one = 0, two = 0, hole = -1
+                    for step in 0..<5 {
+                        let index = (row + dr * step) * size + col + dc * step
+                        switch cells[index] {
+                        case 1: one += 1
+                        case 2: two += 1
+                        default: hole = index
+                        }
+                    }
+                    if one == 4 && two == 0 && hole >= 0 {
+                        if toMove == 1 { own.insert(hole) } else { enemy.insert(hole) }
+                    }
+                    if two == 4 && one == 0 && hole >= 0 {
+                        if toMove == 2 { own.insert(hole) } else { enemy.insert(hole) }
+                    }
+                }
+            }
+        }
+        // The side to move wins *before* an opponent's existing threat.
+        if let win = own.min() { return .ownImmediateWin(win) }
+        let threats = enemy.sorted()
+        if threats.count >= 2 { return .opponentDoubleFive(threats) }
+        if let block = threats.first { return .forcedBlock(block) }
+        return .quiet
+    }
+
+    /// A purely tactical win/forced-loss score; no false certificate for quiet
+    /// or unique-block positions. Relative to side to move and search ply.
+    static func certifiedScore(_ probe: Probe, mate: Int, ply: Int) -> Int? {
+        guard mate > 100, ply >= 0 else { return nil }
+        switch probe {
+        case .ownImmediateWin: return mate - ply - 1
+        case .opponentDoubleFive: return -mate + ply + 2
+        case .forcedBlock, .quiet: return nil
+        }
+    }
+}
diff --git a/VeilLink/Agent/Games/EclipseIncrementalThreatIndexR13.swift b/VeilLink/Agent/Games/EclipseIncrementalThreatIndexR13.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Games/EclipseIncrementalThreatIndexR13.swift
@@ -0,0 +1,155 @@
+import Foundation
+
+/// Exact and incremental threat windows for unrestricted 15x15 Gomoku.
+/// Mutable instances must be owned by a single search; never share across turns.
+/// It is a search optimization, NOT a neural network or a new win certificate.
+struct EclipseIncrementalThreatIndexR13: Sendable {
+    static let size = 15
+    static let count = 225
+
+    private struct Window: Sendable {
+        let cells: [Int]
+    }
+
+    private static let windows: [Window] = {
+        var output: [Window] = []
+        for (dr, dc) in [(0, 1), (1, 0), (1, 1), (1, -1)] {
+            for r in 0..<size {
+                for c in 0..<size {
+                    guard (0..<size).contains(r + dr * 4),
+                          (0..<size).contains(c + dc * 4) else { continue }
+                    output.append(Window(cells: (0..<5).map { (r + dr * $0) * size + c + dc * $0 }))
+                }
+            }
+        }
+        return output
+    }()
+
+    private static let windowsBySquare: [[Int]] = {
+        var result = [[Int]](repeating: [], count: count)
+        for (id, window) in windows.enumerated() {
+            for index in window.cells { result[index].append(id) }
+        }
+        return result
+    }()
+
+    private(set) var cells: [UInt8]
+    private var black: [UInt8]
+    private var white: [UInt8]
+    private var blackCompletions: [Int16]
+    private var whiteCompletions: [Int16]
+
+    init?(cells: [UInt8]) {
+        guard cells.count == Self.count, cells.allSatisfy({ $0 <= 2 }) else { return nil }
+        self.cells = cells
+        self.black = [UInt8](repeating: 0, count: Self.windows.count)
+        self.white = [UInt8](repeating: 0, count: Self.windows.count)
+        self.blackCompletions = [Int16](repeating: 0, count: Self.count)
+        self.whiteCompletions = [Int16](repeating: 0, count: Self.count)
+        for (id, window) in Self.windows.enumerated() {
+            for at in window.cells {
+                if cells[at] == 1 { black[id] += 1 }
+                if cells[at] == 2 { white[id] += 1 }
+            }
+            adjustContribution(id, sign: 1)
+        }
+    }
+
+    /// A move or exact undo is O(number of 5-cell windows crossing one square).
+    /// No memory allocation and no full-board scan occurs in the hot path.
+    @discardableResult
+    mutating func place(_ index: Int, stone: UInt8) -> Bool {
+        guard (0..<Self.count).contains(index),
+              (stone == 1 || stone == 2), cells[index] == 0 else { return false }
+        set(index: index, from: 0, to: stone)
+        return true
+    }
+
+    @discardableResult
+    mutating func undo(_ index: Int, stone: UInt8) -> Bool {
+        guard (0..<Self.count).contains(index),
+              (stone == 1 || stone == 2), cells[index] == stone else { return false }
+        set(index: index, from: stone, to: 0)
+        return true
+    }
+
+    func winsImmediately(stone: UInt8, at index: Int) -> Bool {
+        guard (0..<Self.count).contains(index), cells[index] == 0 else { return false }
+        switch stone {
+        case 1: return blackCompletions[index] > 0
+        case 2: return whiteCompletions[index] > 0
+        default: return false
+        }
+    }
+
+    func winningSquares(stone: UInt8) -> [Int] {
+        let counts: [Int16]
+        if stone == 1 { counts = blackCompletions }
+        else if stone == 2 { counts = whiteCompletions }
+        else { return [] }
+        return (0..<Self.count).filter { cells[$0] == 0 && counts[$0] > 0 }
+    }
+
+    /// Enumerates every next-move fork cell with TWO DISTINCT immediate-five
+    /// completions; duplicate geometric windows are not double-counted.
+    /// Uses cached window stone counts and only inspects two-hole windows.
+    func forkSquares(stone: UInt8) -> [Int] {
+        guard stone == 1 || stone == 2 else { return [] }
+        var endings: [Int: Set<Int>] = [:]
+        for (id, window) in Self.windows.enumerated() {
+            let own = stone == 1 ? black[id] : white[id]
+            let enemy = stone == 1 ? white[id] : black[id]
+            guard own == 3, enemy == 0 else { continue }
+            var first = -1, second = -1
+            for index in window.cells where cells[index] == 0 {
+                if first == -1 { first = index } else { second = index; break }
+            }
+            guard first >= 0, second >= 0 else { continue }
+            endings[first, default: []].insert(second)
+            endings[second, default: []].insert(first)
+        }
+        // Existing immediate-five completions remain available after a move
+        // except when the move occupies that exact completion square. A fork
+        // may combine one preexisting completion and one newly created one.
+        // This case is missed by a 3-stones/2-holes-only detector.
+        let preexisting = winningSquares(stone: stone)
+        // The common case has no existing immediate five. Avoid iterating all
+        // 225 candidate squares or materializing redundant Sets in that case.
+        if preexisting.isEmpty {
+            return endings.filter { $0.value.count >= 2 }.map(\.key).sorted()
+        }
+        var forkMoves: [Int] = []
+        for move in 0..<Self.count where cells[move] == 0 {
+            var finishes = endings[move] ?? []
+            for index in preexisting where index != move { finishes.insert(index) }
+            if finishes.count >= 2 { forkMoves.append(move) }
+        }
+        return forkMoves
+    }
+
+    private mutating func set(index: Int, from: UInt8, to: UInt8) {
+        for w in Self.windowsBySquare[index] {
+            adjustContribution(w, sign: -1)
+            if from == 1 { black[w] -= 1 }
+            if from == 2 { white[w] -= 1 }
+        }
+        cells[index] = to
+        for w in Self.windowsBySquare[index] {
+            if to == 1 { black[w] += 1 }
+            if to == 2 { white[w] += 1 }
+            adjustContribution(w, sign: 1)
+        }
+    }
+
+    private mutating func adjustContribution(_ id: Int, sign: Int16) {
+        let side: UInt8
+        if black[id] == 4 && white[id] == 0 { side = 1 }
+        else if white[id] == 4 && black[id] == 0 { side = 2 }
+        else { return }
+        for index in Self.windows[id].cells where cells[index] == 0 {
+            if side == 1 { blackCompletions[index] += sign }
+            else { whiteCompletions[index] += sign }
+            break
+        }
+    }
+}
diff --git a/VeilLinkTests/EclipseIncrementalThreatIndexR13Tests.swift b/VeilLinkTests/EclipseIncrementalThreatIndexR13Tests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/EclipseIncrementalThreatIndexR13Tests.swift
@@ -0,0 +1,37 @@
+import XCTest
+@testable import VeilLink
+
+final class EclipseIncrementalThreatIndexR13Tests: XCTestCase {
+    func testImmediateFivesAndUndo() throws {
+        var board = [UInt8](repeating: 0, count: 225)
+        for i in [108, 109, 110, 111] { board[i] = 1 }
+        var index = try XCTUnwrap(EclipseIncrementalThreatIndexR13(cells: board))
+        XCTAssertEqual(index.winningSquares(stone: 1), [107, 112])
+        XCTAssertTrue(index.place(107, stone: 1))
+        XCTAssertFalse(index.winsImmediately(stone: 1, at: 107))
+        XCTAssertTrue(index.undo(107, stone: 1))
+        XCTAssertEqual(index.winningSquares(stone: 1), [107, 112])
+    }
+
+    func testForkDeduplicatesCompletionEndpoints() throws {
+        var board = [UInt8](repeating: 0, count: 225)
+        for i in [109, 110, 111] { board[i] = 1 }
+        let index = try XCTUnwrap(EclipseIncrementalThreatIndexR13(cells: board))
+        XCTAssertTrue(index.forkSquares(stone: 1).contains(108))
+        XCTAssertTrue(index.forkSquares(stone: 1).contains(112))
+    }
+
+    func testIllegalMoveCannotCorruptIndex() throws {
+        let empty = [UInt8](repeating: 0, count: 225)
+        var index = try XCTUnwrap(EclipseIncrementalThreatIndexR13(cells: empty))
+        XCTAssertTrue(index.place(100, stone: 1))
+        XCTAssertFalse(index.place(100, stone: 2))
+        XCTAssertFalse(index.undo(100, stone: 2))
+        XCTAssertTrue(index.undo(100, stone: 1))
+        XCTAssertEqual(index.cells, empty)
+    }
+
+    func testFrozenCodexDefaultIsOffUntilGovernorEnables() {
+        XCTAssertFalse(VeilGomokuUnifiedSearch.Limits().r13IncrementalThreatIndexEnabled)
+    }
+}
