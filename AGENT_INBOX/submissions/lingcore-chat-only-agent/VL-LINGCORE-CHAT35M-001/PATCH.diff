@@ -0,0 +1,69 @@
+import XCTest
+@testable import VeilLink
+
+@MainActor
+final class LingCoreChatOnlyBoundaryTests: XCTestCase {
+    private final class RuntimeSpy: LocalTextModelRuntime {
+        var state: AgentRuntimeState = .unloaded
+        let manifest: LocalTextModelManifest? = nil
+        var lastRequest: AgentTextRequest?
+        var generateCount = 0
+
+        func prepare() async throws { state = .ready }
+
+        func generate(
+            request: AgentTextRequest,
+            onToken: @escaping @MainActor @Sendable (String) -> Void
+        ) async throws -> AgentTextResult {
+            lastRequest = request
+            generateCount += 1
+            onToken("hello")
+            return AgentTextResult(
+                text: "hello",
+                emittedChunkCount: 1,
+                estimatedTokenCount: 1
+            )
+        }
+
+        func cancel() { state = .ready }
+        func trimMemory() {}
+        func unload() { state = .unloaded }
+    }
+
+    func testRequestNeverReceivesPrivilegedContext() async throws {
+        let spy = RuntimeSpy()
+        let boundary = LingCoreChatOnlyBoundary(runtime: spy)
+
+        let reply = try await boundary.reply(to: "/game move") { _ in }
+
+        XCTAssertEqual(reply, "hello")
+        XCTAssertEqual(spy.generateCount, 1)
+        XCTAssertEqual(spy.lastRequest?.userText, "/game move")
+        XCTAssertNil(spy.lastRequest?.visualContext)
+        XCTAssertNil(spy.lastRequest?.localContext)
+        XCTAssertEqual(spy.lastRequest?.maxNewTokens, 96)
+        XCTAssertEqual(boundary.messageCount, 2)
+        // The literal text "/game move" is only a prompt here: there is no
+        // AgentToolRouter or host action-layer dependency in the boundary.
+    }
+
+    func testLongPromptRejectedBeforeInference() async {
+        let spy = RuntimeSpy()
+        let boundary = LingCoreChatOnlyBoundary(runtime: spy)
+
+        do {
+            _ = try await boundary.reply(to: String(repeating: "x", count: 513)) { _ in }
+            XCTFail("Expected input rejection")
+        } catch {
+            XCTAssertEqual(spy.generateCount, 0)
+        }
+    }
+
+    func testClearRemovesConversationMemory() async throws {
+        let spy = RuntimeSpy()
+        let boundary = LingCoreChatOnlyBoundary(runtime: spy)
+        _ = try await boundary.reply(to: "hello") { _ in }
+        boundary.clear()
+        XCTAssertEqual(boundary.messageCount, 0)
+    }
+}
diff --git a/VeilLink/Agent/Language/Vertex35MModelIntegrityGate.swift b/VeilLink/Agent/Language/Vertex35MModelIntegrityGate.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Language/Vertex35MModelIntegrityGate.swift
@@ -0,0 +1,48 @@
+import Foundation
+import CryptoKit
+
+/// Fail-closed integrity check for a user-imported GGUF file.
+/// Pin is derived from the exact 29,203,168-byte copy downloaded from the
+/// owner's Google Drive. Publisher-side digest comparison is still pending.
+enum Vertex35MModelIntegrityGate {
+    static let expectedBytes: Int64 = 29_203_168
+    static let expectedSHA256 = "c55c3c32740d5a283c505fc9f9b7313e4b3f0c98bb11efd21b651651d5cb36b5"
+
+    enum Failure: Error, Equatable {
+        case notARegularFile
+        case wrongSize
+        case badGGUFHeader
+        case checksumMismatch
+    }
+
+    static func isGGUFv3Header(_ prefix: Data) -> Bool {
+        guard prefix.count >= 8 else { return false }
+        return Array(prefix.prefix(8)) == [0x47, 0x47, 0x55, 0x46, 0x03, 0x00, 0x00, 0x00]
+    }
+
+    /// Validate on a worker thread on EVERY attach/load.
+    /// Do not trust URL-only caches: the file can be replaced at the same path.
+    static func validate(url: URL) async throws {
+        try await Task.detached(priority: .utility) {
+            let values = try url.resourceValues(forKeys: [.fileSizeKey, .isRegularFileKey])
+            guard values.isRegularFile == true else { throw Failure.notARegularFile }
+            guard Int64(values.fileSize ?? -1) == expectedBytes else { throw Failure.wrongSize }
+
+            let handle = try FileHandle(forReadingFrom: url)
+            defer { try? handle.close() }
+            let header = try handle.read(upToCount: 8) ?? Data()
+            guard isGGUFv3Header(header) else { throw Failure.badGGUFHeader }
+            try handle.seek(toOffset: 0)
+
+            var hasher = SHA256()
+            while true {
+                try Task.checkCancellation()
+                let bytes = try handle.read(upToCount: 1_048_576) ?? Data()
+                if bytes.isEmpty { break }
+                hasher.update(data: bytes)
+            }
+            let actual = hasher.finalize().map { String(format: "%02x", $0) }.joined()
+            guard actual == expectedSHA256 else { throw Failure.checksumMismatch }
+        }.value
+    }
+}
diff --git a/VeilLink/Agent/Language/Vertex35MChatRuntime.swift b/VeilLink/Agent/Language/Vertex35MChatRuntime.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Language/Vertex35MChatRuntime.swift
@@ -0,0 +1,135 @@
+import Foundation
+
+#if canImport(llama)
+/// Explicitly opt-in; never install this runtime through the default
+/// AgentCoordinator factory or reuse its toolExecutor.
+@MainActor
+final class Vertex35MChatRuntime: LocalTextModelRuntime {
+    private(set) var state: AgentRuntimeState = .unloaded
+    let manifest: LocalTextModelManifest? = LocalTextModelManifest(
+        id: "vertexresearch.vertex-0.6-35m-instruct-q4_k_m",
+        displayName: "Vertex 35M — experimental offline chat",
+        upstream: "VertexResearch/Vertex-0.6-35M-Instruct-GGUF",
+        license: "Apache-2.0",
+        quantization: "Q4_K_M",
+        sha256: Vertex35MModelIntegrityGate.expectedSHA256,
+        byteCount: Int(Vertex35MModelIntegrityGate.expectedBytes),
+        contextLimit: 1_024,
+        recommendedProfile: "experimental text-only",
+        minimumOS: "15.0"
+    )
+
+    private let modelURL: URL
+    private let gate = LlamaCancellationGate()
+    private var engine: LlamaInferenceEngine?
+    private var generationEpoch: UInt64 = 0
+
+    init(importedModelURL: URL) {
+        modelURL = importedModelURL
+    }
+
+    func prepare() async throws {
+        guard state == .unloaded || state == .unavailable else { return }
+        state = .loading
+        do {
+            try await Vertex35MModelIntegrityGate.validate(url: modelURL)
+            // CPU-first, conservative settings until device benchmarks exist.
+            let config = LlamaRuntimeConfiguration(
+                contextTokens: 1_024,
+                batchTokens: 64,
+                threads: 2,
+                gpuLayers: 0,
+                temperature: 0.55,
+                topK: 20,
+                topP: 0.85,
+                minP: 0.05
+            )
+            let next = LlamaInferenceEngine(configuration: config, cancellationGate: gate)
+            try await next.load(modelURL: modelURL)
+            engine = next
+            state = .ready
+        } catch {
+            state = .unavailable
+            throw error
+        }
+    }
+
+    func generate(
+        request: AgentTextRequest,
+        onToken: @escaping @MainActor @Sendable (String) -> Void
+    ) async throws -> AgentTextResult {
+        // Fail closed if any privileged context is accidentally forwarded.
+        guard request.localContext == nil, request.visualContext == nil else {
+            throw AgentRuntimeError.invalidRequest
+        }
+        if state == .unloaded || state == .unavailable { try await prepare() }
+        guard state == .ready, let engine else {
+            throw AgentRuntimeError.unavailable("Vertex 35M runtime unavailable.")
+        }
+        state = .generating
+        generationEpoch &+= 1
+        let epoch = generationEpoch
+        defer { if state == .generating { state = .ready } }
+
+        var chat = [
+            QwenChatMessage(
+                role: "system",
+                content: "You are a tiny local text-only chat model. Respond briefly. You have no tools, app controls, external data or decision authority."
+            )
+        ]
+        for message in request.messages.suffix(6) {
+            chat.append(QwenChatMessage(
+                role: message.role == .user ? "user" : "assistant",
+                content: Self.sanitize(message.text)
+            ))
+        }
+        if chat.last?.role != "user" {
+            chat.append(QwenChatMessage(role: "user", content: Self.sanitize(request.userText)))
+        }
+        // Fallback must also use a non-privileged prompt; GGUF ChatML is preferred.
+        let fallback = chat.map { m in
+            "<|im_start|>\(m.role)\n\(m.content)<|im_end|>\n"
+        }.joined() + "<|im_start|>assistant\n"
+        let stats = try await engine.generate(
+            prompt: fallback,
+            chatMessages: chat,
+            maxNewTokens: min(96, max(1, request.maxNewTokens))
+        ) { [weak self] text in
+            guard let self, self.generationEpoch == epoch else { return }
+            onToken(text)
+        }
+        guard epoch == generationEpoch else { throw AgentRuntimeError.cancelled }
+        state = .ready
+        return AgentTextResult(
+            text: stats.text,
+            emittedChunkCount: stats.emittedChunkCount,
+            estimatedTokenCount: stats.generatedTokenCount
+        )
+    }
+
+    func cancel() {
+        generationEpoch &+= 1
+        gate.cancel()
+        if state == .generating { state = .ready }
+    }
+
+    func trimMemory() {
+        guard let engine else { return }
+        Task { await engine.trim() }
+    }
+
+    func unload() {
+        cancel()
+        let previous = engine
+        engine = nil
+        state = .unloaded
+        Task { await previous?.shutdown() }
+    }
+
+    private static func sanitize(_ text: String) -> String {
+        text.replacingOccurrences(of: "<|im_start|>", with: "[literal-im-start]")
+            .replacingOccurrences(of: "<|im_end|>", with: "[literal-im-end]")
+            .replacingOccurrences(of: "\u{0000}", with: "")
+    }
+}
+#endif
diff --git a/VeilLinkTests/Vertex35MModelIntegrityGateTests.swift b/VeilLinkTests/Vertex35MModelIntegrityGateTests.swift
