diff --git a/VeilLink/Core/VeilControlEvent.swift b/VeilLink/Core/VeilControlEvent.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Core/VeilControlEvent.swift
@@ -0,0 +1,50 @@
+import Foundation
+
+/// A typed extension transported only inside an authenticated Wire v4 session.
+struct VeilControlEvent: Codable, Equatable {
+    let schemaVersion: Int
+    let eventID: String
+    let topic: String
+    let payload: Data
+    let createdAt: TimeInterval
+
+    init(eventID: String = UUID().uuidString, topic: String, payload: Data, createdAt: TimeInterval = Date().timeIntervalSince1970) {
+        schemaVersion = 1
+        self.eventID = eventID
+        self.topic = topic
+        self.payload = payload
+        self.createdAt = createdAt
+    }
+}
+
+enum VeilControlEventCodec {
+    enum Error: Swift.Error { case invalidEvent }
+    static let maxPayloadBytes = 24_576
+    static let maxEncodedBytes = 49_152
+
+    static func encode(_ event: VeilControlEvent) throws -> Data {
+        try validate(event)
+        let data = try JSONEncoder().encode(event)
+        guard data.count <= maxEncodedBytes else { throw Error.invalidEvent }
+        return data
+    }
+
+    static func decode(_ bytes: Data) throws -> VeilControlEvent {
+        guard !bytes.isEmpty, bytes.count <= maxEncodedBytes else { throw Error.invalidEvent }
+        let value = try JSONDecoder().decode(VeilControlEvent.self, from: bytes)
+        try validate(value)
+        return value
+    }
+
+    private static func validate(_ event: VeilControlEvent) throws {
+        guard event.schemaVersion == 1, let uuid = UUID(uuidString: event.eventID),
+              uuid.uuidString == event.eventID,
+              event.createdAt.isFinite, event.createdAt > 0,
+              event.payload.count <= maxPayloadBytes else { throw Error.invalidEvent }
+        let name = Array(event.topic.utf8)
+        guard !name.isEmpty, name.count <= 64,
+              name.allSatisfy({ ($0 >= 97 && $0 <= 122) || ($0 >= 48 && $0 <= 57) || $0 == 46 || $0 == 45 || $0 == 95 }) else {
+            throw Error.invalidEvent
+        }
+    }
+}
diff --git a/VeilLinkTests/VeilControlEventCodecTests.swift b/VeilLinkTests/VeilControlEventCodecTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/VeilControlEventCodecTests.swift
@@ -0,0 +1,26 @@
+import Foundation
+import XCTest
+@testable import VeilLink
+
+final class VeilControlEventCodecTests: XCTestCase {
+    func testEnvelopeAndEventRoundTrip() throws {
+        let event = VeilControlEvent(topic: "sync.cursor", payload: Data([1, 2, 3]))
+        let raw = try VeilControlEventCodec.encode(event)
+        let packet = try WireCodec.encodeEnvelope(version: 4, kind: .controlEvent, payload: raw)
+        let decoded = try WireCodec.decodeEnvelope(packet)
+        XCTAssertEqual(decoded.version, 4)
+        XCTAssertEqual(decoded.kind, .controlEvent)
+        XCTAssertEqual(try VeilControlEventCodec.decode(decoded.payload), event)
+    }
+    func testRejectOversizedAndUnknownEvent() throws {
+        let tooLarge = VeilControlEvent(topic: "sync.cursor", payload: Data(repeating: 0x45, count: 24_577))
+        XCTAssertThrowsError(try VeilControlEventCodec.encode(tooLarge))
+        let valid = try VeilControlEventCodec.encode(VeilControlEvent(topic: "game.move", payload: Data()))
+        var json = try XCTUnwrap(JSONSerialization.jsonObject(with: valid) as? [String: Any])
+        json["schemaVersion"] = 2
+        XCTAssertThrowsError(try VeilControlEventCodec.decode(try JSONSerialization.data(withJSONObject: json)))
+        json["schemaVersion"] = 1
+        json["topic"] = "Unsafe/Topic"
+        XCTAssertThrowsError(try VeilControlEventCodec.decode(try JSONSerialization.data(withJSONObject: json)))
+    }
+}
