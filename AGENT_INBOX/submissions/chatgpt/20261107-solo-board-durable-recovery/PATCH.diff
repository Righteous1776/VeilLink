diff --git a/VeilLink/Agent/Games/LocalBoardMatchStore.swift b/VeilLink/Agent/Games/LocalBoardMatchStore.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Games/LocalBoardMatchStore.swift
@@ -0,0 +1,113 @@
+import Foundation
+
+struct LocalBoardMatchMove: Codable, Equatable {
+    let actor: MiniGamePlayer
+    let move: MiniGameMove
+}
+
+struct LocalBoardMatchRecord: Codable {
+    static let version = 1
+    let version: Int
+    let game: MiniGameKind
+    let sessionID: String
+    let difficulty: String
+    let moves: [LocalBoardMatchMove]
+}
+
+struct LocalBoardMatchReplay {
+    let gomoku: GomokuState
+    let xiangqi: XiangqiState
+    let plies: [AdaptiveBoardPly]
+
+    static func validate(_ archive: LocalBoardMatchRecord) -> LocalBoardMatchReplay? {
+        guard archive.version == LocalBoardMatchRecord.version,
+              archive.game == .gomoku || archive.game == .xiangqi,
+              !archive.sessionID.isEmpty, archive.sessionID.count <= 128,
+              !archive.moves.isEmpty,
+              archive.moves.count <= (archive.game == .gomoku ? 225 : 5_000)
+        else { return nil }
+
+        var gomoku = GomokuState()
+        var xiangqi = XiangqiState()
+        var plies: [AdaptiveBoardPly] = []
+        plies.reserveCapacity(archive.moves.count)
+        for event in archive.moves {
+            guard event.move.piece == nil else { return nil }
+            switch archive.game {
+            case .gomoku:
+                guard event.move.from == nil, let to = event.move.to else { return nil }
+                let position = AdaptiveBoardPosition.gomoku(gomoku)
+                guard gomoku.apply(index: to, actor: event.actor) else { return nil }
+                plies.append(.init(position: position, action: String(to), actor: event.actor))
+            case .xiangqi:
+                guard let from = event.move.from, let to = event.move.to else { return nil }
+                let position = AdaptiveBoardPosition.xiangqi(xiangqi)
+                guard xiangqi.apply(from: from, to: to, actor: event.actor) else { return nil }
+                plies.append(.init(position: position, action: "\(from):\(to)", actor: event.actor))
+            default: return nil
+            }
+        }
+        return .init(gomoku: gomoku, xiangqi: xiangqi, plies: plies)
+    }
+}
+
+enum LocalBoardMatchStoreError: LocalizedError {
+    case invalidArchive
+    var errorDescription: String? { "棋局存档校验失败，旧文件已保留。" }
+}
+
+/// An independent, per-board-game move journal. Not a training archive.
+final class LocalBoardMatchStore {
+    let game: MiniGameKind
+    let fileURL: URL
+
+    init(game: MiniGameKind, directory: URL? = nil) {
+        self.game = game
+        let support = FileManager.default.urls(
+            for: .applicationSupportDirectory, in: .userDomainMask
+        ).first ?? FileManager.default.temporaryDirectory
+        let root = directory ?? support
+            .appendingPathComponent("VeilLink", isDirectory: true)
+            .appendingPathComponent("LocalMatchesV1", isDirectory: true)
+        fileURL = root.appendingPathComponent("\(game.rawValue).json")
+    }
+
+    func load() throws -> LocalBoardMatchRecord? {
+        guard FileManager.default.fileExists(atPath: fileURL.path) else { return nil }
+        let size = try fileURL.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+        guard size > 0, size <= 1_000_000 else { throw LocalBoardMatchStoreError.invalidArchive }
+        let bytes = try Data(contentsOf: fileURL)
+        guard let saved = try? JSONDecoder().decode(LocalBoardMatchRecord.self, from: bytes),
+              saved.game == game, LocalBoardMatchReplay.validate(saved) != nil else {
+            throw LocalBoardMatchStoreError.invalidArchive
+        }
+        return saved
+    }
+
+    func save(_ record: LocalBoardMatchRecord) throws {
+        guard record.game == game, LocalBoardMatchReplay.validate(record) != nil else {
+            throw LocalBoardMatchStoreError.invalidArchive
+        }
+        let bytes = try JSONEncoder().encode(record)
+        guard bytes.count <= 1_000_000 else { throw LocalBoardMatchStoreError.invalidArchive }
+        try FileManager.default.createDirectory(
+            at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true
+        )
+        try bytes.write(to: fileURL, options: [
+            .atomic, .completeFileProtectionUntilFirstUserAuthentication
+        ])
+    }
+
+    /// Never delete corrupt evidence without first copying it aside.
+    func discardOnExplicitRestart() throws {
+        guard FileManager.default.fileExists(atPath: fileURL.path) else { return }
+        do { _ = try load() }
+        catch {
+            let backup = fileURL.deletingLastPathComponent().appendingPathComponent(
+                "\(game.rawValue)-recovery-\(UUID().uuidString).json"
+            )
+            try FileManager.default.copyItem(at: fileURL, to: backup)
+        }
+        try FileManager.default.removeItem(at: fileURL)
+    }
+}
diff --git a/VeilLinkTests/LocalBoardMatchStoreTests.swift b/VeilLinkTests/LocalBoardMatchStoreTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/LocalBoardMatchStoreTests.swift
@@ -0,0 +1,92 @@
+import Foundation
+import XCTest
+@testable import VeilLink
+
+@MainActor
+final class LocalBoardMatchStoreTests: XCTestCase {
+    private func store(_ game: MiniGameKind) throws -> (LocalBoardMatchStore, URL) {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(
+            "board-test-\(UUID().uuidString)", isDirectory: true
+        )
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return (LocalBoardMatchStore(game: game, directory: directory), directory)
+    }
+
+    func testGomokuSurvivesControllerRecreationWhileComputerTurnPending() throws {
+        let (disk, folder) = try store(.gomoku)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let game = LocalAIGameController(game: .gomoku, matchStore: disk)
+        let originalID = game.sessionID
+        game.humanGomokuMove(112)
+        game.cancelAI()
+        let recovered = LocalAIGameController(game: .gomoku, matchStore: disk)
+        XCTAssertEqual(recovered.sessionID, originalID)
+        XCTAssertTrue(recovered.didRestoreBoardMatch)
+        XCTAssertEqual(recovered.gomoku.value(at: 112), 1)
+        XCTAssertEqual(recovered.gomoku.currentPlayer, .guest)
+        XCTAssertEqual(recovered.gomoku.moveCount, 1)
+        XCTAssertFalse(recovered.isAIThinking)
+    }
+
+    func testXiangqiRestoresPawnAndTurn() throws {
+        let (disk, folder) = try store(.xiangqi)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let game = LocalAIGameController(game: .xiangqi, matchStore: disk)
+        game.humanXiangqiMove(from: 54, to: 45)
+        game.cancelAI()
+        let recovered = LocalAIGameController(game: .xiangqi, matchStore: disk)
+        XCTAssertEqual(recovered.xiangqi.moveCount, 1)
+        XCTAssertEqual(recovered.xiangqi.currentPlayer, .guest)
+        XCTAssertEqual(recovered.xiangqi.piece(at: 45)?.side, .red)
+    }
+
+    func testCorruptFileIsNotOverwrittenUntilExplicitRestart() throws {
+        let (disk, folder) = try store(.gomoku)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let invalid = Data("{broken".utf8)
+        try invalid.write(to: disk.fileURL)
+        let game = LocalAIGameController(game: .gomoku, matchStore: disk)
+        XCTAssertNotNil(game.boardMatchSaveWarning)
+        game.humanGomokuMove(112)
+        game.cancelAI()
+        XCTAssertEqual(try Data(contentsOf: disk.fileURL), invalid)
+        game.restart()
+        XCTAssertNil(game.boardMatchSaveWarning)
+        XCTAssertNil(try disk.load())
+        let retained = try FileManager.default.contentsOfDirectory(
+            at: folder, includingPropertiesForKeys: nil
+        ).filter { $0.lastPathComponent.contains("-recovery-") }
+        XCTAssertEqual(retained.count, 1)
+    }
+
+    func testRejectsDuplicateOrOutOfTurnMoves() throws {
+        let (disk, folder) = try store(.gomoku)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let bad = LocalBoardMatchRecord(
+            version: 1, game: .gomoku, sessionID: UUID().uuidString,
+            difficulty: "balanced",
+            moves: [
+                .init(actor: .host, move: .gomoku(index: 112)),
+                .init(actor: .guest, move: .gomoku(index: 112))
+            ]
+        )
+        XCTAssertNil(LocalBoardMatchReplay.validate(bad))
+        XCTAssertThrowsError(try disk.save(bad))
+    }
+
+    func testRestartDoesNotClearOtherGame() throws {
+        let (_, sharedFolder) = try store(.gomoku)
+        defer { try? FileManager.default.removeItem(at: sharedFolder) }
+        let gomokuDisk = LocalBoardMatchStore(game: .gomoku, directory: sharedFolder)
+        let xiangqiDisk = LocalBoardMatchStore(game: .xiangqi, directory: sharedFolder)
+        let gomoku = LocalAIGameController(game: .gomoku, matchStore: gomokuDisk)
+        let xiangqi = LocalAIGameController(game: .xiangqi, matchStore: xiangqiDisk)
+        gomoku.humanGomokuMove(112); gomoku.cancelAI()
+        xiangqi.humanXiangqiMove(from: 54, to: 45); xiangqi.cancelAI()
+        let id = gomoku.sessionID
+        gomoku.restart()
+        XCTAssertNotEqual(gomoku.sessionID, id)
+        XCTAssertNil(try gomokuDisk.load())
+        XCTAssertEqual(try xiangqiDisk.load()?.moves.count, 1)
+    }
+}
