+    func testSuggestedMoveExecutionIsOffByDefault() {
+        let (defaults, suite) = isolatedDefaults()
+        defer { defaults.removePersistentDomain(forName: suite) }
+
+        let settings = AgentControlCenterSettings(defaults: defaults)
+
+        XCTAssertFalse(settings.allowSuggestedGameMoveExecution)
+        XCTAssertEqual(settings.gameDecisionMode, .baselineOnly)
+    }
+
+    func testSuggestedMoveExplicitOptInPersistsAndResetRevokesIt() {
+        let (defaults, suite) = isolatedDefaults()
+        defer { defaults.removePersistentDomain(forName: suite) }
+
+        let settings = AgentControlCenterSettings(defaults: defaults)
+        XCTAssertFalse(settings.allowSuggestedGameMoveExecution)
+        settings.allowSuggestedGameMoveExecution = true
+
+        let reopened = AgentControlCenterSettings(defaults: defaults)
+        XCTAssertTrue(reopened.allowSuggestedGameMoveExecution)
+        reopened.resetToSafeDefaults()
+        XCTAssertFalse(reopened.allowSuggestedGameMoveExecution)
+
+        let afterReset = AgentControlCenterSettings(defaults: defaults)
+        XCTAssertFalse(afterReset.allowSuggestedGameMoveExecution)
+    }
 
