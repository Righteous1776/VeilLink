+        defer { VeilImportedFileAccess.removeStagedCopy(staged) }
+        XCTAssertEqual(try VeilImportedFileAccess.chatDraftText(from: staged), expected)
+        XCTAssertEqual(try Data(contentsOf: source), Data(expected.utf8))
