diff --git a/VeilLinkTests/MediaTransferPolicyTests.swift b/VeilLinkTests/MediaTransferPolicyTests.swift
--- a/VeilLinkTests/MediaTransferPolicyTests.swift
+++ b/VeilLinkTests/MediaTransferPolicyTests.swift
@@ -2,6 +2,35 @@
 @testable import VeilLink
 
 final class MediaTransferPolicyTests: XCTestCase {
+    func testBLEBudgetIsMuchSmallerThanWireCeiling() {
+        XCTAssertEqual(MediaTransferPolicy.bluetoothTargetImageBytes, 200_000)
+        XCTAssertEqual(MediaTransferPolicy.bluetoothMaximumImageBytes, 384_000)
+        XCTAssertEqual(MediaTransferPolicy.maximumImageBytes(for: .bluetooth), 384_000)
+        XCTAssertEqual(MediaTransferPolicy.maximumImageDimension(for: .bluetooth), 1_600)
+        XCTAssertEqual(MediaTransferPolicy.maximumImageBytes(for: .fastLAN), 3_000_000)
+        XCTAssertEqual(MediaTransferPolicy.targetImageBytes(for: .fastLAN), 1_800_000)
+        XCTAssertLessThan(
+            MediaTransferPolicy.maximumImageBytes(for: .bluetooth),
+            WireProtocol.maximumImageBytes
+        )
+    }
+
+    func testCompressionQualityFeedbackNeverGrowsPayloadForOverBudgetImage() {
+        let minimum = MediaTransferPolicy.qualityRange(for: .bluetooth).minimum
+        XCTAssertNil(MediaTransferPolicy.nextCompressionQuality(
+            current: 0.88, encodedBytes: 300_000, maximumBytes: 384_000, floor: minimum
+        ))
+        let next = MediaTransferPolicy.nextCompressionQuality(
+            current: 0.88, encodedBytes: 900_000, maximumBytes: 384_000, floor: minimum
+        )
+        XCTAssertNotNil(next)
+        XCTAssertLessThan(next ?? 1, 0.88)
+        XCTAssertGreaterThanOrEqual(next ?? 0, minimum)
+        XCTAssertNil(MediaTransferPolicy.nextCompressionQuality(
+            current: minimum, encodedBytes: 900_000, maximumBytes: 384_000, floor: minimum
+        ))
+    }
+
     func testTransferLayerAcceptsSafeOutputFormats() {
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/jpeg"))
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/heic"))
