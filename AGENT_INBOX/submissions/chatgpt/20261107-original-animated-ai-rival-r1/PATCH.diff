diff --git a/VeilLink/UI/VeilOpponentAvatarView.swift b/VeilLink/UI/VeilOpponentAvatarView.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/UI/VeilOpponentAvatarView.swift
@@ -0,0 +1,110 @@
+import Foundation
+import SwiftUI
+
+// Original, native VeilLink mascot. No third-party character vectors or code.
+enum VeilOpponentAvatarMood: Equatable {
+    case idle, thinking, won, lost, draw
+
+    var label: String {
+        switch self {
+        case .idle: return "等待落子"
+        case .thinking: return "正在思考"
+        case .won: return "电脑获胜"
+        case .lost: return "电脑落败"
+        case .draw: return "和局"
+        }
+    }
+}
+
+enum VeilOpponentAvatarPolicy {
+    static let preferenceKey = "owner.grokbot.original.enabled.v1"
+
+    static func shouldRender(enabled: Bool, hasComputerOpponent: Bool) -> Bool {
+        enabled && hasComputerOpponent
+    }
+
+    static func frameInterval(lowPower: Bool) -> TimeInterval {
+        lowPower ? 1.0 / 15.0 : 1.0 / 30.0
+    }
+}
+
+/// Decorative animation. Never catches gestures, and suspends when not active.
+struct VeilOpponentAvatarView: View {
+    let mood: VeilOpponentAvatarMood
+    let size: CGFloat
+
+    @Environment(\.scenePhase) private var scenePhase
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var changedAt = Date()
+
+    init(mood: VeilOpponentAvatarMood, size: CGFloat = 76) {
+        self.mood = mood
+        self.size = size
+    }
+
+    var body: some View {
+        TimelineView(.animation(
+            minimumInterval: VeilOpponentAvatarPolicy.frameInterval(
+                lowPower: ProcessInfo.processInfo.isLowPowerModeEnabled
+            ),
+            paused: reduceMotion || scenePhase != .active
+        )) { timeline in
+            let time = timeline.date.timeIntervalSinceReferenceDate
+            let age = max(0, timeline.date.timeIntervalSince(changedAt))
+            graphic(time: time, reactionAge: age)
+        }
+        .frame(width: size, height: size)
+        .onChange(of: mood) { _ in changedAt = Date() }
+        .allowsHitTesting(false)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("电脑对手：\(mood.label)")
+    }
+
+    private func graphic(time: TimeInterval, reactionAge: TimeInterval) -> some View {
+        let wobble = reduceMotion ? 0 : exp(-reactionAge * 3.4) * sin(reactionAge * 19) * 6
+        let bounce = reduceMotion ? 0 : sin(time * 1.8) * 2.0 + wobble * 0.4
+        let blink: CGFloat = reduceMotion ? 1 : (sin(time * 2.4) > 0.995 ? 0.12 : 1)
+        let gaze: CGFloat = mood == .thinking && !reduceMotion ? CGFloat(cos(time * 1.7) * 3) : 0
+        let eye: Color = mood == .lost ? .orange : (mood == .won ? .green : .cyan)
+        return ZStack {
+            Circle()
+                .trim(from: 0.05, to: 0.93)
+                .stroke(
+                    AngularGradient(colors: [.cyan.opacity(0.2), .cyan, .purple, .cyan.opacity(0.2)],
+                                    center: .center),
+                    style: StrokeStyle(lineWidth: 2.2, lineCap: .round)
+                )
+                .frame(width: 72, height: 72)
+                .rotationEffect(.degrees(
+                    reduceMotion ? 0 : time * (mood == .thinking ? 36 : 12)
+                ))
+            ZStack {
+                RoundedRectangle(cornerRadius: 16, style: .continuous)
+                    .fill(LinearGradient(
+                        colors: [Color(red: 0.16, green: 0.30, blue: 0.44),
+                                 Color(red: 0.04, green: 0.07, blue: 0.15)],
+                        startPoint: .topLeading, endPoint: .bottomTrailing
+                    ))
+                    .overlay(RoundedRectangle(cornerRadius: 16)
+                        .stroke(Color.cyan.opacity(0.55), lineWidth: 1.2))
+                HStack(spacing: 13) {
+                    Capsule().fill(eye).frame(width: 7, height: 12 * blink)
+                    Capsule().fill(eye).frame(width: 7, height: 12 * blink)
+                }
+                .offset(x: gaze, y: -2)
+                Capsule()
+                    .fill(eye.opacity(0.55))
+                    .frame(width: mood == .won ? 19 : 12, height: 2)
+                    .offset(y: 13)
+                Circle().fill(.white.opacity(0.4))
+                    .frame(width: 4, height: 4).offset(x: 17, y: -18)
+            }
+            .frame(width: 52, height: 50)
+            .rotationEffect(.degrees(wobble * 0.35))
+            .offset(y: bounce)
+        }
+        .frame(width: 76, height: 76)
+        .scaleEffect(size / 76)
+        .frame(width: size, height: size)
+    }
+}
diff --git a/VeilLinkTests/VeilOpponentAvatarPolicyTests.swift b/VeilLinkTests/VeilOpponentAvatarPolicyTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/VeilOpponentAvatarPolicyTests.swift
@@ -0,0 +1,21 @@
+import XCTest
+@testable import VeilLink
+
+final class VeilOpponentAvatarPolicyTests: XCTestCase {
+    func testSwitchIsOffUnlessExplicitlyEnabled() {
+        XCTAssertFalse(VeilOpponentAvatarPolicy.shouldRender(enabled: false, hasComputerOpponent: true))
+        XCTAssertTrue(VeilOpponentAvatarPolicy.shouldRender(enabled: true, hasComputerOpponent: true))
+        XCTAssertFalse(VeilOpponentAvatarPolicy.shouldRender(enabled: true, hasComputerOpponent: false))
+    }
+
+    func testSafeFramePacing() {
+        XCTAssertEqual(VeilOpponentAvatarPolicy.frameInterval(lowPower: false), 1.0 / 30.0)
+        XCTAssertEqual(VeilOpponentAvatarPolicy.frameInterval(lowPower: true), 1.0 / 15.0)
+    }
+
+    func testOwnerKeyAndMood() {
+        XCTAssertEqual(VeilOpponentAvatarPolicy.preferenceKey, "owner.grokbot.original.enabled.v1")
+        XCTAssertEqual(VeilOpponentAvatarMood.thinking.label, "正在思考")
+        XCTAssertEqual(VeilOpponentAvatarMood.won.label, "电脑获胜")
+    }
+}
