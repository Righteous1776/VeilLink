+++ b/VeilLink/Agent/Language/LlamaNativeLifecycle.swift
@@ -0,0 +1,51 @@
+import Foundation
+
+/// Models native llama pointer ownership across actor suspension points.
+/// Actor isolation alone does NOT prevent reentry after await.
+struct LlamaNativeLifecycle {
+    enum Completion: Equatable {
+        case noChange
+        case trim
+        case shutdown
+    }
+
+    private(set) var generating = false
+    private(set) var trimPending = false
+    private(set) var shutdownPending = false
+
+    mutating func beginGeneration() -> Bool {
+        guard !generating, !shutdownPending else { return false }
+        generating = true
+        return true
+    }
+
+    /// Returning false means the native operation must be deferred.
+    mutating func requestTrim() -> Bool {
+        guard !shutdownPending else { return false }
+        guard generating else { return true }
+        trimPending = true
+        return false
+    }
+
+    /// Returning false means the caller must wait for generation to unwind.
+    mutating func requestShutdown() -> Bool {
+        guard generating else { return true }
+        shutdownPending = true
+        trimPending = false
+        return false
+    }
+
+    mutating func finishGeneration() -> Completion {
+        generating = false
+        if shutdownPending {
+            shutdownPending = false
+            trimPending = false
+            return .shutdown
+        }
+        if trimPending {
+            trimPending = false
+            return .trim
+        }
+        return .noChange
+    }
+}
diff --git a/VeilLink/Agent/Language/LlamaProcessLoadLease.swift b/VeilLink/Agent/Language/LlamaProcessLoadLease.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Language/LlamaProcessLoadLease.swift
@@ -0,0 +1,36 @@
+import Foundation
+
+/// Process-wide native backend lease for the on-device llama runtime.
+/// A Swift actor protects one engine's pointers, but not another independent
+/// runtime's llama_backend_init/llama_backend_free. The lease remains owned
+/// from successful acquisition until that runtime has fully freed its model.
+@MainActor
+final class LlamaProcessLoadLease {
+    static let shared = LlamaProcessLoadLease()
+
+    private(set) var hasOwner = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+
+    var waitingCount: Int { waiters.count }
+
+    func acquire() async {
+        if !hasOwner {
+            hasOwner = true
+            return
+        }
+        await withCheckedContinuation { continuation in
+            waiters.append(continuation)
+        }
+        // The previous owner transferred the lease directly to this waiter.
+        // hasOwner remains true; no other runtime can initialize in between.
+    }
+
+    func release() {
+        guard hasOwner else { return }
+        if waiters.isEmpty {
+            hasOwner = false
+        } else {
+            waiters.removeFirst().resume()
+        }
+    }
+}
