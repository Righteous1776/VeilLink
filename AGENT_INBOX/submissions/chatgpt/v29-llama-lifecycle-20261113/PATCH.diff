diff --git a/VeilLinkTests/LlamaNativeLifecycleTests.swift b/VeilLinkTests/LlamaNativeLifecycleTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/LlamaNativeLifecycleTests.swift
@@ -0,0 +1,51 @@
+import XCTest
+@testable import VeilLink
+
+final class LlamaNativeLifecycleTests: XCTestCase {
+    func testCannotEnterSecondGenerationAcrossActorSuspension() {
+        var fence = LlamaNativeLifecycle()
+        XCTAssertTrue(fence.beginGeneration())
+        XCTAssertFalse(fence.beginGeneration())
+        XCTAssertEqual(fence.finishGeneration(), .noChange)
+        XCTAssertTrue(fence.beginGeneration())
+    }
+
+    func testTrimRequestedDuringGenerationIsDeferred() {
+        var fence = LlamaNativeLifecycle()
+        XCTAssertTrue(fence.beginGeneration())
+        XCTAssertFalse(fence.requestTrim())
+        XCTAssertTrue(fence.trimPending)
+        XCTAssertEqual(fence.finishGeneration(), .trim)
+        XCTAssertFalse(fence.generating)
+        XCTAssertFalse(fence.trimPending)
+    }
+
+    func testShutdownWinsOverPendingTrimAndPreventsNewEntry() {
+        var fence = LlamaNativeLifecycle()
+        XCTAssertTrue(fence.beginGeneration())
+        XCTAssertFalse(fence.requestTrim())
+        XCTAssertFalse(fence.requestShutdown())
+        XCTAssertTrue(fence.shutdownPending)
+        XCTAssertFalse(fence.beginGeneration())
+        XCTAssertEqual(fence.finishGeneration(), .shutdown)
+        XCTAssertFalse(fence.shutdownPending)
+        XCTAssertFalse(fence.trimPending)
+    }
+
+    func testRepeatedShutdownDuringGenerationCannotReenter() {
+        var fence = LlamaNativeLifecycle()
+        XCTAssertTrue(fence.beginGeneration())
+        XCTAssertFalse(fence.requestShutdown())
+        XCTAssertFalse(fence.requestShutdown())
+        XCTAssertFalse(fence.beginGeneration())
+        XCTAssertEqual(fence.finishGeneration(), .shutdown)
+        XCTAssertFalse(fence.shutdownPending)
+    }
+
+    func testIdleShutdownCanReleaseImmediately() {
+        var fence = LlamaNativeLifecycle()
+        XCTAssertTrue(fence.requestShutdown())
+        XCTAssertFalse(fence.generating)
+        XCTAssertTrue(fence.requestTrim())
+    }
+}
diff --git a/VeilLinkTests/LlamaProcessLoadLeaseTests.swift b/VeilLinkTests/LlamaProcessLoadLeaseTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/LlamaProcessLoadLeaseTests.swift
@@ -0,0 +1,60 @@
+import XCTest
+@testable import VeilLink
+
+@MainActor
+final class LlamaProcessLoadLeaseTests: XCTestCase {
+    func testLeaseStartsFreeAndCanBeReacquiredAfterRelease() async {
+        let lease = LlamaProcessLoadLease()
+        XCTAssertFalse(lease.hasOwner)
+        await lease.acquire()
+        XCTAssertTrue(lease.hasOwner)
+        lease.release()
+        XCTAssertFalse(lease.hasOwner)
+        await lease.acquire()
+        XCTAssertTrue(lease.hasOwner)
+        lease.release()
+    }
+
+    func testSecondRuntimeBlocksUntilFirstFullyReleases() async {
+        let lease = LlamaProcessLoadLease()
+        await lease.acquire()
+        let second = Task { @MainActor in
+            await lease.acquire()
+            return lease.hasOwner
+        }
+        for _ in 0..<200 {
+            if lease.waitingCount == 1 { break }
+            await Task.yield()
+        }
+        XCTAssertEqual(lease.waitingCount, 1)
+        XCTAssertTrue(lease.hasOwner)
+        lease.release()
+        let received = await second.value
+        XCTAssertTrue(received)
+        lease.release()
+        XCTAssertFalse(lease.hasOwner)
+    }
+
+    func testCancelledWaiterStillMustReleaseLeaseWhenResumed() async {
+        let lease = LlamaProcessLoadLease()
+        await lease.acquire()
+        let second = Task { @MainActor in
+            await lease.acquire()
+            // Cancellation after enqueue does not remove the continuation.
+            // The runtime rechecks its epoch then releases this lease.
+            let wasCancelled = Task.isCancelled
+            lease.release()
+            return wasCancelled
+        }
+        for _ in 0..<200 {
+            if lease.waitingCount == 1 { break }
+            await Task.yield()
+        }
+        XCTAssertEqual(lease.waitingCount, 1)
+        second.cancel()
+        lease.release()
+        let wasCancelled = await second.value
+        XCTAssertTrue(wasCancelled)
+        XCTAssertFalse(lease.hasOwner)
+    }
+}
