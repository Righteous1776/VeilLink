 import Foundation
 
+enum ImageTransferProfile: Sendable, Equatable {
+    case bluetooth, fastLAN
+}
+
 enum MediaTransferPolicy {
     static let targetImageBytes = 1_800_000
     static let maximumImageBytes = 3_000_000
     static let maximumImageDimension = 4_096
     static let minimumImageDimension = 1_600
+    static let bluetoothTargetImageBytes = 200_000
+    static let bluetoothPreferredImageBytes = 384_000
+    static let bluetoothMaximumDimension = 1_600
 
+    static func targetImageBytes(for profile: ImageTransferProfile) -> Int {
+        profile == .bluetooth ? bluetoothTargetImageBytes : targetImageBytes
+    }
+
+    /// 384KB is preferred, NEVER a rejection threshold.
+    static func preferredImageBytes(for profile: ImageTransferProfile) -> Int {
+        profile == .bluetooth ? bluetoothPreferredImageBytes : maximumImageBytes
+    }
+
+    static func canTransmitImage(_ bytes: Int) -> Bool {
+        bytes > 0 && bytes <= maximumImageBytes
+    }
+
+    static func maximumImageDimension(for profile: ImageTransferProfile) -> Int {
+        profile == .bluetooth ? bluetoothMaximumDimension : maximumImageDimension
+    }
+
+    static func qualityRange(for profile: ImageTransferProfile) -> (initial: Double, minimum: Double) {
+        profile == .bluetooth ? (0.90, 0.72) : (0.96, 0.84)
+    }
+
+    static func nextCompressionQuality(
+        current: Double, encodedBytes: Int, maximumBytes: Int, floor: Double
+    ) -> Double? {
+        guard maximumBytes > 0, encodedBytes > maximumBytes,
+              floor >= 0, current > floor + 0.025 else { return nil }
+        let ratio = max(0.05, min(1, Double(maximumBytes) / Double(encodedBytes)))
+        let adjusted = max(floor, min(current - 0.06, current * sqrt(ratio)))
+        return adjusted < current - 0.025 ? adjusted : nil
+    }
+
     static let supportedImageMIMETypes: Set<String> = [
         "image/jpeg",
         "image/heic",
