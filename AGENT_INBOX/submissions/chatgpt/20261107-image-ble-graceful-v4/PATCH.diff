diff --git a/VeilLinkTests/MediaTransferPolicyTests.swift b/VeilLinkTests/MediaTransferPolicyTests.swift
--- a/VeilLinkTests/MediaTransferPolicyTests.swift
+++ b/VeilLinkTests/MediaTransferPolicyTests.swift
@@ -2,6 +2,30 @@
 @testable import VeilLink
 
 final class MediaTransferPolicyTests: XCTestCase {
+    func testBLERecommendationIsNotAWireLimit() {
+        XCTAssertEqual(MediaTransferPolicy.bluetoothTargetImageBytes, 200_000)
+        XCTAssertEqual(MediaTransferPolicy.bluetoothPreferredImageBytes, 384_000)
+        XCTAssertEqual(MediaTransferPolicy.preferredImageBytes(for: .bluetooth), 384_000)
+        XCTAssertTrue(MediaTransferPolicy.canTransmitImage(500_000))
+        XCTAssertTrue(MediaTransferPolicy.canTransmitImage(2_900_000))
+        XCTAssertFalse(MediaTransferPolicy.canTransmitImage(3_000_001))
+    }
+
+    func testQualityFloorAndFeedbackAreBounded() {
+        let limits = MediaTransferPolicy.qualityRange(for: .bluetooth)
+        XCTAssertEqual(limits.minimum, 0.72)
+        XCTAssertNil(MediaTransferPolicy.nextCompressionQuality(
+            current: limits.initial, encodedBytes: 180_000,
+            maximumBytes: 200_000, floor: limits.minimum
+        ))
+        let next = MediaTransferPolicy.nextCompressionQuality(
+            current: limits.initial, encodedBytes: 800_000,
+            maximumBytes: 200_000, floor: limits.minimum
+        )
+        XCTAssertNotNil(next)
+        XCTAssertGreaterThanOrEqual(next ?? 0, limits.minimum)
+    }
+
     func testTransferLayerAcceptsSafeOutputFormats() {
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/jpeg"))
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/heic"))
