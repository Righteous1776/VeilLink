+    func tick(now: Date = Date()) {
+        guard boundLocalIdentity == localIdentity() else { suspendForIdentityChange(); return }
+        guard foreground else { return }
+        if (incomingInvitation != nil || outgoingInvitation != nil), now.timeIntervalSince(invitationBegan) > 120 {
+            incomingInvitation = nil; outgoingInvitation = nil; status = "邀请已过期，请重新邀请"
+        }
+        if let invite = outgoingInvitation, sessions.hasSecureSession(for: invite.guestIdentityID),
+           now.timeIntervalSince(lastInviteSent) >= 10 {
+            lastInviteSent = now
+            enqueue(.init(roomID: invite.roomID, kind: .invite, configuration: invite), to: invite.guestIdentityID)
+        }
+        if gameModel == nil && incomingInvitation == nil && outgoingInvitation == nil {
+            monitorTask?.cancel(); monitorTask = nil
+            return
+        }
+        guard let config = configuration, let local = localIdentity(), !peerLeft else { return }
+        let peer = peer(for: config, local: local)
+        let secureReady = sessions.hasSecureSession(for: peer)
+        let silentFor = now.timeIntervalSince(lastHeard)
+        if VeilopolyRoomLinkPolicy.shouldPauseGame(secureSessionReady: secureReady,
+            secondsSincePeer: silentFor) {
+            gameModel?.setNetworkAvailability(false, message: "加密会话暂不可用，保留进度并等待恢复")
+            status = "加密链路未就绪，等待恢复；没有主动断开蓝牙"
+            // Never reset shared chat encryption from a game timer.
+            return
+        }
+        if VeilopolyRoomLinkPolicy.shouldProbeGameSync(secureSessionReady: secureReady,
+            secondsSincePeer: silentFor) {
+            // The tiny status packet below is a probe, not evidence of disconnection.
+            // Preserve game readiness until an authenticated session is actually lost
+            // or a state-integrity check explicitly requires a pause.
+            status = "加密链路仍在，游戏暂未收到回应；正在轻量核对同步"
+        }
+        if waitingForHostAcceptance {
+            enqueue(.init(roomID: config.roomID, kind: .accept), to: config.hostIdentityID)
+        }
+        gameModel?.sendNetworkStatus()
+        // A lost proposal leaves equal hashes but an outstanding client request.
+        // Request a definitive snapshot even then; never infer execution from silence.
+        if gameModel?.networkReady == false || gameModel?.awaitingHost == true { gameModel?.requestNetworkSync() }
+    }
     private func suspendForIdentityChange() {
         gameModel?.flushSave()
         gameModel?.setNetworkAvailability(false, message: "本机身份已切换，原联机房间暂停")
