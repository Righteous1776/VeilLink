+    func testQuietButAuthenticatedPeerDoesNotForceGameOffline() throws {
+        let channel = InvitationChannel()
+        let (bridge, directory) = makeBridge(channel)
+        defer { bridge.leaveRoom(); try? FileManager.default.removeItem(at: directory) }
+        bridge.invite(conversation())
+        let config = try XCTUnwrap(bridge.outgoingInvitation)
+        for fragment in try VeilopolyControlCodec.fragments(.init(roomID: config.roomID, kind: .accept)) {
+            bridge.receive(.init(topic: VeilopolyControlCodec.topic,
+                payload: try JSONEncoder().encode(fragment)), from: "guest")
+        }
+        let game = try XCTUnwrap(bridge.gameModel)
