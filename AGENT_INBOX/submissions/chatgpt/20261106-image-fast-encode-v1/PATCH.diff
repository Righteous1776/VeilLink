+/// Adaptive, capped rate control. One encode is the common path; never run an
+/// unbounded quality search on a large source photo.
+enum ImageCompressionSearchPolicy {
+    static let initialQuality: CGFloat = 0.86
+    static let minimumQuality: CGFloat = 0.62
+    static let maximumAttemptsPerDimension = 3
+
+    /// Estimate the next quality from the *actual encoded byte count*. This
+    /// intentionally avoids a binary search that would spend more CPU encoding
+    /// the same giant bitmap just to gain a few percentage points of quality.
+    static func nextQuality(
+        after quality: CGFloat,
+        encodedBytes: Int,
+        targetBytes: Int
+    ) -> CGFloat? {
+        guard encodedBytes > targetBytes, targetBytes > 0,
+              quality > minimumQuality + 0.025 else { return nil }
+        let ratio = max(0.05, min(1.0, Double(targetBytes) / Double(encodedBytes)))
+        let next = max(
+            Double(minimumQuality),
+            min(Double(quality) - 0.06, Double(quality) * sqrt(ratio))
+        )
+        guard next < Double(quality) - 0.025 else { return nil }
+        return CGFloat(next)
+    }
+}
