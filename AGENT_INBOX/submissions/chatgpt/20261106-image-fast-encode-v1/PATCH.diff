diff --git a/VeilLinkTests/MediaTransferPolicyTests.swift b/VeilLinkTests/MediaTransferPolicyTests.swift
--- a/VeilLinkTests/MediaTransferPolicyTests.swift
+++ b/VeilLinkTests/MediaTransferPolicyTests.swift
@@ -2,6 +2,41 @@
 @testable import VeilLink
 
 final class MediaTransferPolicyTests: XCTestCase {
+
+    func testAdaptiveCompressionQualityDropsOnlyWhenOverTarget() {
+        let original = ImageCompressionSearchPolicy.initialQuality
+        XCTAssertNil(ImageCompressionSearchPolicy.nextQuality(
+            after: original, encodedBytes: 1_700_000, targetBytes: 1_800_000
+        ))
+        let next = ImageCompressionSearchPolicy.nextQuality(
+            after: original, encodedBytes: 3_600_000, targetBytes: 1_800_000
+        )
+        XCTAssertNotNil(next)
+        XCTAssertGreaterThanOrEqual(next ?? 0, ImageCompressionSearchPolicy.minimumQuality)
+        XCTAssertLessThan(next ?? 1, original)
+        XCTAssertLessThanOrEqual(ImageCompressionSearchPolicy.maximumAttemptsPerDimension, 3)
+    }
+
+    func testAdaptiveCompressionSearchStopsAtQualityFloorAndInvalidBudgets() {
+        XCTAssertNil(ImageCompressionSearchPolicy.nextQuality(
+            after: ImageCompressionSearchPolicy.minimumQuality,
+            encodedBytes: 4_000_000, targetBytes: 1_800_000
+        ))
+        XCTAssertNil(ImageCompressionSearchPolicy.nextQuality(
+            after: ImageCompressionSearchPolicy.initialQuality,
+            encodedBytes: 4_000_000, targetBytes: 0
+        ))
+    }
+
+    func testAdaptiveCompressionDoesNotIncreaseQualityForSmallOvershoot() {
+        let next = ImageCompressionSearchPolicy.nextQuality(
+            after: 0.86, encodedBytes: 1_820_000, targetBytes: 1_800_000
+        )
+        XCTAssertNotNil(next)
+        XCTAssertLessThan(next ?? 1, 0.86)
+        XCTAssertGreaterThanOrEqual(next ?? 0, ImageCompressionSearchPolicy.minimumQuality)
+    }
+
     func testTransferLayerAcceptsSafeOutputFormats() {
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/jpeg"))
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/heic"))
