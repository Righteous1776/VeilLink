diff --git a/VeilLink/Agent/Games/LocalBoardMatchStore.swift b/VeilLink/Agent/Games/LocalBoardMatchStore.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Agent/Games/LocalBoardMatchStore.swift
@@ -0,0 +1,156 @@
+import Foundation
+
+struct LocalBoardSavedMove: Codable, Equatable {
+    let actor: MiniGamePlayer
+    let move: MiniGameMove
+}
+
+struct LocalBoardSavedMatch: Codable {
+    static let version = 1
+    let schemaVersion: Int
+    let game: MiniGameKind
+    let sessionID: String
+    let difficulty: String
+    let moves: [LocalBoardSavedMove]
+}
+
+struct LocalBoardRestoredMatch {
+    let document: LocalBoardSavedMatch
+    let gomoku: GomokuState?
+    let xiangqi: XiangqiState?
+    let learningPlies: [AdaptiveBoardPly]
+    var finished: Bool {
+        if let gomoku { return gomoku.winner != nil || gomoku.isDraw }
+        if let xiangqi { return xiangqi.winner != nil || xiangqi.isDraw }
+        return false
+    }
+}
+
+enum LocalBoardLoadResult {
+    case missing
+    case restored(LocalBoardRestoredMatch)
+    case damaged
+}
+
+/// This journal is NOT the AI's AdaptiveBoardLearningStore.
+final class LocalBoardMatchStore {
+    let game: MiniGameKind
+    let fileURL: URL
+    private(set) var requiresRecovery = false
+
+    init(game: MiniGameKind, fileURL: URL? = nil) {
+        self.game = game
+        if let fileURL { self.fileURL = fileURL }
+        else {
+            let base = FileManager.default.urls(
+                for: .applicationSupportDirectory, in: .userDomainMask
+            ).first ?? FileManager.default.temporaryDirectory
+            self.fileURL = base
+                .appendingPathComponent("VeilLink", isDirectory: true)
+                .appendingPathComponent("LocalBoardMatches", isDirectory: true)
+                .appendingPathComponent(game.rawValue + "-v1.json")
+        }
+    }
+
+    func load() -> LocalBoardLoadResult {
+        guard FileManager.default.fileExists(atPath: fileURL.path) else { return .missing }
+        do {
+            let attrs = try FileManager.default.attributesOfItem(atPath: fileURL.path)
+            let size = (attrs[.size] as? NSNumber)?.intValue ?? 0
+            guard (1...1_048_576).contains(size) else {
+                requiresRecovery = true
+                return .damaged
+            }
+            let data = try Data(contentsOf: fileURL)
+            guard let document = try? JSONDecoder().decode(LocalBoardSavedMatch.self, from: data),
+                  let restored = Self.replay(document, game: game) else {
+                requiresRecovery = true
+                return .damaged
+            }
+            return .restored(restored)
+        } catch {
+            requiresRecovery = true
+            return .damaged
+        }
+    }
+
+    @discardableResult
+    func save(_ document: LocalBoardSavedMatch) -> Bool {
+        guard !requiresRecovery,
+              document.game == game,
+              Self.replay(document, game: game) != nil,
+              let data = try? JSONEncoder().encode(document),
+              data.count <= 1_048_576 else { return false }
+        do {
+            try FileManager.default.createDirectory(
+                at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true
+            )
+            try data.write(
+                to: fileURL,
+                options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication]
+            )
+            return true
+        } catch { return false }
+    }
+
+    @discardableResult
+    func clear() -> Bool {
+        do {
+            if FileManager.default.fileExists(atPath: fileURL.path) {
+                try FileManager.default.removeItem(at: fileURL)
+            }
+            requiresRecovery = false
+            return true
+        } catch { return false }
+    }
+
+    /// Rebuild all rule-dependent fields (turn, check history, repetition,
+    /// win/draw status) from verified legal moves; reject mismatched actors.
+    static func replay(_ document: LocalBoardSavedMatch, game: MiniGameKind) -> LocalBoardRestoredMatch? {
+        guard document.schemaVersion == LocalBoardSavedMatch.version,
+              document.game == game,
+              game == .gomoku || game == .xiangqi,
+              UUID(uuidString: document.sessionID) != nil,
+              BoardBotDifficulty(rawValue: document.difficulty) != nil,
+              !document.moves.isEmpty,
+              document.moves.count <= 4_096 else { return nil }
+        var plies: [AdaptiveBoardPly] = []
+        plies.reserveCapacity(document.moves.count)
+        switch game {
+        case .gomoku:
+            var state = GomokuState()
+            for action in document.moves {
+                guard state.winner == nil, !state.isDraw,
+                      action.actor == state.currentPlayer,
+                      action.move.from == nil, action.move.piece == nil,
+                      let index = action.move.to else { return nil }
+                let position = AdaptiveBoardPosition.gomoku(state)
+                guard state.apply(index: index, actor: action.actor) else { return nil }
+                plies.append(AdaptiveBoardPly(
+                    position: position, action: String(index), actor: action.actor
+                ))
+            }
+            return LocalBoardRestoredMatch(
+                document: document, gomoku: state, xiangqi: nil, learningPlies: plies
+            )
+        case .xiangqi:
+            var state = XiangqiState()
+            for action in document.moves {
+                guard state.winner == nil, !state.isDraw,
+                      action.actor == state.currentPlayer,
+                      action.move.piece == nil,
+                      let from = action.move.from, let to = action.move.to else { return nil }
+                let position = AdaptiveBoardPosition.xiangqi(state)
+                guard state.apply(from: from, to: to, actor: action.actor) else { return nil }
+                plies.append(AdaptiveBoardPly(
+                    position: position, action: String(from) + ":" + String(to),
+                    actor: action.actor
+                ))
+            }
+            return LocalBoardRestoredMatch(
+                document: document, gomoku: nil, xiangqi: state, learningPlies: plies
+            )
+        default: return nil
+        }
+    }
+}
diff --git a/VeilLinkTests/LocalBoardMatchStoreTests.swift b/VeilLinkTests/LocalBoardMatchStoreTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/LocalBoardMatchStoreTests.swift
@@ -0,0 +1,89 @@
+import Foundation
+import XCTest
+@testable import VeilLink
+
+final class LocalBoardMatchStoreTests: XCTestCase {
+    private func dir() throws -> URL {
+        let folder = FileManager.default.temporaryDirectory
+            .appendingPathComponent("vl-local-game-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        return folder
+    }
+    private func doc(_ game: MiniGameKind, _ moves: [LocalBoardSavedMove]) -> LocalBoardSavedMatch {
+        LocalBoardSavedMatch(
+            schemaVersion: 1, game: game, sessionID: UUID().uuidString,
+            difficulty: BoardBotDifficulty.balanced.rawValue, moves: moves
+        )
+    }
+    func testGomokuReplaysAfterNewStoreAndPreservesComputerTurn() throws {
+        let folder = try dir(); defer { try? FileManager.default.removeItem(at: folder) }
+        let path = folder.appendingPathComponent("g.json")
+        let m = doc(.gomoku, [
+            LocalBoardSavedMove(actor: .host, move: .gomoku(index: 112)),
+            LocalBoardSavedMove(actor: .guest, move: .gomoku(index: 113)),
+            LocalBoardSavedMove(actor: .host, move: .gomoku(index: 127))
+        ])
+        XCTAssertTrue(LocalBoardMatchStore(game: .gomoku, fileURL: path).save(m))
+        switch LocalBoardMatchStore(game: .gomoku, fileURL: path).load() {
+        case .restored(let restored):
+            XCTAssertEqual(restored.document.sessionID, m.sessionID)
+            XCTAssertEqual(restored.gomoku?.moveCount, 3)
+            XCTAssertEqual(restored.gomoku?.currentPlayer, .guest)
+            XCTAssertEqual(restored.gomoku?.value(at: 112), 1)
+            XCTAssertEqual(restored.gomoku?.value(at: 113), 2)
+            XCTAssertEqual(restored.learningPlies.count, 3)
+        default: XCTFail("Expected restored Gomoku")
+        }
+    }
+    func testXiangqiReplaysAndPreservesSideToMove() throws {
+        let folder = try dir(); defer { try? FileManager.default.removeItem(at: folder) }
+        let path = folder.appendingPathComponent("x.json")
+        let m = doc(.xiangqi, [
+            LocalBoardSavedMove(actor: .host, move: .xiangqi(from: 54, to: 45)),
+            LocalBoardSavedMove(actor: .guest, move: .xiangqi(from: 27, to: 36))
+        ])
+        XCTAssertTrue(LocalBoardMatchStore(game: .xiangqi, fileURL: path).save(m))
+        switch LocalBoardMatchStore(game: .xiangqi, fileURL: path).load() {
+        case .restored(let restored):
+            XCTAssertEqual(restored.xiangqi?.moveCount, 2)
+            XCTAssertEqual(restored.xiangqi?.currentPlayer, .host)
+            XCTAssertEqual(restored.xiangqi?.piece(at: 45)?.kind, .soldier)
+            XCTAssertEqual(restored.xiangqi?.piece(at: 36)?.side, .black)
+        default: XCTFail("Expected restored Xiangqi")
+        }
+    }
+    func testDamagedArchiveIsPreservedAndCannotBeOverwrittenAutomatically() throws {
+        let folder = try dir(); defer { try? FileManager.default.removeItem(at: folder) }
+        let path = folder.appendingPathComponent("g.json")
+        let bytes = Data("{broken".utf8)
+        try bytes.write(to: path)
+        let s = LocalBoardMatchStore(game: .gomoku, fileURL: path)
+        if case .damaged = s.load() {} else { XCTFail("Expected damaged") }
+        XCTAssertTrue(s.requiresRecovery)
+        XCTAssertFalse(s.save(doc(.gomoku, [
+            LocalBoardSavedMove(actor: .host, move: .gomoku(index: 112))
+        ])))
+        XCTAssertEqual(try Data(contentsOf: path), bytes)
+    }
+    func testIllegalMoveAndPlayerMismatchAreRejected() {
+        let bad = doc(.gomoku, [
+            LocalBoardSavedMove(actor: .guest, move: .gomoku(index: 112))
+        ])
+        XCTAssertNil(LocalBoardMatchStore.replay(bad, game: .gomoku))
+        XCTAssertNil(LocalBoardMatchStore.replay(bad, game: .xiangqi))
+    }
+    func testClearOneGameNeverDeletesTheOthersJournal() throws {
+        let folder = try dir(); defer { try? FileManager.default.removeItem(at: folder) }
+        let g = LocalBoardMatchStore(game: .gomoku, fileURL: folder.appendingPathComponent("g"))
+        let x = LocalBoardMatchStore(game: .xiangqi, fileURL: folder.appendingPathComponent("x"))
+        XCTAssertTrue(g.save(doc(.gomoku, [
+            LocalBoardSavedMove(actor: .host, move: .gomoku(index: 112))
+        ])))
+        XCTAssertTrue(x.save(doc(.xiangqi, [
+            LocalBoardSavedMove(actor: .host, move: .xiangqi(from: 54, to: 45))
+        ])))
+        XCTAssertTrue(g.clear())
+        if case .missing = g.load() {} else { XCTFail("Gomoku should be clear") }
+        if case .restored = x.load() {} else { XCTFail("Xiangqi must remain") }
+    }
+}
