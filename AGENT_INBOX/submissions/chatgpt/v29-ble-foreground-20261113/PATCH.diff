diff --git a/VeilLink/Transport/BLELinkReliabilityPolicy.swift b/VeilLink/Transport/BLELinkReliabilityPolicy.swift
--- a/VeilLink/Transport/BLELinkReliabilityPolicy.swift
+++ b/VeilLink/Transport/BLELinkReliabilityPolicy.swift
@@ -27,6 +27,26 @@
 enum BLELinkReliabilityPolicy {
     static let reconnectStabilityResetInterval: TimeInterval = 30
 
+    /// Reconcile persisted connection intent when the app becomes foreground
+    /// even when CBCentralManager never emitted a new poweredOn callback.
+    static func shouldForegroundRestore(
+        isRunning: Bool,
+        foreground: Bool,
+        wantedCount: Int
+    ) -> Bool {
+        isRunning && foreground && wantedCount > 0
+    }
+
+    /// Retrying a recovered peripheral must not cancel and replace a pending
+    /// exponential-backoff timer. The CoreBluetooth state itself remains the
+    /// authoritative source of whether it is disconnected.
+    static func shouldScheduleRestoredReconnect(
+        isDisconnected: Bool,
+        hasPendingRetry: Bool
+    ) -> Bool {
+        isDisconnected && !hasPendingRetry
+    }
+
     static func normalizedRSSI(_ sample: Int) -> Int? {
         guard sample != 127, sample < 0, sample >= -110 else { return nil }
         return min(-20, sample)
diff --git a/VeilLinkTests/BLELinkReliabilityPolicyTests.swift b/VeilLinkTests/BLELinkReliabilityPolicyTests.swift
--- a/VeilLinkTests/BLELinkReliabilityPolicyTests.swift
+++ b/VeilLinkTests/BLELinkReliabilityPolicyTests.swift
@@ -2,6 +2,33 @@
 @testable import VeilLink
 
 final class BLELinkReliabilityPolicyTests: XCTestCase {
+    func testForegroundRestoreRequiresRunningForegroundAndPersistedIntent() {
+        XCTAssertTrue(BLELinkReliabilityPolicy.shouldForegroundRestore(
+            isRunning: true, foreground: true, wantedCount: 1
+        ))
+        XCTAssertFalse(BLELinkReliabilityPolicy.shouldForegroundRestore(
+            isRunning: false, foreground: true, wantedCount: 1
+        ))
+        XCTAssertFalse(BLELinkReliabilityPolicy.shouldForegroundRestore(
+            isRunning: true, foreground: false, wantedCount: 1
+        ))
+        XCTAssertFalse(BLELinkReliabilityPolicy.shouldForegroundRestore(
+            isRunning: true, foreground: true, wantedCount: 0
+        ))
+    }
+
+    func testRestoredPeripheralDoesNotResetPendingReconnectBackoff() {
+        XCTAssertTrue(BLELinkReliabilityPolicy.shouldScheduleRestoredReconnect(
+            isDisconnected: true, hasPendingRetry: false
+        ))
+        XCTAssertFalse(BLELinkReliabilityPolicy.shouldScheduleRestoredReconnect(
+            isDisconnected: true, hasPendingRetry: true
+        ))
+        XCTAssertFalse(BLELinkReliabilityPolicy.shouldScheduleRestoredReconnect(
+            isDisconnected: false, hasPendingRetry: false
+        ))
+    }
+
     func testRSSIQualityBands() {
         XCTAssertEqual(BLELinkReliabilityPolicy.quality(rssi: -55), .strong)
         XCTAssertEqual(BLELinkReliabilityPolicy.quality(rssi: -62), .strong)
