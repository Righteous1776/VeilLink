diff --git a/VeilLinkTests/MediaTransferPolicyTests.swift b/VeilLinkTests/MediaTransferPolicyTests.swift
--- a/VeilLinkTests/MediaTransferPolicyTests.swift
+++ b/VeilLinkTests/MediaTransferPolicyTests.swift
@@ -2,6 +2,42 @@
 @testable import VeilLink
 
 final class MediaTransferPolicyTests: XCTestCase {
+    func testHighFidelityPreservesOriginalJPEGAndHEICAtFullWireLimit() {
+        XCTAssertTrue(VeilHighFidelityPolicy.preserveOriginal(
+            byteCount: 2_900_000, maximumBytes: 3_000_000,
+            largestDimension: 4_096, dimensionLimit: 4_096
+        ))
+        XCTAssertFalse(VeilHighFidelityPolicy.preserveOriginal(
+            byteCount: 3_100_000, maximumBytes: 3_000_000,
+            largestDimension: 4_096, dimensionLimit: 4_096
+        ))
+        XCTAssertFalse(VeilHighFidelityPolicy.preserveOriginal(
+            byteCount: 1_000_000, maximumBytes: 3_000_000,
+            largestDimension: 8_192, dimensionLimit: 4_096
+        ))
+    }
+
+    func testHighFidelityAdaptiveQualityNeverDropsBelowFloor() {
+        XCTAssertEqual(VeilHighFidelityPolicy.initialQuality, 0.96)
+        XCTAssertEqual(VeilHighFidelityPolicy.minimumQuality, 0.86)
+        XCTAssertEqual(VeilHighFidelityPolicy.maximumAttemptsPerResolution, 3)
+        XCTAssertNil(VeilHighFidelityPolicy.nextQuality(
+            after: 0.96, encodedBytes: 2_900_000, maximumBytes: 3_000_000
+        ))
+        let candidate = VeilHighFidelityPolicy.nextQuality(
+            after: 0.96, encodedBytes: 4_300_000, maximumBytes: 3_000_000
+        )
+        XCTAssertNotNil(candidate)
+        XCTAssertGreaterThanOrEqual(candidate ?? 0, 0.86)
+        XCTAssertLessThan(candidate ?? 1, 0.96)
+        XCTAssertNil(VeilHighFidelityPolicy.nextQuality(
+            after: 0.86, encodedBytes: 5_000_000, maximumBytes: 3_000_000
+        ))
+        XCTAssertNil(VeilHighFidelityPolicy.nextQuality(
+            after: 0.96, encodedBytes: 5_000_000, maximumBytes: 0
+        ))
+    }
+
     func testTransferLayerAcceptsSafeOutputFormats() {
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/jpeg"))
         XCTAssertTrue(MediaTransferPolicy.supportsImageMIMEType("image/heic"))
