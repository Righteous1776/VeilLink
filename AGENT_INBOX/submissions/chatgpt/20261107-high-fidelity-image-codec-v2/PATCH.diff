+/// Quality-first image encoding policy. JPEG/HEIC <=3 MB are passed through
+/// verbatim rather than being degraded toward the old 1.8 MB soft target.
+enum VeilHighFidelityPolicy {
+    static let initialQuality = 0.96
+    static let minimumQuality = 0.86
+    static let maximumAttemptsPerResolution = 3
+
+    static func nextQuality(after quality: Double, encodedBytes: Int, maximumBytes: Int) -> Double? {
+        guard maximumBytes > 0, encodedBytes > maximumBytes,
+              quality > minimumQuality + 0.005 else { return nil }
+        let ratio = max(0.05, min(1, Double(maximumBytes) / Double(encodedBytes)))
+        let estimate = quality * pow(ratio, 0.42)
+        let candidate = max(minimumQuality, min(quality - 0.035, estimate))
+        guard candidate < quality - 0.005 else { return nil }
+        return candidate
+    }
+
+    static func preserveOriginal(
+        byteCount: Int, maximumBytes: Int,
+        largestDimension: Int, dimensionLimit: Int
+    ) -> Bool {
+        byteCount > 0 && byteCount <= maximumBytes &&
+        largestDimension > 0 && largestDimension <= dimensionLimit
+    }
+}
