@@ -0,0 +1,46 @@
+import XCTest
+#if canImport(VeilMegaEngines)
+@testable import VeilMegaEngines
+#elseif canImport(VeilLink)
+@testable import VeilLink
+#endif
+
+final class VeilR6VisualTimelineTests: XCTestCase {
+    typealias V=VeilRhythmVisualTimeline
+    func testOneNoteAtHitLine() throws {
+        let note=try XCTUnwrap(V.notes(seed:7,district:0,nextBeat:0,secondsToNextBeat:0).first)
+        XCTAssertEqual(note.y,V.strikeY,accuracy:1e-8)
+        XCTAssertEqual(note.beat,0)
+    }
+    func testFutureNoteStartsAtSpawnLine() throws {
+        let note=try XCTUnwrap(V.notes(seed:7,district:0,nextBeat:0,secondsToNextBeat:1.6).first)
+        XCTAssertEqual(note.y,V.spawnY,accuracy:1e-8)
+    }
+    func testAllFourLaneCentersAreInsideCanvas() {
+        for seed in UInt64(0)..<80 {
+            let arr=V.notes(seed:seed,district:0,nextBeat:0,secondsToNextBeat:0.5)
+            XCTAssertFalse(arr.isEmpty)
+            for note in arr {
+                XCTAssertTrue((0..<4).contains(note.lane))
+                XCTAssertGreaterThan(note.x,0)
+                XCTAssertLessThan(note.x,390)
+                XCTAssertGreaterThanOrEqual(note.y,V.spawnY)
+                XCTAssertLessThanOrEqual(note.y,V.strikeY)
+            }
+        }
+    }
+    func testInvalidFrameHasNoNotes() {
+        XCTAssertTrue(V.notes(seed:1,district:0,nextBeat:0,secondsToNextBeat:.nan).isEmpty)
+        XCTAssertTrue(V.notes(seed:1,district:-1,nextBeat:0,secondsToNextBeat:0).isEmpty)
+        XCTAssertTrue(V.notes(seed:1,district:0,nextBeat:16,secondsToNextBeat:0).isEmpty)
+    }
+    func testNoFutureLeakAcrossDistrict() {
+        let notes=V.notes(seed:1,district:3,nextBeat:15,secondsToNextBeat:1.2,capacity:10)
+        XCTAssertTrue(notes.allSatisfy { $0.beat==15 })
+    }
+    func testClockAnimationInvariantAcrossFPS() {
+        let at60=V.notes(seed:3,district:1,nextBeat:2,secondsToNextBeat:0.42)
+        let at30=V.notes(seed:3,district:1,nextBeat:2,secondsToNextBeat:0.42)
+        XCTAssertEqual(at60,at30)
+    }
+}
diff --git a/VeilLinkTests/VeilR7RenderCacheTests.swift b/VeilLinkTests/VeilR7RenderCacheTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/VeilR7RenderCacheTests.swift
@@ -0,0 +1,70 @@
+import XCTest
+#if canImport(VeilMegaEngines)
+@testable import VeilMegaEngines
+#elseif canImport(VeilLink)
+@testable import VeilLink
+#endif
+
+final class VeilR7RenderCacheTests: XCTestCase {
+    typealias Cache = VeilRhythmRenderCache
+    typealias Watch = VeilRenderSnapshotWatchdog
+
+    func testAllDistrictsCanInitialize() {
+        for d in 0..<4 { XCTAssertNotNil(Cache(seed: 42, district: d)) }
+        XCTAssertNil(Cache(seed: 42, district: -1))
+        XCTAssertNil(Cache(seed: 42, district: 4))
+    }
+    func testCacheMatchesReferenceForOneHundredSeedsAllDistricts() throws {
+        for seed in UInt64(0)..<100 {
+            for district in 0..<4 {
+                let cache = try XCTUnwrap(Cache(seed: seed, district: district))
+                for beat in 0..<16 {
+                    for remaining in [-0.18, 0.0, 0.075, 0.5, 1.1, 1.6, 2.0] {
+                        let base = VeilRhythmVisualTimeline.notes(seed: seed, district: district,
+                                      nextBeat: beat, secondsToNextBeat: remaining, capacity: 5)
+                        XCTAssertEqual(cache.visible(nextBeat: beat, secondsToNextBeat: remaining, capacity: 5), base)
+                    }
+                }
+            }
+        }
+    }
+    func testInvalidCapacityBeatAndClockProduceEmpty() throws {
+        let c = try XCTUnwrap(Cache(seed: 1, district: 3))
+        for k in [0, 17, -1] { XCTAssertTrue(c.visible(nextBeat: 2, secondsToNextBeat: 1, capacity:k).isEmpty) }
+        XCTAssertTrue(c.visible(nextBeat: -1, secondsToNextBeat: 0).isEmpty)
+        XCTAssertTrue(c.visible(nextBeat: 16, secondsToNextBeat: 0).isEmpty)
+        XCTAssertTrue(c.visible(nextBeat: 0, secondsToNextBeat: .infinity).isEmpty)
+        XCTAssertTrue(c.visible(nextBeat: 0, secondsToNextBeat: .nan).isEmpty)
+    }
+    func testStableVisualsIndifferentToRenderRate() throws {
+        let c = try XCTUnwrap(Cache(seed: 100, district: 2))
+        XCTAssertEqual(c.visible(nextBeat: 1, secondsToNextBeat: 0.25),
+                       c.visible(nextBeat: 1, secondsToNextBeat: 0.25))
+    }
+    func testSnapshotFreshProgression() {
+        if case .fresh(let age) = Watch.check(now: 50.1, sampledAt: 50, running: true) {
+            XCTAssertEqual(age, 0.1, accuracy: 1e-10)
+        } else { XCTFail("expected fresh snapshot") }
+        XCTAssertEqual(Watch.check(now: 50, sampledAt: 50, running: true), .fresh(0))
+    }
+    func testExpiredRunningSnapshotHidden() {
+        XCTAssertEqual(Watch.check(now: 51, sampledAt: 50, running: true), .stale)
+        XCTAssertEqual(Watch.check(now: 51, sampledAt: 50, running: false), .fresh(0))
+    }
+    func testClockSkewPolicy() {
+        XCTAssertEqual(Watch.check(now: 10, sampledAt: 10.01, running: true), .fresh(0))
+        XCTAssertEqual(Watch.check(now: 10, sampledAt: 10.2, running: true), .invalid)
+    }
+    func testInvalidInputsFailClosed() {
+        for v in [Double.nan, .infinity, -.infinity, -1] {
+            XCTAssertEqual(Watch.check(now: v, sampledAt: 10, running: true), .invalid)
+            XCTAssertEqual(Watch.check(now: 10, sampledAt: v, running: true), .invalid)
+        }
+    }
+    func testFrameClockStallPolicyAtBoundary() {
+        if case .fresh(let age) = Watch.check(now: 12 + Watch.maximumRunningAge,
+                                                  sampledAt: 12, running: true) {
+            XCTAssertEqual(age, Watch.maximumRunningAge, accuracy: 1e-10)
+        } else { XCTFail("boundary snapshot must still be visible") }
+    }
+}
diff --git a/VeilLinkTests/VeilR7FrameStatsTests.swift b/VeilLinkTests/VeilR7FrameStatsTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/VeilR7FrameStatsTests.swift
@@ -0,0 +1,68 @@
+import XCTest
+#if canImport(VeilMegaEngines)
+@testable import VeilMegaEngines
+#elseif canImport(VeilLink)
+@testable import VeilLink
+#endif
+
+final class VeilR7FrameStatsTests: XCTestCase {
+    func testEmptyReportAndInitialSample() {
+        var s = VeilRenderFrameStats()
+        XCTAssertEqual(s.report.sampleCount, 0)
+        s.observe(1)
+        XCTAssertEqual(s.report.sampleCount, 0)
+    }
+    func testThirtyFpsCadence() {
+        var s = VeilRenderFrameStats()
+        for i in 0...60 { s.observe(Double(i) / 30) }
+        XCTAssertEqual(s.report.sampleCount, 60)
+        XCTAssertEqual(s.report.medianIntervalMs, 1000.0/30.0, accuracy:0.001)
+        XCTAssertEqual(s.report.slowFrames, 0)
+    }
+    func testLongPauseNotCountedAsDroppedFrame() {
+        var s = VeilRenderFrameStats()
+        s.observe(1); s.observe(1.02); s.observe(200); s.observe(200.02)
+        XCTAssertEqual(s.report.sampleCount, 2)
+        XCTAssertEqual(s.report.slowFrames, 0)
+    }
+    func testRejectNaNAndBackwardsWithoutInflatingStats() {
+        var s = VeilRenderFrameStats()
+        s.observe(5)
+        s.observe(.nan); s.observe(.infinity); s.observe(-3)
+        s.observe(4)
+        s.observe(4.02)
+        XCTAssertEqual(s.report.sampleCount, 1)
+    }
+    func testSlowFramesCountWithinRing() {
+        var s = VeilRenderFrameStats()
+        s.observe(0)
+        s.observe(0.05)
+        s.observe(0.11)
+        XCTAssertEqual(s.report.slowFrames, 2)
+        XCTAssertEqual(s.report.sampleCount, 2)
+    }
+    func testRingBufferHardCapAndRecentSlowCount() {
+        var s = VeilRenderFrameStats()
+        s.observe(0)
+        s.observe(0.07)
+        for i in 1...400 { s.observe(0.07 + Double(i)*0.02) }
+        XCTAssertEqual(s.report.sampleCount, 240)
+        XCTAssertEqual(s.report.slowFrames, 0)
+        XCTAssertLessThan(s.report.elapsedSeconds, 5)
+    }
+    func testResetClearsCounters() {
+        var s = VeilRenderFrameStats()
+        s.observe(1);s.observe(1.05);s.reset()
+        XCTAssertEqual(s.report.sampleCount, 0)
+        s.observe(999)
+        XCTAssertEqual(s.report.sampleCount, 0)
+    }
+    func testDeterminismUnderIdenticalTraces() {
+        var a = VeilRenderFrameStats(), b = VeilRenderFrameStats()
+        for i in 0..<270 {
+            let t = Double(i)/30.0 + (i%9==0 ? 0.003 : 0)
+            a.observe(t);b.observe(t)
+        }
+        XCTAssertEqual(a.report,b.report)
+    }
+}
