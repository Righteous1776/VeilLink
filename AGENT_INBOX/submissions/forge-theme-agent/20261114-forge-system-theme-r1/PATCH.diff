diff --git a/VeilLink/Core/VeilForgeMotionCore.swift b/VeilLink/Core/VeilForgeMotionCore.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Core/VeilForgeMotionCore.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/// Visual actuation is discrete and deterministic. State indicators are never
+/// fabricated throughput, search depth, message order, or other telemetry.
+enum VeilForgeMotionCore {
+    static let healthBarCount = 8
+
+    /// Stepper rotor makes 48 detents (7.5°) per four-second cycle at 12 Hz.
+    /// It parks instantly when the underlying subsystem is no longer working.
+    static func rotorAngle(atSeconds seconds: TimeInterval, working: Bool) -> Double {
+        guard working, seconds.isFinite else { return 0 }
+        let phase = max(0, seconds).truncatingRemainder(dividingBy: 4)
+        return floor(phase * 12) * 7.5
+    }
+
+    /// Routing carriage positions only reflect observed link counts:
+    /// 0 = disconnected, 1 = TCP present, 2 = secure peer present.
+    static func routeStage(connectedPeers: Int, securePeers: Int) -> Int {
+        if securePeers > 0 { return 2 }
+        if connectedPeers > 0 { return 1 }
+        return 0
+    }
+
+    /// Only actual BLE health scores may be fed to this gauge (0...100).
+    static func healthBars(_ score: Int) -> Int {
+        let clamped = min(100, max(0, score))
+        return (clamped * healthBarCount + 99) / 100
+    }
+}
diff --git a/VeilLink/UI/VeilForgeVisualSystem.swift b/VeilLink/UI/VeilForgeVisualSystem.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/UI/VeilForgeVisualSystem.swift
@@ -0,0 +1,549 @@
+import SwiftUI
+import Foundation
+
+/// Industrial atmosphere is static, bounded and input-transparent.
+struct VeilForgeBackground: View {
+    var body: some View {
+        ZStack {
+            LinearGradient(
+                colors: [VeilTheme.backgroundLift, VeilTheme.background, VeilTheme.obsidian],
+                startPoint: .topLeading,
+                endPoint: .bottomTrailing
+            )
+
+            VeilForgeGrid(spacing: 36)
+                .stroke(VeilTheme.hairline.opacity(0.35), lineWidth: 0.5)
+
+            VStack(spacing: 0) {
+                LinearGradient(
+                    colors: [VeilTheme.gold.opacity(0.70), Color.clear],
+                    startPoint: .leading,
+                    endPoint: .trailing
+                )
+                .frame(height: 1.5)
+                Spacer(minLength: 0)
+                Rectangle().fill(VeilTheme.hairline).frame(height: 1)
+            }
+        }
+        .ignoresSafeArea()
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+    }
+}
+
+private struct VeilForgeGrid: Shape {
+    let spacing: CGFloat
+
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        guard rect.width > 0, rect.height > 0, spacing > 0 else { return path }
+        for step in 0...Int(rect.width / spacing) {
+            let x = CGFloat(step) * spacing
+            path.move(to: CGPoint(x: x, y: 0))
+            path.addLine(to: CGPoint(x: x, y: rect.height))
+        }
+        for step in 0...Int(rect.height / spacing) {
+            let y = CGFloat(step) * spacing
+            path.move(to: CGPoint(x: 0, y: y))
+            path.addLine(to: CGPoint(x: rect.width, y: y))
+        }
+        return path
+    }
+}
+
+/// Consistent cut metal, engraved crossbars, orange datum mark.
+/// An underlay only: it must never absorb drag/keyboard/pairing gestures.
+struct VeilForgePlate: View {
+    let emphasized: Bool
+
+    var body: some View {
+        let shape = VeilPanelShape(cut: emphasized ? 20 : 14, radius: 2)
+        shape
+            .fill(
+                LinearGradient(
+                    colors: [VeilAppearanceController.shared.palette.metalTop.opacity(0.70),
+                             VeilTheme.panel,
+                             VeilAppearanceController.shared.palette.metalBottom.opacity(0.73)],
+                    startPoint: .topLeading,
+                    endPoint: .bottomTrailing
+                )
+            )
+            .overlay(shape.stroke(VeilTheme.gold.opacity(emphasized ? 0.55 : 0.24), lineWidth: 1))
