diff --git a/VeilLink/Storage/VeilStorageMaintenance.swift b/VeilLink/Storage/VeilStorageMaintenance.swift
new file mode 100644
index 0000000..9d20df2
--- /dev/null
+++ b/VeilLink/Storage/VeilStorageMaintenance.swift
@@ -0,0 +1,255 @@
+import Foundation
+
+enum VeilStorageCategory: String, CaseIterable, Hashable, Sendable {
+    case runtimeCache
+    case diagnostics
+    case staleTemporaryExports
+    case downloads
+    case backupExports
+    case protectedData
+
+    var title: String {
+        switch self {
+        case .runtimeCache: return "运行缓存"
+        case .diagnostics: return "诊断与黑匣子"
+        case .staleTemporaryExports: return "过期临时文件"
+        case .downloads: return "已下载内容"
+        case .backupExports: return "已导出的备份"
+        case .protectedData: return "受保护数据"
+        }
+    }
+
+    var isDeletable: Bool { self != .protectedData }
+    var isRecommended: Bool {
+        self == .runtimeCache || self == .diagnostics || self == .staleTemporaryExports
+    }
+}
+
+struct VeilStorageCategorySnapshot: Identifiable, Equatable, Sendable {
+    var id: VeilStorageCategory { category }
+    let category: VeilStorageCategory
+    let byteCount: Int64
+    let itemCount: Int
+    let detail: String
+}
+
+struct VeilStorageLargeItem: Identifiable, Equatable, Sendable {
+    let id: String
+    let displayName: String
+    let byteCount: Int64
+    let category: VeilStorageCategory
+}
+
+struct VeilStorageSnapshot: Equatable, Sendable {
+    let categories: [VeilStorageCategorySnapshot]
+    let largeItems: [VeilStorageLargeItem]
+    let scannedAt: Date
+
+    var reclaimableBytes: Int64 {
+        categories.filter { $0.category.isDeletable }.reduce(0) { $0 + $1.byteCount }
+    }
+}
+
+struct VeilStorageCleanupResult: Equatable, Sendable {
+    let removedBytes: Int64
+    let removedItems: Int
+    let failures: [String]
+}
+
+struct VeilStorageRoots: Sendable {
+    let appSupport: URL
+    let downloads: URL
+    let diagnostics: URL
+    let documents: URL
+    let temporary: URL
+
+    static func live(fileManager: FileManager = .default) -> VeilStorageRoots {
+        let support = (fileManager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+            ?? fileManager.temporaryDirectory).appendingPathComponent("VeilLink", isDirectory: true)
+        return VeilStorageRoots(
+            appSupport: support,
+            downloads: support.appendingPathComponent("Downloads", isDirectory: true),
+            diagnostics: support.appendingPathComponent("Diagnostics", isDirectory: true),
+            documents: fileManager.urls(for: .documentDirectory, in: .userDomainMask).first
+                ?? support.appendingPathComponent("Exports", isDirectory: true),
+            temporary: fileManager.temporaryDirectory
+        )
+    }
+}
+
+/// Scans and removes only allow-listed, reproducible storage. Chat attachments, SQLite files,
+/// identity material and Keychain state are never cleanup candidates.
+actor VeilStorageMaintenance {
+    static let staleTemporaryAge: TimeInterval = 24 * 60 * 60
+
+    private let roots: VeilStorageRoots
+    private let fileManager: FileManager
+    private let now: @Sendable () -> Date
+
+    init(
+        roots: VeilStorageRoots = .live(),
+        fileManager: FileManager = .default,
+        now: @escaping @Sendable () -> Date = Date.init
+    ) {
+        self.roots = roots
+        self.fileManager = fileManager
+        self.now = now
+    }
+
+    func scan() -> VeilStorageSnapshot {
+        let downloadItems = directChildren(of: roots.downloads)
+        let backupItems = directChildren(of: roots.documents).filter(isVeilLinkBackup)
+        let temporaryItems = directChildren(of: roots.temporary).filter(isStaleTemporaryArtifact)
+        let diagnosticItems = directChildren(of: roots.diagnostics)
+
+        let downloads = aggregate(downloadItems)
+        let backups = aggregate(backupItems)
+        let temporary = aggregate(temporaryItems)
+        let diagnostics = aggregate(diagnosticItems)
+        let protected = protectedUsage()
+        let urlCacheBytes = Int64(URLCache.shared.currentDiskUsage + URLCache.shared.currentMemoryUsage)
+
+        let categories = [
+            VeilStorageCategorySnapshot(category: .runtimeCache, byteCount: urlCacheBytes, itemCount: urlCacheBytes > 0 ? 1 : 0, detail: "网络响应与内存预览；会按需重建"),
+            VeilStorageCategorySnapshot(category: .diagnostics, byteCount: diagnostics.bytes, itemCount: diagnostics.count, detail: "运行日志、压力测试与黑匣子附件"),
+            VeilStorageCategorySnapshot(category: .staleTemporaryExports, byteCount: temporary.bytes, itemCount: temporary.count, detail: "超过 24 小时的 VeilLink 临时导出"),
+            VeilStorageCategorySnapshot(category: .downloads, byteCount: downloads.bytes, itemCount: downloads.count, detail: "专用下载区；删除后可能需要重新获取"),
+            VeilStorageCategorySnapshot(category: .backupExports, byteCount: backups.bytes, itemCount: backups.count, detail: "Documents 中的 VeilLink 加密 ZIP"),
+            VeilStorageCategorySnapshot(category: .protectedData, byteCount: protected.bytes, itemCount: protected.count, detail: "聊天、附件、数据库与身份状态；永不参与清理")
+        ]
+
+        let recoverable = downloadItems.map { ($0, VeilStorageCategory.downloads) }
+            + backupItems.map { ($0, VeilStorageCategory.backupExports) }
+            + temporaryItems.map { ($0, VeilStorageCategory.staleTemporaryExports) }
+        let largeItems = recoverable.compactMap { url, category -> VeilStorageLargeItem? in
+            let summary = aggregate([url])
+            guard summary.bytes > 0 else { return nil }
+            return VeilStorageLargeItem(
+                id: "\(category.rawValue):\(url.lastPathComponent)",
+                displayName: url.lastPathComponent,
+                byteCount: summary.bytes,
+                category: category
+            )
+        }
+        .sorted { $0.byteCount > $1.byteCount }
+        .prefix(8)
+
+        return VeilStorageSnapshot(categories: categories, largeItems: Array(largeItems), scannedAt: now())
+    }
+
+    func clean(_ categories: Set<VeilStorageCategory>) -> VeilStorageCleanupResult {
+        var candidates: [(URL, VeilStorageCategory)] = []
+        if categories.contains(.downloads) {
+            candidates += directChildren(of: roots.downloads).map { ($0, .downloads) }
+        }
+        if categories.contains(.backupExports) {
+            candidates += directChildren(of: roots.documents).filter(isVeilLinkBackup).map { ($0, .backupExports) }
+        }
+        if categories.contains(.staleTemporaryExports) {
+            candidates += directChildren(of: roots.temporary).filter(isStaleTemporaryArtifact).map { ($0, .staleTemporaryExports) }
+        }
+
+        var bytes: Int64 = 0
+        var removed = 0
+        var failures: [String] = []
+        for (url, category) in candidates {
+            guard isAllowed(url, for: category) else {
+                failures.append("拒绝越界项目：\(url.lastPathComponent)")
+                continue
+            }
+            let size = aggregate([url]).bytes
+            do {
+                try fileManager.removeItem(at: url)
+                bytes += size
+                removed += 1
+            } catch {
+                failures.append("\(url.lastPathComponent)：\(error.localizedDescription)")
+            }
+        }
+        if categories.contains(.runtimeCache) {
+            URLCache.shared.removeAllCachedResponses()
+        }
+        return VeilStorageCleanupResult(removedBytes: bytes, removedItems: removed, failures: failures)
+    }
+
+    private func directChildren(of root: URL) -> [URL] {
+        guard fileManager.fileExists(atPath: root.path) else { return [] }
+        return (try? fileManager.contentsOfDirectory(
+            at: root,
+            includingPropertiesForKeys: [.isDirectoryKey, .isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey, .contentModificationDateKey],
+            options: [.skipsHiddenFiles]
+        )) ?? []
+    }
+
+    private func aggregate(_ urls: [URL]) -> (bytes: Int64, count: Int) {
+        var bytes: Int64 = 0
+        var count = 0
+        for url in urls {
+            let values = try? url.resourceValues(forKeys: [.isRegularFileKey, .isDirectoryKey, .isSymbolicLinkKey, .fileSizeKey])
+            if values?.isSymbolicLink == true { continue }
+            if values?.isRegularFile == true {
+                bytes += Int64(values?.fileSize ?? 0)
+                count += 1
+                continue
+            }
+            guard values?.isDirectory == true,
+                  let enumerator = fileManager.enumerator(
+                    at: url,
+                    includingPropertiesForKeys: [.isRegularFileKey, .isDirectoryKey, .isSymbolicLinkKey, .fileSizeKey],
+                    options: [.skipsHiddenFiles, .skipsPackageDescendants]
+                  ) else { continue }
+            for case let child as URL in enumerator {
+                let childValues = try? child.resourceValues(forKeys: [.isRegularFileKey, .isDirectoryKey, .isSymbolicLinkKey, .fileSizeKey])
+                if childValues?.isSymbolicLink == true {
+                    if childValues?.isDirectory == true { enumerator.skipDescendants() }
+                    continue
+                }
+                if childValues?.isRegularFile == true {
+                    bytes += Int64(childValues?.fileSize ?? 0)
+                    count += 1
+                }
+            }
+        }
+        return (bytes, count)
+    }
+
+    private func protectedUsage() -> (bytes: Int64, count: Int) {
+        let excluded = [roots.downloads.standardizedFileURL, roots.diagnostics.standardizedFileURL]
+        let children = directChildren(of: roots.appSupport).filter { child in
+            !excluded.contains(child.standardizedFileURL)
+        }
+        return aggregate(children)
+    }
+
+    private func isVeilLinkBackup(_ url: URL) -> Bool {
+        let name = url.lastPathComponent
+        let values = try? url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
+        return values?.isRegularFile == true
+            && values?.isSymbolicLink != true
+            && name.hasPrefix("VeilLink-")
+            && name.lowercased().hasSuffix(".zip")
+    }
+
+    private func isStaleTemporaryArtifact(_ url: URL) -> Bool {
+        let name = url.lastPathComponent
+        let prefixes = ["VeilLink-DeepTelemetry-", "VeilLink-Export-", "VeilLink-Restore-", "VeilVoice-", "VeilLink-Image-"]
+        guard prefixes.contains(where: name.hasPrefix) else { return false }
+        let values = try? url.resourceValues(forKeys: [.contentModificationDateKey, .isSymbolicLinkKey])
+        guard values?.isSymbolicLink != true, let modified = values?.contentModificationDate else { return false }
+        return now().timeIntervalSince(modified) >= Self.staleTemporaryAge
+    }
+
+    private func isAllowed(_ url: URL, for category: VeilStorageCategory) -> Bool {
+        let parent = url.deletingLastPathComponent().standardizedFileURL
+        switch category {
+        case .downloads:
+            return parent == roots.downloads.standardizedFileURL
+        case .backupExports:
+            return parent == roots.documents.standardizedFileURL && isVeilLinkBackup(url)
+        case .staleTemporaryExports:
+            return parent == roots.temporary.standardizedFileURL && isStaleTemporaryArtifact(url)
+        default:
+            return false
+        }
+    }
+}
diff --git a/VeilLink/UI/StorageManagementView.swift b/VeilLink/UI/StorageManagementView.swift
new file mode 100644
index 0000000..bf93334
--- /dev/null
+++ b/VeilLink/UI/StorageManagementView.swift
@@ -0,0 +1,205 @@
+import SwiftUI
+
+struct StorageManagementView: View {
+    @ObservedObject var model: AppModel
+    @ObservedObject private var diagnostics = DiagnosticLogStore.shared
+    private let maintenance: VeilStorageMaintenance
+
+    @State private var snapshot: VeilStorageSnapshot?
+    @State private var selected = Set<VeilStorageCategory>()
+    @State private var isWorking = false
+    @State private var showsConfirmation = false
+    @State private var message: String?
+
+    init(model: AppModel, maintenance: VeilStorageMaintenance = VeilStorageMaintenance()) {
+        self.model = model
+        self.maintenance = maintenance
+    }
+
+    var body: some View {
+        VeilStableScrollView {
+            VStack(spacing: 16) {
+                summaryCard
+                categoriesCard
+                if let snapshot, !snapshot.largeItems.isEmpty { largeItemsCard(snapshot.largeItems) }
+                protectionCard
+            }
+        }
+        .background(VeilAmbientBackground())
+        .navigationTitle("存储管理")
+        .task { await refresh() }
+        .refreshable { await refresh() }
+        .alert("确认清理所选内容？", isPresented: $showsConfirmation) {
+            Button("取消", role: .cancel) {}
+            Button("清理", role: .destructive) { Task { await clean() } }
+        } message: {
+            Text(confirmationText)
+        }
+        .alert("存储管理", isPresented: Binding(get: { message != nil }, set: { if !$0 { message = nil } })) {
+            Button("好", role: .cancel) { message = nil }
+        } message: { Text(message ?? "") }
+    }
+
+    private var summaryCard: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Label("空间雷达", systemImage: "internaldrive")
+                    .font(VeilType.cardTitle).foregroundColor(VeilTheme.goldBright)
+                Spacer()
+                if isWorking { ProgressView().tint(VeilTheme.gold) }
+            }
+            Text(snapshot.map { bytes($0.reclaimableBytes) } ?? "正在扫描…")
+                .font(.system(size: 30, weight: .bold, design: .rounded))
+            Text("可检查的缓存、下载与导出占用。聊天和密钥不计入可清理空间。")
+                .font(.caption).foregroundColor(VeilTheme.secondaryText)
+            HStack {
+                Button("选择建议项") {
+                    selected = Set(VeilStorageCategory.allCases.filter(\.isRecommended))
+                }
+                .buttonStyle(VeilPressStyle())
+                Spacer()
+                Button("重新扫描") { Task { await refresh() } }
+                    .buttonStyle(VeilPressStyle())
+            }
+        }
+        .veilCard(emphasized: true)
+    }
+
+    private var categoriesCard: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            Text("分类清理").font(VeilType.cardTitle).foregroundColor(VeilTheme.goldBright).padding(.bottom, 8)
+            ForEach(displayCategories) { item in
+                Button {
+                    guard item.category.isDeletable else { return }
+                    if selected.contains(item.category) { selected.remove(item.category) }
+                    else { selected.insert(item.category) }
+                } label: {
+                    HStack(spacing: 12) {
+                        Image(systemName: selected.contains(item.category) ? "checkmark.circle.fill" : icon(for: item.category))
+                            .foregroundColor(item.category.isDeletable ? VeilTheme.gold : VeilTheme.success)
+                            .frame(width: 24)
+                        VStack(alignment: .leading, spacing: 3) {
+                            Text(item.category.title).fontWeight(.semibold).foregroundColor(VeilTheme.text)
+                            Text(item.detail).font(.caption2).foregroundColor(VeilTheme.secondaryText)
+                        }
+                        Spacer()
+                        VStack(alignment: .trailing, spacing: 2) {
+                            Text(bytes(item.byteCount)).font(.system(.caption, design: .monospaced).weight(.semibold))
+                            Text("\(item.itemCount) 项").font(.caption2).foregroundColor(VeilTheme.tertiaryText)
+                        }
+                    }
+                    .padding(.vertical, 10)
+                }
+                .buttonStyle(VeilPressStyle())
+                .disabled(!item.category.isDeletable || isWorking)
+                if item.id != displayCategories.last?.id { Divider().background(VeilTheme.hairline) }
+            }
+            Button(role: .destructive) { showsConfirmation = true } label: {
+                HStack {
+                    Image(systemName: "trash")
+                    Text("清理所选内容")
+                    Spacer()
+                    Text(bytes(selectedBytes)).font(.system(.caption, design: .monospaced))
+                }
+            }
+            .buttonStyle(VeilPressStyle())
+            .disabled(selected.isEmpty || isWorking)
+            .padding(.top, 12)
+        }
+        .veilCard()
+    }
+
+    private func largeItemsCard(_ items: [VeilStorageLargeItem]) -> some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Label("大文件雷达", systemImage: "scope")
+                .font(VeilType.cardTitle).foregroundColor(VeilTheme.goldBright)
+            ForEach(items) { item in
+                HStack {
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(item.displayName).lineLimit(1)
+                        Text(item.category.title).font(.caption2).foregroundColor(VeilTheme.secondaryText)
+                    }
+                    Spacer()
+                    Text(bytes(item.byteCount)).font(.system(.caption, design: .monospaced))
+                }
+            }
+        }
+        .veilCard()
+    }
+
+    private var protectionCard: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Label("删除边界", systemImage: "lock.shield.fill")
+                .font(VeilType.cardTitle).foregroundColor(VeilTheme.success)
+            Text("数据库、聊天正文、收发附件、身份私钥、会话密钥和正在传输的数据永不进入清理候选。删除备份与下载必须手动勾选；建议清理不会选择它们。")
+                .font(.caption).foregroundColor(VeilTheme.secondaryText)
+        }
+        .veilCard()
+    }
+
+    private var displayCategories: [VeilStorageCategorySnapshot] {
+        var values = snapshot?.categories ?? []
+        if let index = values.firstIndex(where: { $0.category == .diagnostics }) {
+            values[index] = VeilStorageCategorySnapshot(
+                category: .diagnostics,
+                byteCount: Int64(diagnostics.diskUsageBytes),
+                itemCount: diagnostics.exportedFileCount,
+                detail: values[index].detail
+            )
+        }
+        return values
+    }
+
+    private var selectedBytes: Int64 {
+        displayCategories.filter { selected.contains($0.category) }.reduce(0) { $0 + $1.byteCount }
+    }
+
+    private var confirmationText: String {
+        let names = displayCategories.filter { selected.contains($0.category) }.map { $0.category.title }
+        let warning = selected.contains(.backupExports) || selected.contains(.downloads)
+            ? "备份或下载删除后不能在 App 内撤销。"
+            : "这些内容均可重新生成。"
+        return "将清理：\(names.joined(separator: "、"))，预计 \(bytes(selectedBytes))。\(warning)"
+    }
+
+    @MainActor
+    private func refresh() async {
+        guard !isWorking else { return }
+        isWorking = true
+        diagnostics.refreshFromDisk()
+        snapshot = await maintenance.scan()
+        isWorking = false
+    }
+
+    @MainActor
+    private func clean() async {
+        guard !isWorking else { return }
+        isWorking = true
+        let requested = selected
+        if requested.contains(.runtimeCache) { model.clearUserRequestedCaches() }
+        if requested.contains(.diagnostics) { diagnostics.clear() }
+        let result = await maintenance.clean(requested)
+        selected.removeAll()
+        snapshot = await maintenance.scan()
+        isWorking = false
+        let removed = bytes(result.removedBytes)
+        message = result.failures.isEmpty
+            ? "已删除 \(result.removedItems) 项磁盘内容（\(removed)），并完成所选缓存清理。"
+            : "已删除 \(result.removedItems) 项；另有 \(result.failures.count) 项失败。请重新扫描后重试。"
+    }
+
+    private func bytes(_ value: Int64) -> String {
+        ByteCountFormatter.string(fromByteCount: value, countStyle: .file)
+    }
+
+    private func icon(for category: VeilStorageCategory) -> String {
+        switch category {
+        case .runtimeCache: return "bolt.horizontal.circle"
+        case .diagnostics: return "waveform.path.ecg"
+        case .staleTemporaryExports: return "clock.arrow.circlepath"
+        case .downloads: return "arrow.down.circle"
+        case .backupExports: return "archivebox"
+        case .protectedData: return "lock.shield.fill"
+        }
+    }
+}
diff --git a/VeilLinkTests/VeilStorageMaintenanceTests.swift b/VeilLinkTests/VeilStorageMaintenanceTests.swift
new file mode 100644
index 0000000..e3dedcf
--- /dev/null
+++ b/VeilLinkTests/VeilStorageMaintenanceTests.swift
@@ -0,0 +1,88 @@
+import XCTest
+@testable import VeilLink
+
+final class VeilStorageMaintenanceTests: XCTestCase {
+    private func roots() throws -> (URL, VeilStorageRoots) {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("VeilStorageTests-\(UUID().uuidString)", isDirectory: true)
+        let support = root.appendingPathComponent("Support/VeilLink", isDirectory: true)
+        let roots = VeilStorageRoots(
+            appSupport: support,
+            downloads: support.appendingPathComponent("Downloads", isDirectory: true),
+            diagnostics: support.appendingPathComponent("Diagnostics", isDirectory: true),
+            documents: root.appendingPathComponent("Documents", isDirectory: true),
+            temporary: root.appendingPathComponent("tmp", isDirectory: true)
+        )
+        for url in [support, roots.downloads, roots.diagnostics, roots.documents, roots.temporary] {
+            try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        }
+        return (root, roots)
+    }
+
+    func testScanSeparatesProtectedDataFromRecoverableData() async throws {
+        let (root, roots) = try roots(); defer { try? FileManager.default.removeItem(at: root) }
+        try Data(repeating: 1, count: 11).write(to: roots.appSupport.appendingPathComponent("veillink.sqlite"))
+        try Data(repeating: 2, count: 23).write(to: roots.downloads.appendingPathComponent("map.pack"))
+        let engine = VeilStorageMaintenance(roots: roots)
+
+        let snapshot = await engine.scan()
+        XCTAssertEqual(snapshot.categories.first(where: { $0.category == .protectedData })?.byteCount, 11)
+        XCTAssertEqual(snapshot.categories.first(where: { $0.category == .downloads })?.byteCount, 23)
+    }
+
+    func testCleanupNeverDeletesDatabaseOrAttachments() async throws {
+        let (root, roots) = try roots(); defer { try? FileManager.default.removeItem(at: root) }
+        let database = roots.appSupport.appendingPathComponent("veillink.sqlite")
+        let attachments = roots.appSupport.appendingPathComponent("Attachments", isDirectory: true)
+        try FileManager.default.createDirectory(at: attachments, withIntermediateDirectories: true)
+        try Data([1]).write(to: database)
+        try Data([2]).write(to: attachments.appendingPathComponent("ciphertext"))
+        try Data([3]).write(to: roots.downloads.appendingPathComponent("offline.pack"))
+
+        let result = await VeilStorageMaintenance(roots: roots).clean([.downloads, .protectedData])
+        XCTAssertEqual(result.removedItems, 1)
+        XCTAssertTrue(FileManager.default.fileExists(atPath: database.path))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: attachments.appendingPathComponent("ciphertext").path))
+    }
+
+    func testOnlyVeilLinkZipExportsAreCandidates() async throws {
+        let (root, roots) = try roots(); defer { try? FileManager.default.removeItem(at: root) }
+        let allowed = roots.documents.appendingPathComponent("VeilLink-20261023.zip")
+        let unrelated = roots.documents.appendingPathComponent("holiday.zip")
+        let lookalike = roots.documents.appendingPathComponent("VeilLink-not-a-zip.txt")
+        try Data(repeating: 1, count: 7).write(to: allowed)
+        try Data(repeating: 2, count: 8).write(to: unrelated)
+        try Data(repeating: 3, count: 9).write(to: lookalike)
+
+        _ = await VeilStorageMaintenance(roots: roots).clean([.backupExports])
+        XCTAssertFalse(FileManager.default.fileExists(atPath: allowed.path))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: unrelated.path))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: lookalike.path))
+    }
