diff --git a/VeilLink/Core/VeilLifecycleStabilityGate.swift b/VeilLink/Core/VeilLifecycleStabilityGate.swift
new file mode 100644
index 0000000..9efafb4
--- /dev/null
+++ b/VeilLink/Core/VeilLifecycleStabilityGate.swift
@@ -0,0 +1,103 @@
+import Foundation
+
+enum VeilLifecyclePhase: Equatable, Sendable {
+    case active
+    case inactive
+    case background
+}
+
+enum VeilLifecycleEvent: Equatable, Sendable {
+    case rootAppeared(VeilLifecyclePhase)
+    case sceneChanged(VeilLifecyclePhase)
+    case memoryWarning(uptime: TimeInterval)
+}
+
+enum VeilLifecycleAction: Equatable, Sendable {
+    case attachRuntime
+    case startRuntime
+    case setHostForeground(Bool)
+    case enterForeground
+    case prepareBackground
+    case enterBackground
+    case handleMemoryPressure
+}
+
+/// A pure state machine that turns noisy SwiftUI/UIKit lifecycle delivery into exactly-once work.
+/// It does not suppress real transitions: active -> inactive -> background -> active still emits
+/// every required action in order. It only removes duplicate notifications and warning bursts.
+struct VeilLifecycleStabilityGate: Sendable {
+    static let memoryWarningCooldown: TimeInterval = 2
+
+    private(set) var phase: VeilLifecyclePhase?
+    private(set) var runtimeAttached = false
+    private(set) var runtimeStarted = false
+    private(set) var backgroundPrepared = false
+    private var lastHandledMemoryWarningUptime: TimeInterval?
+
+    mutating func consume(_ event: VeilLifecycleEvent) -> [VeilLifecycleAction] {
+        switch event {
+        case .rootAppeared(let currentPhase):
+            var actions: [VeilLifecycleAction] = []
+            let firstStart = !runtimeStarted
+            if !runtimeAttached {
+                runtimeAttached = true
+                actions.append(.attachRuntime)
+            }
+            if !runtimeStarted {
+                runtimeStarted = true
+                actions.append(.startRuntime)
+            }
+            actions.append(contentsOf: transition(to: currentPhase, forceInitial: firstStart))
+            return actions
+
+        case .sceneChanged(let nextPhase):
+            guard runtimeAttached, runtimeStarted else {
+                phase = nextPhase
+                return []
+            }
+            return transition(to: nextPhase, forceInitial: false)
+
+        case .memoryWarning(let uptime):
+            guard runtimeAttached, runtimeStarted, uptime.isFinite, uptime >= 0 else { return [] }
+            if let last = lastHandledMemoryWarningUptime,
+               uptime >= last,
+               uptime - last < Self.memoryWarningCooldown {
+                return []
+            }
+            lastHandledMemoryWarningUptime = uptime
+            return [.handleMemoryPressure]
+        }
+    }
+
+    private mutating func transition(
+        to next: VeilLifecyclePhase,
+        forceInitial: Bool
+    ) -> [VeilLifecycleAction] {
+        guard forceInitial || phase != next else { return [] }
+        let previous = phase
+        phase = next
+
+        switch next {
+        case .active:
+            backgroundPrepared = false
+            return [.setHostForeground(true), .enterForeground]
+
+        case .inactive:
+            guard !backgroundPrepared else {
+                return previous == .active ? [.setHostForeground(false)] : []
+            }
+            backgroundPrepared = true
+            return [.setHostForeground(false), .prepareBackground]
+
+        case .background:
+            var actions: [VeilLifecycleAction] = []
+            if previous != .inactive { actions.append(.setHostForeground(false)) }
+            if !backgroundPrepared {
+                backgroundPrepared = true
+                actions.append(.prepareBackground)
+            }
+            actions.append(.enterBackground)
+            return actions
+        }
+    }
+}
diff --git a/VeilLink/App/VeilAppLifecycleCoordinator.swift b/VeilLink/App/VeilAppLifecycleCoordinator.swift
new file mode 100644
index 0000000..c98167c
--- /dev/null
+++ b/VeilLink/App/VeilAppLifecycleCoordinator.swift
@@ -0,0 +1,84 @@
+import SwiftUI
+import UIKit
+
+@MainActor
+final class VeilAppLifecycleCoordinator: ObservableObject {
+    private weak var model: AppModel?
+    private var gate = VeilLifecycleStabilityGate()
+
+    func rootAppeared(model: AppModel, scenePhase: ScenePhase) {
+        prepare(for: model)
+        execute(gate.consume(.rootAppeared(Self.phase(scenePhase))), model: model)
+    }
+
+    func sceneChanged(_ scenePhase: ScenePhase, model: AppModel) {
+        prepare(for: model)
+        let phase = Self.phase(scenePhase)
+        let actions = gate.consume(.sceneChanged(phase))
+        guard !actions.isEmpty else { return }
+        RuntimeDiagnosticsBridge.shared.recordLifecycle("scene.\(Self.label(phase))")
+        execute(actions, model: model)
+    }
+
+    func memoryWarning(model: AppModel, uptime: TimeInterval = ProcessInfo.processInfo.systemUptime) {
+        prepare(for: model)
+        let actions = gate.consume(.memoryWarning(uptime: uptime))
+        guard !actions.isEmpty else { return }
+        RuntimeDiagnosticsBridge.shared.recordMemoryPressure()
+        DeviceStressTestController.shared.noteMemoryWarning()
+        execute(actions, model: model)
+    }
+
+    private func prepare(for model: AppModel) {
+        guard self.model !== model else { return }
+        self.model = model
+        gate = VeilLifecycleStabilityGate()
+    }
+
+    private func execute(_ actions: [VeilLifecycleAction], model: AppModel) {
+        for action in actions {
+            switch action {
+            case .attachRuntime:
+                RuntimeDiagnosticsBridge.shared.attach(to: model)
+                DeviceStressTestController.shared.attach(model: model)
+                RuntimeDiagnosticsBridge.shared.recordLifecycle("root.appear")
+                VeilBackgroundContinuityCenter.shared.attach(to: model)
+            case .startRuntime:
+                model.start()
+            case .setHostForeground(let active):
+                DeviceStressTestController.shared.handleSceneActive(active)
+                model.bluetooth.setForegroundActive(active)
+            case .enterForeground:
+                model.handleForegroundTransition()
+                VeilBackgroundContinuityCenter.shared.becameActive(model: model)
+            case .prepareBackground:
+                VeilBackgroundContinuityCenter.shared.prepareForBackgroundTransition(model: model)
+            case .enterBackground:
+                VeilBackgroundContinuityCenter.shared.enteredBackground(model: model)
+                model.handleBackgroundTransition()
+                model.appLock.lock()
+                model.ownerMode.lock()
+            case .handleMemoryPressure:
+                VeilBackgroundContinuityCenter.shared.handleMemoryPressure()
+                model.handleMemoryPressure()
+            }
+        }
+    }
+
+    private static func phase(_ phase: ScenePhase) -> VeilLifecyclePhase {
+        switch phase {
+        case .active: return .active
+        case .inactive: return .inactive
+        case .background: return .background
+        @unknown default: return .inactive
+        }
+    }
+
+    private static func label(_ phase: VeilLifecyclePhase) -> String {
+        switch phase {
+        case .active: return "active"
+        case .inactive: return "inactive"
+        case .background: return "background"
+        }
+    }
+}
diff --git a/VeilLinkTests/VeilLifecycleStabilityGateTests.swift b/VeilLinkTests/VeilLifecycleStabilityGateTests.swift
