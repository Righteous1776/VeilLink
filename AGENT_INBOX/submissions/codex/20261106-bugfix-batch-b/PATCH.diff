@@ -16,3 +16,20 @@ enum MediaTransferPolicy {
         supportedImageMIMETypes.contains(mimeType.lowercased())
     }
 }
+
+enum ImagePayloadPolicy {
+    /// A BLE image should complete in a bounded interval on the measured 20–40 KB/s link.
+    /// Keep this below the Wire v4 maximum without changing that protocol-level contract.
+    static let bluetoothMaxBytes = 800 * 1_024
+    static let fastTransportMaxBytes = MediaTransferPolicy.maximumImageBytes
+
+    static func maximumBytes(for transport: VeilSessionTransportKind?) -> Int {
+        switch transport {
+        case .lan, .internet:
+            return fastTransportMaxBytes
+        case .ble, .none:
+            // A queued image can later be delivered over BLE, so unknown routes fail closed.
+            return bluetoothMaxBytes
+        }
+    }
+}
