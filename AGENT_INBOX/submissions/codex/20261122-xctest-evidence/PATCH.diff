+    def test_partially_skipped_run_reports_root_counts(self):
+        result = self.inspect(
+            "Test Suite 'All tests' passed at 12:00\n"
+            "\t Executed 3 tests, with 2 tests skipped and 0 failures (0 unexpected) in 1 second\n"
