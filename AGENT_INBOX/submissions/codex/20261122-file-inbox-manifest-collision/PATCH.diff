+    func testManifestNameVariantsPreserveImportedBytesAfterStagingCleanup() throws {
+        for name in ["record.json", "ReCoRd.JsOn", " record.json "] {
+            let original = root.appendingPathComponent(name)
+            let payload = Data(#"{"message":"keep me"}"#.utf8)
+            try payload.write(to: original)
+            let staged = try VeilImportedFileAccess.materialize(original)
+            defer { VeilImportedFileAccess.removeStagedCopy(staged) }
+            let record = try VeilFileInbox.importStaged(staged, root: inboxRoot)
+            VeilImportedFileAccess.removeStagedCopy(staged)
+
+            XCTAssertEqual(record.displayName, name)
+            XCTAssertNotEqual(record.storedName.lowercased(), "record.json")
+            XCTAssertEqual(try VeilFileInbox.list(root: inboxRoot), [record])
+            let saved = try VeilFileInbox.fileURL(for: record, root: inboxRoot)
+            XCTAssertEqual(try Data(contentsOf: saved), payload)
+            XCTAssertTrue(try VeilFileInbox.verify(record, root: inboxRoot))
+            try VeilFileInbox.remove(record, root: inboxRoot)
