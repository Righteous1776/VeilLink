diff --git a/VeilLink/Core/ConversationWorkspace.swift b/VeilLink/Core/ConversationWorkspace.swift
new file mode 100644
index 0000000..19ab8d7
--- /dev/null
+++ b/VeilLink/Core/ConversationWorkspace.swift
@@ -0,0 +1,197 @@
+import Foundation
+
+enum ConversationWorkspaceKind: String, CaseIterable, Hashable, Sendable {
+    case action
+    case question
+    case link
+    case attachment
+
+    var title: String {
+        switch self {
+        case .action: return "行动项"
+        case .question: return "待回答"
+        case .link: return "链接"
+        case .attachment: return "附件"
+        }
+    }
+
+    var systemImage: String {
+        switch self {
+        case .action: return "checklist"
+        case .question: return "questionmark.bubble"
+        case .link: return "link"
+        case .attachment: return "paperclip"
+        }
+    }
+}
+
+struct ConversationWorkspaceItem: Identifiable, Equatable, Sendable {
+    let id: String
+    let messageID: String
+    let kind: ConversationWorkspaceKind
+    let title: String
+    let preview: String
+    let sentAt: Date
+    let isOutgoing: Bool
+    let value: String?
+}
+
+struct ConversationWorkspaceSnapshot: Equatable, Sendable {
+    let messageCount: Int
+    let outgoingCount: Int
+    let incomingCount: Int
+    let attachmentCount: Int
+    let activeDayCount: Int
+    let firstMessageAt: Date?
+    let lastMessageAt: Date?
+    let items: [ConversationWorkspaceItem]
+
+    func count(for kind: ConversationWorkspaceKind) -> Int {
+        items.lazy.filter { $0.kind == kind }.count
+    }
+}
+
+enum ConversationWorkspaceEngine {
+    private static let actionPrefixes = [
+        "todo", "to-do", "待办", "记得", "别忘", "请", "需要", "安排", "跟进", "截止", "deadline", "[ ]", "☐"
+    ]
+    private static let questionPrefixes = [
+        "请问", "是否", "怎么", "怎样", "为什么", "为何", "谁", "哪里", "什么时候", "能不能", "可不可以", "可以吗"
+    ]
+    private static let linkExpression = try? NSRegularExpression(
+        pattern: #"https?://[^\s<>\[\]{}\"'，。；：！？、）)]+"#,
+        options: [.caseInsensitive]
+    )
+
+    static func analyze(_ messages: [ChatMessage], calendar: Calendar = .current) -> ConversationWorkspaceSnapshot {
+        let userMessages = messages
+            .filter(isUserFacing)
+            .sorted { lhs, rhs in
+                if lhs.sentAt == rhs.sentAt { return lhs.id < rhs.id }
+                return lhs.sentAt < rhs.sentAt
+            }
+        var items: [ConversationWorkspaceItem] = []
+        var activeDays = Set<Date>()
+        var attachmentCount = 0
+
+        for message in userMessages {
+            activeDays.insert(calendar.startOfDay(for: message.sentAt))
+            if let attachment = message.attachment {
+                attachmentCount += 1
+                let label = attachmentLabel(attachment)
+                items.append(ConversationWorkspaceItem(
+                    id: "\(message.id):attachment",
+                    messageID: message.id,
+                    kind: .attachment,
+                    title: label,
+                    preview: "\(ByteCountFormatter.string(fromByteCount: Int64(attachment.byteCount), countStyle: .file)) · \(message.isOutgoing ? "已发送" : "已接收")",
+                    sentAt: message.sentAt,
+                    isOutgoing: message.isOutgoing,
+                    value: attachment.id
+                ))
+            }
+
+            guard let text = userFacingText(message), !text.isEmpty else { continue }
+            let preview = bounded(text)
+            if isAction(text) {
+                items.append(ConversationWorkspaceItem(
+                    id: "\(message.id):action", messageID: message.id, kind: .action,
+                    title: "行动项", preview: preview, sentAt: message.sentAt,
+                    isOutgoing: message.isOutgoing, value: nil
+                ))
+            }
+            if isQuestion(text) {
+                items.append(ConversationWorkspaceItem(
+                    id: "\(message.id):question", messageID: message.id, kind: .question,
+                    title: "问题", preview: preview, sentAt: message.sentAt,
+                    isOutgoing: message.isOutgoing, value: nil
+                ))
+            }
+            for (index, link) in links(in: text).enumerated() {
+                items.append(ConversationWorkspaceItem(
+                    id: "\(message.id):link:\(index)", messageID: message.id, kind: .link,
+                    title: link, preview: preview, sentAt: message.sentAt,
+                    isOutgoing: message.isOutgoing, value: link
+                ))
+            }
+        }
+
+        items.sort {
+            if $0.sentAt == $1.sentAt { return $0.id < $1.id }
+            return $0.sentAt > $1.sentAt
+        }
+        return ConversationWorkspaceSnapshot(
+            messageCount: userMessages.count,
+            outgoingCount: userMessages.lazy.filter(\.isOutgoing).count,
+            incomingCount: userMessages.lazy.filter { !$0.isOutgoing }.count,
+            attachmentCount: attachmentCount,
+            activeDayCount: activeDays.count,
+            firstMessageAt: userMessages.first?.sentAt,
+            lastMessageAt: userMessages.last?.sentAt,
+            items: items
+        )
+    }
+
+    static func filteredItems(
+        in snapshot: ConversationWorkspaceSnapshot,
+        kind: ConversationWorkspaceKind?,
+        query: String
+    ) -> [ConversationWorkspaceItem] {
+        let needle = query.trimmingCharacters(in: .whitespacesAndNewlines)
+        return snapshot.items.filter { item in
+            guard kind == nil || item.kind == kind else { return false }
+            guard !needle.isEmpty else { return true }
+            return item.title.localizedCaseInsensitiveContains(needle)
+                || item.preview.localizedCaseInsensitiveContains(needle)
+                || item.value?.localizedCaseInsensitiveContains(needle) == true
+        }
+    }
+
+    private static func isUserFacing(_ message: ChatMessage) -> Bool {
+        MiniGameCodec.decode(message.body) == nil && TacticalV2.WireCodecV2.decode(message.body) == nil
+    }
+
+    private static func userFacingText(_ message: ChatMessage) -> String? {
+        if message.attachment != nil || message.body == "[图片]" || VoiceMessageCodec.decode(message.body) != nil { return nil }
+        let raw = ReplyTextCodec.decode(message.body)?.reply ?? message.body
+        let normalized = raw
+            .replacingOccurrences(of: "\r", with: "\n")
+            .split(whereSeparator: { $0.isWhitespace })
+            .joined(separator: " ")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        return normalized.isEmpty ? nil : normalized
+    }
+
+    private static func isAction(_ text: String) -> Bool {
+        let lowered = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        if lowered.hasPrefix("请问") { return false }
+        return actionPrefixes.contains { lowered.hasPrefix($0) }
+    }
+
+    private static func isQuestion(_ text: String) -> Bool {
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.contains("?") || trimmed.contains("？") { return true }
+        return questionPrefixes.contains { trimmed.hasPrefix($0) }
+    }
+
+    private static func links(in text: String) -> [String] {
+        guard let linkExpression else { return [] }
+        let range = NSRange(text.startIndex..<text.endIndex, in: text)
+        return linkExpression.matches(in: text, range: range).compactMap { match in
+            guard let swiftRange = Range(match.range, in: text) else { return nil }
+            return String(text[swiftRange]).trimmingCharacters(in: CharacterSet(charactersIn: ".,;:!?，。；：！？、)）"))
+        }
+    }
+
+    private static func attachmentLabel(_ attachment: ChatAttachment) -> String {
+        if VoiceMessageCodec.isVoiceMIMEType(attachment.mimeType) { return "语音消息" }
+        if MediaTransferPolicy.supportsImageMIMEType(attachment.mimeType) { return "图片" }
+        return "附件"
+    }
+
+    private static func bounded(_ text: String, limit: Int = 220) -> String {
+        guard text.count > limit else { return text }
+        let end = text.index(text.startIndex, offsetBy: limit)
+        return String(text[..<end]) + "…"
+    }
+}
diff --git a/VeilLink/Core/VeilMessageForge.swift b/VeilLink/Core/VeilMessageForge.swift
new file mode 100644
index 0000000..b796f1a
--- /dev/null
+++ b/VeilLink/Core/VeilMessageForge.swift
@@ -0,0 +1,168 @@
+import Foundation
+
+enum VeilMessageForgeStyle: String, CaseIterable, Identifiable, Hashable, Sendable {
+    case original
+    case compact
+    case bullets
+    case politeRequest
+
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .original: return "原文"
+        case .compact: return "紧凑"
+        case .bullets: return "要点"
+        case .politeRequest: return "礼貌请求"
+        }
+    }
+}
+
+enum VeilMessageForgeTemplate: String, CaseIterable, Identifiable, Sendable {
+    case status
+    case request
+    case meeting
+    case checklist
+    case incident
+
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .status: return "进展同步"
+        case .request: return "明确请求"
+        case .meeting: return "会议约定"
+        case .checklist: return "待办清单"
+        case .incident: return "问题报告"
+        }
+    }
+
+    var text: String {
+        switch self {
+        case .status: return "进展：\n- 已完成：\n- 进行中：\n- 下一步：\n- 阻塞："
+        case .request: return "你好，我需要你协助：\n\n目标：\n期望结果：\n截止时间：\n补充信息：\n\n谢谢。"
+        case .meeting: return "主题：\n建议时间：\n预计时长：\n需要准备：\n确认方式："
+        case .checklist: return "待办：\n☐ \n☐ \n☐ "
+        case .incident: return "问题：\n影响：\n复现步骤：\n1. \n2. \n当前状态：\n需要协助："
+        }
+    }
+}
+
+enum VeilMessageSafetySeverity: Int, Comparable, Sendable {
+    case notice = 0
+    case warning = 1
+    case critical = 2
+    static func < (lhs: Self, rhs: Self) -> Bool { lhs.rawValue < rhs.rawValue }
+}
+
+struct VeilMessageSafetyFinding: Identifiable, Equatable, Sendable {
+    enum Kind: String, Hashable, Sendable {
+        case privateKey
+        case accessToken
+        case passwordAssignment
+        case emailAddress
+        case phoneNumber
+    }
+
+    var id: String { kind.rawValue }
+    let kind: Kind
+    let severity: VeilMessageSafetySeverity
+    let title: String
+    let guidance: String
+}
+
+struct VeilMessageForgeAnalysis: Equatable, Sendable {
+    let characters: Int
+    let utf8Bytes: Int
+    let lines: Int
+    let segments: [String]
+    let findings: [VeilMessageSafetyFinding]
+    let withinSingleMessageLimit: Bool
+}
+
+enum VeilMessageForge {
+    static let maximumMessageBytes = 16_384
+
+    static func render(_ source: String, style: VeilMessageForgeStyle) -> String {
+        let normalized = source.replacingOccurrences(of: "\r\n", with: "\n")
+            .replacingOccurrences(of: "\r", with: "\n")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !normalized.isEmpty else { return "" }
+        switch style {
+        case .original:
+            return normalized
+        case .compact:
+            return normalized
+                .split(separator: "\n", omittingEmptySubsequences: false)
+                .map { $0.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ") }
+                .reduce(into: [String]()) { lines, line in
+                    if !line.isEmpty || lines.last?.isEmpty == false { lines.append(line) }
+                }
+                .joined(separator: "\n")
+        case .bullets:
+            let lines = normalized.split(separator: "\n").flatMap { line in
+                line.split(whereSeparator: { ".。;；".contains($0) })
+            }
+            return lines.map { "• " + $0.trimmingCharacters(in: .whitespacesAndNewlines) }
+                .filter { $0 != "• " }.joined(separator: "\n")
+        case .politeRequest:
+            let hasGreeting = normalized.hasPrefix("你好") || normalized.hasPrefix("您好")
+            let hasThanks = normalized.hasSuffix("谢谢") || normalized.hasSuffix("谢谢。")
+            return (hasGreeting ? "" : "你好，\n") + normalized + (hasThanks ? "" : "\n谢谢。")
+        }
+    }
+
+    static func analyze(_ text: String, maximumBytes: Int = maximumMessageBytes) -> VeilMessageForgeAnalysis {
+        let segments = split(text, maximumBytes: maximumBytes)
+        return VeilMessageForgeAnalysis(
+            characters: text.count,
+            utf8Bytes: text.utf8.count,
+            lines: text.isEmpty ? 0 : text.split(separator: "\n", omittingEmptySubsequences: false).count,
+            segments: segments,
+            findings: safetyFindings(in: text),
+            withinSingleMessageLimit: !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+                && text.utf8.count <= maximumBytes
+        )
+    }
+
+    static func split(_ text: String, maximumBytes: Int = maximumMessageBytes) -> [String] {
+        guard maximumBytes > 0 else { return [] }
+        let normalized = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !normalized.isEmpty else { return [] }
+        var segments: [String] = []
+        var current = ""
+
+        func flush() {
+            let value = current.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !value.isEmpty { segments.append(value) }
+            current = ""
+        }
+
+        for character in normalized {
+            let candidate = current + String(character)
+            if candidate.utf8.count > maximumBytes {
+                flush()
+                current = String(character)
+                if current.utf8.count > maximumBytes { flush() }
+            } else {
+                current = candidate
+            }
+        }
+        flush()
+        return segments
+    }
+
+    static func safetyFindings(in text: String) -> [VeilMessageSafetyFinding] {
+        let patterns: [(VeilMessageSafetyFinding.Kind, VeilMessageSafetySeverity, String, String, String)] = [
+            (.privateKey, .critical, #"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\b(?:seed phrase|助记词)\b"#, "可能包含私钥或助记词", "不要通过聊天发送密钥材料；请删除后再发送。"),
+            (.accessToken, .critical, #"\b(?:Bearer\s+[A-Za-z0-9._~+/=-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b"#, "可能包含访问令牌", "撤销已暴露令牌，并从消息中移除。"),
+            (.passwordAssignment, .warning, #"(?i)\b(?:password|passwd|pwd|密码)\s*[:=：]\s*\S{4,}"#, "可能包含密码", "确认对方和场景可信；建议改用专门的秘密传递方式。"),
+            (.emailAddress, .notice, #"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b"#, "包含邮箱地址", "发送前确认是否需要暴露个人联系方式。"),
+            (.phoneNumber, .notice, #"(?<!\d)(?:\+?\d[\d -]{8,}\d)(?!\d)"#, "可能包含电话号码", "发送前确认是否需要暴露个人联系方式。")
+        ]
+        return patterns.compactMap { kind, severity, pattern, title, guidance in
+            guard let regex = try? NSRegularExpression(pattern: pattern, options: [.caseInsensitive]),
+                  regex.firstMatch(in: text, range: NSRange(text.startIndex..<text.endIndex, in: text)) != nil else { return nil }
+            return VeilMessageSafetyFinding(kind: kind, severity: severity, title: title, guidance: guidance)
+        }
+        .sorted { $0.severity > $1.severity }
+    }
+}
