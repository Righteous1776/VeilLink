+    func testBoardSideChoiceStartsComputerWhenPlayerSelectsSecondColour() async throws {
+        let controller = LocalAIGameController(game: .gomoku)
+        controller.setBoardHumanPlayer(.guest)
+        XCTAssertEqual(controller.humanPlayer, .guest)
+        XCTAssertEqual(controller.aiPlayer, .host)
+        XCTAssertTrue(controller.isAIThinking)
+        let deadline = Date().addingTimeInterval(8)
+        while controller.isAIThinking && Date() < deadline {
+            try await Task.sleep(nanoseconds: 40_000_000)
+        }
+        XCTAssertEqual(controller.gomoku.currentPlayer, .guest)
+        XCTAssertEqual((0..<225).filter { controller.gomoku.value(at: $0) == 1 }.count, 1)
+        XCTAssertTrue(controller.canHumanAct)
+    }

