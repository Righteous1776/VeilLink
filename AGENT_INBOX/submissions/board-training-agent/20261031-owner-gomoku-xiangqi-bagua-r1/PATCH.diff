+    /// Non-destructive, idempotent Owner-reviewed training addition.
+    /// Never replace an existing local repertoire or a database requiring recovery.
+    /// Existing positions/actions are authoritative; source statistics only fill
+    /// missing gaps, while distinct game records add sequence evidence.
+    func mergeReviewedPackage(from url: URL) throws -> AdaptiveBoardLearningImportReport {
+        guard !requiresRecovery else { throw AdaptiveBoardLearningPackageError.invalidContent }
+        let accessed = url.startAccessingSecurityScopedResource()
+        defer { if accessed { url.stopAccessingSecurityScopedResource() } }
+        guard let data = try? Data(contentsOf: url) else {
+            throw AdaptiveBoardLearningPackageError.unreadable
+        }
+        guard let envelope = try? JSONDecoder().decode(ExportEnvelope.self, from: data),
+              envelope.format == "veillink.board-learning.export.v1",
+              envelope.checksumAlgorithm == "fnv1a64-canonical-json",
+              envelope.payload.schema == 1 else {
+            throw AdaptiveBoardLearningPackageError.unsupportedFormat
+        }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard let encoded = try? encoder.encode(envelope.payload),
+              Self.checksum(encoded) == envelope.payloadChecksum else {
+            throw AdaptiveBoardLearningPackageError.checksumMismatch
+        }
+        guard Self.isValid(envelope.payload) else {
+            throw AdaptiveBoardLearningPackageError.invalidContent
+        }
+        let incoming = Self.filtered(envelope.payload, for: scopedGame)
+        guard !incoming.positions.isEmpty || !incoming.recentGames.isEmpty else {
+            throw AdaptiveBoardLearningPackageError.invalidContent
+        }
+
+        var merged = database
+        var changed = false
+        for (position, source) in incoming.positions {
+            if var retained = merged.positions[position] {
+                guard retained.actor == source.actor else {
+                    throw AdaptiveBoardLearningPackageError.invalidContent
+                }
+                for (action, statistic) in source.actions where retained.actions[action] == nil {
+                    retained.actions[action] = statistic
+                    changed = true
+                }
+                if changed { merged.positions[position] = retained }
+            } else {
+                merged.positions[position] = source
+                changed = true
+            }
+        }
+        func signature(_ record: GameRecord) -> String {
+            record.game.rawValue + "#" + record.result.rawValue + "#"
+            + String(record.finishedAt.timeIntervalSinceReferenceDate) + "#"
+            + record.actions.joined(separator: "|")
+        }
+        var known = Set(merged.recentGames.map(signature))
+        for record in incoming.recentGames {
+            if known.insert(signature(record)).inserted {
+                merged.recentGames.append(record)
+                if record.result != .unfinished { merged.completedGames += 1 }
+                changed = true
+            }
+        }
+        if !changed {
+            return AdaptiveBoardLearningImportReport(
+                completedGames: database.completedGames,
+                rememberedPositions: database.positions.count
+            )
+        }
+        merged.sequence = max(merged.sequence, incoming.sequence) + 1
+        guard Self.isValid(merged) else {
+            throw AdaptiveBoardLearningPackageError.invalidContent
+        }
+
+        let previous = database
+        database = merged
+        save()
+        guard lastSaveSucceeded else {
+            database = previous
             throw AdaptiveBoardLearningPackageError.writeFailed
         }
         return AdaptiveBoardLearningImportReport(
