+  let trimmed = term.trimmingCharacters(in: .whitespacesAndNewlines)
+  return entries.filter { entry in
+   let categoryMatch = chapter == nil || chapter == entry.chapter
+   guard categoryMatch else { return false }
+   guard !trimmed.isEmpty else { return true }
+   let haystack = ([entry.title, entry.subtitle, entry.evidence] + entry.paragraphs).joined(separator: " ")
+   return haystack.localizedCaseInsensitiveContains(trimmed)
+  }
+ }
+ public static func currentProfile(_ financialVersion: Int?) -> String {
+  switch financialVersion {
+  case 5?: return "当前对局：V5 实验性城市金融规则"
+  case 4?: return "当前对局：V4 有限银行资金池；勿套用 V5 金额"
+  case 3?: return "当前对局：V3 长局；勿套用 V5 金额"
+  default: return "当前对局：经典／较早金融规则；请以本局状态结算"
+  }
+ }
+}
diff --git a/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyEngine/VeilopolyFinancialStability.swift b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyEngine/VeilopolyFinancialStability.swift
new file mode 100644
index 0000000000000000000000000000000000000000..aa0585e0a2241898eda8e0b88e257018b24ce71d
--- /dev/null
+++ b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyEngine/VeilopolyFinancialStability.swift
@@ -0,0 +1,100 @@
+import Foundation
+
+/// An honest V5 risk display: bank cash is not the same as spendable capital.
+/// No stored derived values, randomness or new settlement protocol.
+public enum VeilopolyRiskLevel: String, Codable {
+ case stable, guarded, stressed, crisis
+}
+
+public struct VeilopolyLiquidityReport: Equatable {
+ public let level: VeilopolyRiskLevel
+ public let totalSupply: Int
+ public let treasuryCash: Int
+ public let circulatingCash: Int
+ public let queuedClaims: Int
+ public let depositObligations: Int
+ public let investmentObligations: Int
+ public let stockRedemptionExposure: Int
+ public let loanPrincipalOutstanding: Int
+ public let overdueLoanCount: Int
+ public let protectedReserve: Int
+ public let safeNewCredit: Int
+
+ /// Conservative contingent bank payout estimate, NOT existing currency.
+ public var futureObligations: Int {
+  queuedClaims + depositObligations + investmentObligations + stockRedemptionExposure
+ }
+ public var coverageBasisPoints: Int {
+  let needs = futureObligations
+  return needs == 0 ? 10_000 : min(100_000, treasuryCash * 10_000 / needs)
+ }
+}
+
+public enum VeilopolyFinancialStability {
+ public static func inspect(_ game: GameState) -> VeilopolyLiquidityReport? {
+  guard game.banking?.financeRuleVersion == VeilopolyCityLongEconomy.version,
+        let ledger = game.banking, let cash = ledger.reserveCash,
+        let supply = VeilopolyCityLongEconomy.supplyCeiling(game),
+        (0...supply).contains(cash),
+        cash + VeilopolyCityLongEconomy.circulatingCash(game) == supply else { return nil }
+
+  let playersCash = VeilopolyCityLongEconomy.circulatingCash(game)
+  let pending = (ledger.queuedClaims ?? []).reduce(0) { $0 + $1.amount }
+  var deposits = 0, investments = 0, loanPrincipal = 0, overdue = 0
+  for account in ledger.accounts {
+   for savings in account.savings {
+    deposits += savings.principal + savings.principal * savings.payoutBasisPoints / 10_000
+   }
+   for position in account.positions {
+    let topRate = ledger.terms.payouts[position.feature]?.max() ?? 10_000
+    investments += position.principal * topRate / 10_000
+   }
+   for loan in account.loans {
+    loanPrincipal += loan.principal
+    if loan.duePeriod <= ledger.completedTurns { overdue += 1 }
+   }
+  }
+  let stockNotional: Int
+  if let market = ledger.market {
+   stockNotional = market.portfolios.reduce(0) { total, holdings in
+    total + holdings.positions.reduce(0) { subtotal, item in
+     let quote = market.quotes.first { $0.symbol == item.symbol }
+     return subtotal + (quote.map { $0.currentPriceCents * item.shares / 100 } ?? 0)
+    }
+   }
+  } else { stockNotional = 0 }
+
+  let liabilities = pending + deposits + investments + stockNotional
+  // A protected reserve is calculated from contingent bank payouts plus a
+  // nominal operating buffer. It constrains ONLY NEW optional credit.
+  let reserve = min(supply * 4 / 5, max(supply * 12 / 100,
+                                          liabilities + supply / 20))
+  let available = max(0, cash - reserve)
+  let aggregateCreditCap = max(0, supply / 4 - loanPrincipal)
+  // Even a cash-rich bank must halt expansion if all known exit claims
+  // already exceed its available treasury. Never lend into insolvency.
+  let credit = pending == 0 && overdue == 0 &&
+               cash >= liabilities && cash >= reserve
+    ? min(available, aggregateCreditCap) : 0
+  let level: VeilopolyRiskLevel
+  if cash < pending || cash < liabilities / 2 || cash < supply / 20 {
+   level = .crisis
+  } else if cash < liabilities || cash < supply / 8 || overdue > 0 {
+   level = .stressed
+  } else if cash < reserve || pending > 0 {
+   level = .guarded
+  } else { level = .stable }
+
+  return .init(level: level, totalSupply: supply, treasuryCash: cash,
+               circulatingCash: playersCash, queuedClaims: pending,
+               depositObligations: deposits, investmentObligations: investments,
+               stockRedemptionExposure: stockNotional,
+               loanPrincipalOutstanding: loanPrincipal, overdueLoanCount: overdue,
+               protectedReserve: reserve, safeNewCredit: credit)
+ }
+
+ public static func mayIssueCredit(_ g: GameState, amount: Int) -> Bool {
+  guard let report = inspect(g) else { return true }
+  return amount > 0 && amount <= report.safeNewCredit
+ }
+}
diff --git a/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/ControlFragments.swift b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/ControlFragments.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a3a7503ccb6e50737369a7bbd95a4fd0d456aeb4
--- /dev/null
+++ b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/ControlFragments.swift
@@ -0,0 +1,80 @@
+import Foundation
+
+/// App-layer segmentation, NOT Wire v4 framing. A 384-byte slice leaves room
+/// for JSON/base64 wrappers under the existing BLE control-event 2048-byte cap.
+public struct VeilopolyControlFragment: Codable, Equatable {
+ public let roomID: String
+ public let transferID: String
+ public let index: Int
+ public let count: Int
+ public let bytes: Data
+ public init(roomID: String, transferID: String, index: Int, count: Int, bytes: Data) {
+  self.roomID=roomID; self.transferID=transferID; self.index=index; self.count=count; self.bytes=bytes
+ }
+ public var isValid: Bool {
+  UUID(uuidString: roomID)?.uuidString == roomID && UUID(uuidString: transferID)?.uuidString == transferID &&
+  (1...VeilopolyControlCodec.maximumFragments).contains(count) && (0..<count).contains(index) &&
+  !bytes.isEmpty && bytes.count <= VeilopolyControlCodec.fragmentBytes
+ }
+}
+public enum VeilopolyControlCodec {
+ public static let topic = "veilopoly.room.v1"
+ public static let fragmentBytes = 384
+ public static let maximumMessageBytes = 2 * 1024 * 1024
+ public static let maximumFragments = (maximumMessageBytes + fragmentBytes - 1) / fragmentBytes
+ public static func fragments(_ packet: VeilopolyRoomPacket, transferID: String = UUID().uuidString) throws -> [VeilopolyControlFragment] {
+  guard packet.isValid, UUID(uuidString: transferID)?.uuidString == transferID else { throw VeilopolyRoomError.invalidPacket }
+  let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+  let data = try encoder.encode(packet)
+  guard !data.isEmpty, data.count <= maximumMessageBytes else { throw VeilopolyRoomError.invalidPacket }
+  let count = (data.count + fragmentBytes - 1) / fragmentBytes
+  return (0..<count).map { index in
+   let start = index * fragmentBytes
+   return VeilopolyControlFragment(roomID: packet.roomID, transferID: transferID,
+    index: index, count: count, bytes: data.subdata(in: start..<min(data.count, start + fragmentBytes)))
+  }
+ }
+}
+/// At most four in-flight bounded transfers, allowing retransmission/interleaved
+/// packets. Stalled transfers expire after 300s; peer identities partition keys.
+public struct VeilopolyControlAssembler {
+ private struct Transfer {
+  let roomID: String; let id: String; let count: Int; let began: TimeInterval
+  var slices: [Int: Data] = [:]
+ }
+ private var pending: [String: Transfer] = [:]
+ private var completed: [String] = []
+ public init() {}
+ public mutating func ingest(_ fragment: VeilopolyControlFragment, from peer: String,
+                             now: TimeInterval) throws -> VeilopolyRoomPacket? {
+  guard !peer.isEmpty, peer.utf8.count <= 128, now.isFinite, fragment.isValid else {
+   throw VeilopolyRoomError.invalidPacket
+  }
+  pending = pending.filter { now - $0.value.began <= 300 && now >= $0.value.began }
+  let key = peer + "/" + fragment.roomID + "/" + fragment.transferID
+  if completed.contains(key) { return nil }
+  if pending[key] == nil {
+   guard pending.count < 4 else { throw VeilopolyRoomError.invalidPacket }
+   pending[key] = Transfer(roomID: fragment.roomID, id: fragment.transferID, count: fragment.count, began: now)
+  }
+  guard var transfer = pending[key], transfer.roomID == fragment.roomID,
+        transfer.count == fragment.count else { throw VeilopolyRoomError.invalidPacket }
+  if let old = transfer.slices[fragment.index], old != fragment.bytes {
+   pending.removeValue(forKey: key); throw VeilopolyRoomError.invalidPacket
+  }
+  transfer.slices[fragment.index] = fragment.bytes
+  pending[key] = transfer
+  guard transfer.slices.count == transfer.count else { return nil }
+  pending.removeValue(forKey: key)
+  var data = Data()
+  for index in 0..<transfer.count {
+   guard let slice = transfer.slices[index] else { throw VeilopolyRoomError.invalidPacket }
+   data.append(slice)
+  }
+  guard data.count <= VeilopolyControlCodec.maximumMessageBytes else { throw VeilopolyRoomError.invalidPacket }
+  let packet = try JSONDecoder().decode(VeilopolyRoomPacket.self, from: data)
+  guard packet.isValid, packet.roomID == fragment.roomID else { throw VeilopolyRoomError.invalidPacket }
+  completed.append(key); completed = Array(completed.suffix(64))
+  return packet
+ }
+}
diff --git a/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/LiveRoom.swift b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/LiveRoom.swift
new file mode 100644
index 0000000000000000000000000000000000000000..72f4de8612c12e5fff9859b374a65a8d3ed2d219
--- /dev/null
+++ b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/LiveRoom.swift
@@ -0,0 +1,232 @@
+import Foundation
+import VeilopolyEngine
+
+/// First live topology: authenticated host + one guest, with two existing AI
+/// seats. This is not a claim of four-device support or host migration.
+public struct VeilopolyRoomConfiguration: Codable, Equatable {
+ public let roomID: String
+ public let seed: UInt64
+ public let hostIdentityID: String
+ public let guestIdentityID: String
+ /// Absent in existing room indexes/invites: preserve their classic rules.
+ public let rulesVersion: Int?
+ public var effectiveRulesVersion: Int { rulesVersion ?? 1 }
+ public var rulesTitle: String { effectiveRulesVersion == 5 ? "城市经济 V5" : "经典旧局" }
+ public init(roomID: String, seed: UInt64, hostIdentityID: String, guestIdentityID: String,
+             rulesVersion: Int? = nil) {
+  self.roomID = roomID; self.seed = seed
+  self.hostIdentityID = hostIdentityID; self.guestIdentityID = guestIdentityID
+  self.rulesVersion = rulesVersion
+ }
+ /// Product entry for NEW rooms. Never infer/migrate an existing room's rules.
+ public static func current(roomID: String, seed: UInt64, hostIdentityID: String,
+                            guestIdentityID: String) -> Self {
+  Self(roomID: roomID, seed: seed, hostIdentityID: hostIdentityID,
+       guestIdentityID: guestIdentityID, rulesVersion: VeilopolyCityLongEconomy.version)
+ }
+ public func initialGame() -> GameState {
+  effectiveRulesVersion == VeilopolyCityLongEconomy.version
+   ? VeilopolyCityLongEconomy.make(seed: seed, humanCount: 2)
+   : GameFactory.make(seed: seed, humanCount: 2)
+ }
+ public var isValid: Bool {
+  UUID(uuidString: roomID)?.uuidString == roomID &&
+  !hostIdentityID.isEmpty && !guestIdentityID.isEmpty &&
+  hostIdentityID.utf8.count <= 128 && guestIdentityID.utf8.count <= 128 &&
+  hostIdentityID != guestIdentityID && [1, VeilopolyCityLongEconomy.version].contains(effectiveRulesVersion)
+ }
+ public func seat(for identity: String) -> Int? {
+  identity == hostIdentityID ? 0 : (identity == guestIdentityID ? 1 : nil)
+ }
+}
+
+public enum VeilopolyRoomPacketKind: String, Codable {
+ case invite, accept, decline, proposal, commit, resync, snapshot, status, leave
+}
+public struct VeilopolyRoomPacket: Codable {
+ public let version: Int
+ public let roomID: String
+ public let kind: VeilopolyRoomPacketKind
+ public let configuration: VeilopolyRoomConfiguration?
+ public let proposal: Move?
+ public let committed: AuthoritativeMove?
+ public let snapshot: GameSnapshot?
+ public let nextSeq: Int?
+ public let stateHash: String?
+ public init(roomID: String, kind: VeilopolyRoomPacketKind,
+             configuration: VeilopolyRoomConfiguration? = nil, proposal: Move? = nil,
+             committed: AuthoritativeMove? = nil, snapshot: GameSnapshot? = nil,
+             nextSeq: Int? = nil, stateHash: String? = nil) {
+  // Only the new-profile INVITE uses application-packet v2. Old apps reject
+  // it instead of accepting and silently starting a classic game. Control
+  // fragments, encrypted VeilControlEvent and Wire v4 are unchanged.
+  version = kind == .invite && configuration?.effectiveRulesVersion == 5 ? 2 : 1
+  self.roomID = roomID; self.kind = kind; self.configuration = configuration
+  self.proposal = proposal; self.committed = committed; self.snapshot = snapshot
+  self.nextSeq = nextSeq; self.stateHash = stateHash
+ }
+ public var isValid: Bool {
+  guard (version == 1 || (version == 2 && kind == .invite)),
+        UUID(uuidString: roomID)?.uuidString == roomID else { return false }
+  let fields = [configuration != nil, proposal != nil, committed != nil, snapshot != nil,
+                nextSeq != nil, stateHash != nil]
+  switch kind {
+  case .invite: return fields == [true,false,false,false,false,false] &&
+    configuration?.isValid == true && configuration?.roomID == roomID &&
+    ((version == 1 && configuration?.effectiveRulesVersion == 1) ||
+     (version == 2 && configuration?.effectiveRulesVersion == 5))
+  case .proposal: return fields == [false,true,false,false,false,false]
+  case .commit: return fields == [false,false,true,false,false,false]
+  case .snapshot: return fields == [false,false,false,true,false,false]
+  case .resync: return fields == [false,false,false,false,true,false] && (nextSeq ?? -1) >= 0
+  case .status: return fields == [false,false,false,false,true,true] &&
+    (nextSeq ?? -1) >= 0 && stateHash?.utf8.count == 16
+  case .accept, .decline, .leave: return fields.allSatisfy { !$0 }
+  }
+ }
+}
+
+public enum VeilopolyRoomError: Error, Equatable {
+ case invalidConfiguration, wrongPeer, wrongRoom, wrongRole, invalidPacket, invalidSnapshot
+ case sequenceGap, hashMismatch, staleSnapshot, invalidProposal
+}
+
+/// Sole logical authority in a live session. UI mirrors committed states only.
+/// Caller supplies sender identity from the existing authenticated E2EE channel,
+/// NEVER from a JSON field. No transport/security/database dependency here.
+public struct VeilopolyLiveRoom {
+ public let configuration: VeilopolyRoomConfiguration
+ public let localIdentityID: String
+ public private(set) var game: GameState
+ public var isHost: Bool { localIdentityID == configuration.hostIdentityID }
+ public var localSeat: Int { isHost ? 0 : 1 }
+ public var peerIdentityID: String { isHost ? configuration.guestIdentityID : configuration.hostIdentityID }
+ public init(configuration: VeilopolyRoomConfiguration, localIdentityID: String,
+             restoredGame: GameState? = nil) throws {
+  guard configuration.isValid, configuration.seat(for: localIdentityID) != nil
+   else { throw VeilopolyRoomError.invalidConfiguration }
+  self.configuration = configuration; self.localIdentityID = localIdentityID
+  let initial = restoredGame ?? configuration.initialGame()
+  guard Self.validSnapshotState(initial, configuration: configuration) else {
+   throw VeilopolyRoomError.invalidSnapshot
+  }
+  game = initial
+ }
+ public func validate(_ packet: VeilopolyRoomPacket, from sender: String) throws {
+  guard sender == peerIdentityID else { throw VeilopolyRoomError.wrongPeer }
+  guard packet.roomID == configuration.roomID else { throw VeilopolyRoomError.wrongRoom }
+  guard packet.isValid else { throw VeilopolyRoomError.invalidPacket }
+ }
+ public func validateProposal(_ move: Move, from sender: String) throws {
+  guard isHost else { throw VeilopolyRoomError.wrongRole }
+  guard sender == configuration.guestIdentityID, move.player == 1 else { throw VeilopolyRoomError.wrongPeer }
+  guard ![MoveKind.applyMovement, .resolveTile, .stockTick].contains(move.type) else {
+   throw VeilopolyRoomError.invalidProposal
+  }
+  guard move.seq == game.nextSeq else { throw VeilopolyRoomError.sequenceGap }
+  let actor = game.auction?.turn ?? game.trade?.to ?? game.pendingDebt?.player ?? game.turn.player
+  guard actor == 1, VeilopolyEngine.context(game).allowedMoves.contains(move.type) else {
+   throw VeilopolyRoomError.invalidProposal
+  }
+ }
+ public mutating func commitOnHost(_ move: Move) -> VeilopolyEngine.Transition {
+  guard isHost else { return .failure(.notYourTurn) }
+  let result = VeilopolyEngine.apply(game, VeilopolyEngine.context(game), move)
+  if case .success((let next, _)) = result { game = next }
+  return result
+ }
+ public mutating func acceptCommit(_ committed: AuthoritativeMove, from sender: String) throws -> (GameState, [Effect]) {
+  guard !isHost else { throw VeilopolyRoomError.wrongRole }
+  guard sender == configuration.hostIdentityID else { throw VeilopolyRoomError.wrongPeer }
+  guard committed.seq == game.nextSeq, committed.move.seq == committed.seq else {
+   throw VeilopolyRoomError.sequenceGap
+  }
+  guard case .success((let next, let effects)) =
+    VeilopolyEngine.apply(game, VeilopolyEngine.context(game), committed.move) else {
+   throw VeilopolyRoomError.invalidProposal
+  }
+  guard StateDigest.hash(next) == committed.stateHash else { throw VeilopolyRoomError.hashMismatch }
+  game = next
+  return (next, effects)
+ }
+ public mutating func acceptSnapshot(_ snapshot: GameSnapshot, from sender: String) throws {
+  guard !isHost else { throw VeilopolyRoomError.wrongRole }
+  guard sender == configuration.hostIdentityID else { throw VeilopolyRoomError.wrongPeer }
+  guard snapshot.game.nextSeq >= game.nextSeq else { throw VeilopolyRoomError.staleSnapshot }
+  guard snapshot.game.moveLog.prefix(game.nextSeq).elementsEqual(game.moveLog) else {
+   throw VeilopolyRoomError.invalidSnapshot // A higher sequence must not replace a different committed history.
+  }
+  guard Self.validSnapshotState(snapshot.game, configuration: configuration),
+        snapshot.lastAppliedSeq == snapshot.game.nextSeq - 1,
+        StateDigest.hash(snapshot.game) == snapshot.stateHash else { throw VeilopolyRoomError.invalidSnapshot }
+  game = snapshot.game
+ }
+ public static func validSnapshotState(_ g: GameState, configuration: VeilopolyRoomConfiguration) -> Bool {
+  guard g.seed == configuration.seed, g.players.count == 4, g.board.count == 40,
+        g.nextSeq >= 0, g.moveLog.count == g.nextSeq,
+        g.moveLog.enumerated().allSatisfy({ $0.offset == $0.element.seq }),
+        g.players.enumerated().allSatisfy({ i, p in
+         p.id == i && (0..<40).contains(p.position) && (0...1_000_000_000).contains(p.cash) &&
+         (0...16).contains(p.chanceJailCards) && (0...16).contains(p.chestJailCards) &&
+         p.jailTurns >= 0 && p.jailTurns < Int.max - 16 &&
+         p.kind == (i < 2 ? .human : .ai)
+        }), g.board.enumerated().allSatisfy({ i, t in
+         t.i == i && (0...1_000_000).contains(t.price) && (0...1_000_000).contains(t.houseCost) &&
+         (0...4).contains(t.houses) && (t.owner.map { (0..<4).contains($0) } ?? true) &&
+         (t.kind != .street || t.rent.count == 6) && t.rent.allSatisfy({ (0...1_000_000).contains($0) })
+        }), (0..<4).contains(g.turn.player), (0...12).contains(g.turn.pendingSteps),
+        g.turn.rollCount >= 0 && g.turn.rollCount < Int.max - 16 &&
+        g.turn.doubleCount >= 0 && g.turn.doubleCount < Int.max - 16,
+        (g.turn.lastRoll.isEmpty || (g.turn.lastRoll.count == 2 && g.turn.lastRoll.allSatisfy({ (1...6).contains($0) }))),
+        (g.turn.pendingPurchase.map { (0..<40).contains($0) } ?? true),
+        (0...32).contains(g.bank.houses), (0...12).contains(g.bank.hotels),
+        (g.banking.map { IntegratedBanking.validate($0) } ?? true) else { return false }
+  let canonical = configuration.initialGame()
+  guard g.cards == canonical.cards,
+        zip(g.board, canonical.board).allSatisfy({ tile, original in
+         tile.kind == original.kind && tile.name == original.name && tile.color == original.color &&
+         tile.price == original.price && tile.rent == original.rent && tile.houseCost == original.houseCost
+        }) else { return false }
+  if configuration.effectiveRulesVersion == 5 {
+   guard let ledger = g.banking, let expected = canonical.banking,
+         ledger.financeRuleVersion == 5, ledger.terms == expected.terms,
+         ledger.market?.algorithmVersion == expected.market?.algorithmVersion,
+         let reserve = ledger.reserveCash,
+         reserve + g.players.reduce(0, { $0 + $1.cash }) == VeilopolyCityLongEconomy.expandedTotalMoneySupply
+    else { return false }
+  } else {
+   guard g.banking.map({ $0.terms == FinanceSandboxPolicy() &&
+         (1...2).contains($0.financeRuleVersion) && $0.reserveCash == nil }) ?? true
+    else { return false }
+  } // Both profiles reject peer-injected paytables and silent rule downgrades.
+  for (deck, original) in [(g.chanceDeck, canonical.chanceDeck), (g.chestDeck, canonical.chestDeck)] {
+   guard !deck.order.isEmpty, deck.cursor >= 0, deck.cursor < Int.max - 16,
+         Set(deck.order).count == deck.order.count,
+         deck.order.allSatisfy({ original.order.contains($0) }) else { return false }
+  }
+  if let a = g.auction {
+   guard (0..<40).contains(a.tile), !a.active.isEmpty, a.active.count <= 4,
+         Set(a.active).count == a.active.count, a.active.allSatisfy({ (0..<4).contains($0) }),
+         a.active.contains(a.turn), (a.bidder.map { (0..<4).contains($0) } ?? true),
+         (0...1_000_000_000).contains(a.currentBid) else { return false }
+  }
+  if let t = g.trade {
+   guard (0..<4).contains(t.from), (0..<4).contains(t.to), t.from != t.to,
+         [t.offer, t.request].allSatisfy({ transfer in
+          (0...1_000_000_000).contains(transfer.cash) && transfer.tiles.allSatisfy({ (0..<40).contains($0) }) &&
+          (0...16).contains(transfer.chanceCards) && (0...16).contains(transfer.chestCards)
+         }) else { return false }
+  }
+  if let d = g.pendingDebt {
+   guard (0..<4).contains(d.player), (d.creditor.map { (0..<4).contains($0) } ?? true),
+         (0...1_000_000_000).contains(d.amount) else { return false }
+  }
+  if g.turn.phase == .auction && g.auction == nil { return false }
+  if g.turn.phase == .trade && g.trade == nil { return false }
+  if g.turn.phase == .debt && g.pendingDebt == nil { return false }
+  if let winner = g.winner {
+   guard (0..<4).contains(winner), g.turn.phase == .finished, !g.players[winner].bankrupt else { return false }
+  }
+  return true
+ }
+}
diff --git a/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/RoomLinkPolicy.swift b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/RoomLinkPolicy.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9d0206f124f4508c53dafbae77bd3cc5b5667b30
--- /dev/null
+++ b/VEILOPOLY_DEV/Veilopoly/Sources/VeilopolyNet/RoomLinkPolicy.swift
@@ -0,0 +1,10 @@
+/// Game liveness is NOT transport/cryptographic liveness. Missing game
+/// heartbeats must never tear down a healthy shared E2EE chat session.
+public enum VeilopolyRoomLinkPolicy {
+ public static func shouldPauseGame(secureSessionReady: Bool, secondsSincePeer: Double) -> Bool {
+  !secureSessionReady || !secondsSincePeer.isFinite || secondsSincePeer > 15
+ }
+ public static func shouldRequestSecureRecovery(secureSessionReady: Bool, userInitiated: Bool) -> Bool {
+  userInitiated && !secureSessionReady
+ }
+}
