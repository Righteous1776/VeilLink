diff --git a/VEILOPOLY_DEV/Veilopoly/Tests/VeilopolyUITests/LiveGameSessionTests.swift b/VEILOPOLY_DEV/Veilopoly/Tests/VeilopolyUITests/LiveGameSessionTests.swift
