+name: iOS CI
+
+on:
+  push:
+    branches: [main]
+    paths-ignore:
+      - 'AGENT_INBOX/**'
+  pull_request:
+    paths-ignore:
+      - 'AGENT_INBOX/**'
+  workflow_dispatch:
+  workflow_call:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ios-ci-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.run_id }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  build-and-test:
+    runs-on: macos-15
+    timeout-minutes: 50
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Prepare evidence directory
+        run: |
+          mkdir -p ci-artifacts
+          {
+            echo "HEAD=$(git rev-parse HEAD)"
+            xcodebuild -version
+            sw_vers
+            echo "RUNNER_ARCH=${RUNNER_ARCH:-unknown}"
+            df -h .
+          } 2>&1 | tee ci-artifacts/environment.log
+
+      - name: Static standard preflight
+        run: |
+          set -o pipefail
+          python3 scripts/ci-standard-preflight.py 2>&1 | tee ci-artifacts/static-preflight.log
+
+      - name: Install XcodeGen
+        run: brew install xcodegen 2>&1 | tee ci-artifacts/install-xcodegen.log
+
+      - name: Record XcodeGen version
+        run: xcodegen --version | tee ci-artifacts/xcodegen-version.log
+
+      - name: Generate Xcode project
+        run: |
+          set -o pipefail
+          xcodegen generate 2>&1 | tee ci-artifacts/xcodegen.log
+          cp VeilLink.xcodeproj/project.pbxproj ci-artifacts/project.pbxproj
+
+      - name: Build for iOS Simulator
+        run: |
+          set -o pipefail
+          rm -rf ci-artifacts/BuildResults.xcresult
+          set +e
+          xcodebuild             -project VeilLink.xcodeproj             -scheme VeilLink             -configuration Debug             -sdk iphonesimulator             -destination 'generic/platform=iOS Simulator'             -resultBundlePath ci-artifacts/BuildResults.xcresult             CODE_SIGNING_ALLOWED=NO             build 2>&1 | tee ci-artifacts/ios-simulator-build.log
+          build_status=${PIPESTATUS[0]}
+          set -e
+          if [ "$build_status" -ne 0 ]; then
+            python3 - <<'PY'
+          from pathlib import Path
+          log = Path("ci-artifacts/ios-simulator-build.log").read_text(encoding="utf-8", errors="replace")
+          failures = [line.strip() for line in log.splitlines() if " error:" in line or "fatal error:" in line]
+          for line in failures[-80:]:
+              escaped = line.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
+              print(f"::error title=Xcode build::{escaped}")
+          PY
+            exit "$build_status"
+          fi
+
+      - name: Run unit and UI smoke tests
+        run: |
+          set -o pipefail
+          rm -rf TestResults.xcresult
+          bash scripts/ci-test.sh 2>&1 | tee ci-artifacts/unit-tests.log
+          python3 scripts/ci-collect-evidence.py \
+            --workflow "iOS CI" \
+            --status success \
+            --artifact-dir ci-artifacts \
+            --output ci-artifacts/CI_TEST_EVIDENCE.json \
+            --require-tests-passed
+
+      - name: Compile Release for iPhoneOS (no IPA, no signing)
+        run: |
+          set -o pipefail
+          xcodebuild \
+            -project VeilLink.xcodeproj \
+            -scheme VeilLink \
+            -configuration Release \
+            -sdk iphoneos \
+            -destination 'generic/platform=iOS' \
+            CODE_SIGNING_ALLOWED=NO \
+            build 2>&1 | tee ci-artifacts/ios-device-release-build.log
+
+      - name: Collect CI evidence
+        if: always()
+        env:
+          JOB_STATUS: ${{ job.status }}
+        run: |
+          if [ -d TestResults.xcresult ]; then
+            ditto TestResults.xcresult ci-artifacts/TestResults.xcresult
+          fi
+          python3 scripts/ci-collect-evidence.py             --workflow "iOS CI"             --phase "standard-preflight"             --status "$JOB_STATUS"             --artifact-dir ci-artifacts             --output ci-artifacts/CI_EVIDENCE.json
+
+      - name: Upload CI evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: VeilLink-iOS-CI-Evidence-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ci-artifacts
+          if-no-files-found: error
+          retention-days: 14
