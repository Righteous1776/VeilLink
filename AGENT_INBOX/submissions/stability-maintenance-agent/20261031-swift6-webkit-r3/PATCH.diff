+        emitter.particleAlpha = 0.86
+        emitter.particleAlphaSpeed = -1.5
+        emitter.particleScale = scale
+        emitter.particleScaleRange = scale * 0.45
+        emitter.particleScaleSpeed = -0.12
+        emitter.particleBlendMode = .add
