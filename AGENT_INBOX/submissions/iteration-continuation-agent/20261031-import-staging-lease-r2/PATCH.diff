diff --git a/VeilLink/Core/VeilImportStagingLeasePolicy.swift b/VeilLink/Core/VeilImportStagingLeasePolicy.swift
new file mode 100644
--- /dev/null
+++ b/VeilLink/Core/VeilImportStagingLeasePolicy.swift
@@ -0,0 +1,87 @@
+import Foundation
+
+/// Strict ownership and crash-recovery policy for Files-provider import snapshots.
+/// This policy never reads or mutates the source provider URL.
+enum VeilImportStagingLeasePolicy {
+    static let folderName = "VeilLink-Import-Staging"
+    static let defaultLifetime: TimeInterval = 24 * 60 * 60
+
+    struct SweepReport: Equatable {
+        let removed: Int
+        let retained: Int
+        let failed: Int
+    }
+
+    static func stagingRoot(temporaryDirectory: URL = FileManager.default.temporaryDirectory) -> URL {
+        temporaryDirectory.appendingPathComponent(folderName, isDirectory: true)
+    }
+
+    /// Only a direct file in a single UUID lease directory is eligible.
+    static func owns(_ stagedFile: URL, root: URL = stagingRoot(), fileManager: FileManager = .default) -> Bool {
+        guard stagedFile.isFileURL, root.isFileURL else { return false }
+        let item = stagedFile.standardizedFileURL
+        let lease = item.deletingLastPathComponent()
+        let anchor = root.standardizedFileURL
+        guard lease.deletingLastPathComponent() == anchor,
+              UUID(uuidString: lease.lastPathComponent) != nil,
+              item.lastPathComponent != ".", item.lastPathComponent != "..",
+              isActualDirectory(lease, fileManager: fileManager),
+              isActualDirectory(anchor, fileManager: fileManager) else { return false }
+        return true
+    }
+
+    /// Never delete arbitrary user paths that merely contain the folder name.
+    @discardableResult
+    static func removeOwnedCopy(_ stagedFile: URL, root: URL = stagingRoot(), fileManager: FileManager = .default) throws -> Bool {
+        guard owns(stagedFile, root: root, fileManager: fileManager) else { return false }
+        try fileManager.removeItem(at: stagedFile.standardizedFileURL.deletingLastPathComponent())
+        return true
+    }
+
+    /// Recover interrupted imports at a future launch/foreground.
+    /// Symlink directories and entries without reliable timestamps are retained.
+    static func sweepExpired(
+        root: URL = stagingRoot(),
+        now: Date = Date(),
+        lifetime: TimeInterval = defaultLifetime,
+        maxRemovals: Int = 64,
+        fileManager: FileManager = .default
+    ) throws -> SweepReport {
+        guard lifetime > 0, maxRemovals > 0 else { return SweepReport(removed: 0, retained: 0, failed: 0) }
+        guard fileManager.fileExists(atPath: root.path) else { return SweepReport(removed: 0, retained: 0, failed: 0) }
+        guard isActualDirectory(root.standardizedFileURL, fileManager: fileManager) else {
+            return SweepReport(removed: 0, retained: 0, failed: 1)
+        }
+        let entries = try fileManager.contentsOfDirectory(
+            at: root,
+            includingPropertiesForKeys: [.isDirectoryKey, .isSymbolicLinkKey, .creationDateKey, .contentModificationDateKey],
+            options: []
+        ).sorted { $0.lastPathComponent < $1.lastPathComponent }
+        var removed = 0
+        var retained = 0
+        var failed = 0
+        for entry in entries {
+            guard UUID(uuidString: entry.lastPathComponent) != nil,
+                  entry.standardizedFileURL.deletingLastPathComponent() == root.standardizedFileURL,
+                  isActualDirectory(entry, fileManager: fileManager) else {
+                retained += 1
+                continue
+            }
+            let values = try? entry.resourceValues(forKeys: [.creationDateKey, .contentModificationDateKey])
+            guard let created = values?.creationDate else { retained += 1; continue }
+            let newest = max(created, values?.contentModificationDate ?? created)
+            guard newest <= now.addingTimeInterval(-lifetime), removed < maxRemovals else {
+                retained += 1
+                continue
+            }
+            do { try fileManager.removeItem(at: entry); removed += 1 }
+            catch { failed += 1 }
+        }
+        return SweepReport(removed: removed, retained: retained, failed: failed)
+    }
+
+    private static func isActualDirectory(_ url: URL, fileManager: FileManager) -> Bool {
+        guard let values = try? url.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey]) else { return false }
+        return values.isDirectory == true && values.isSymbolicLink != true
+    }
+}
diff --git a/VeilLinkTests/VeilImportStagingLeasePolicyTests.swift b/VeilLinkTests/VeilImportStagingLeasePolicyTests.swift
new file mode 100644
--- /dev/null
+++ b/VeilLinkTests/VeilImportStagingLeasePolicyTests.swift
@@ -0,0 +1,91 @@
+import Foundation
+import XCTest
+@testable import VeilLink
+
+final class VeilImportStagingLeasePolicyTests: XCTestCase {
+    private var temp: URL!
+    private let fm = FileManager.default
+
+    override func setUpWithError() throws {
+        temp = fm.temporaryDirectory.appendingPathComponent("VLLeaseTest-\(UUID().uuidString)", isDirectory: true)
+        try fm.createDirectory(at: temp, withIntermediateDirectories: true)
+    }
+
+    override func tearDownWithError() throws {
+        try? fm.removeItem(at: temp)
+    }
+
+    private func createLease(name: String = UUID().uuidString, root: URL? = nil) throws -> URL {
+        let anchor = root ?? VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let folder = anchor.appendingPathComponent(name, isDirectory: true)
+        try fm.createDirectory(at: folder, withIntermediateDirectories: true)
+        let file = folder.appendingPathComponent("snapshot.zip")
+        XCTAssertTrue(fm.createFile(atPath: file.path, contents: Data([1,2,3])))
+        return file
+    }
+
+    func testDeletesOnlyOwnedUUIDLease() throws {
+        let root = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let file = try createLease(root: root)
+        XCTAssertTrue(VeilImportStagingLeasePolicy.owns(file, root: root))
+        XCTAssertTrue(try VeilImportStagingLeasePolicy.removeOwnedCopy(file, root: root))
+        XCTAssertFalse(fm.fileExists(atPath: file.path))
+    }
+
+    func testRejectsLookalikeAndNonUUIDDirectory() throws {
+        let actualRoot = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let lookalike = temp.appendingPathComponent("outside/VeilLink-Import-Staging")
+        let foreign = try createLease(root: lookalike)
+        XCTAssertFalse(VeilImportStagingLeasePolicy.owns(foreign, root: actualRoot))
+        XCTAssertFalse(try VeilImportStagingLeasePolicy.removeOwnedCopy(foreign, root: actualRoot))
+        XCTAssertTrue(fm.fileExists(atPath: foreign.path))
+        let bogus = try createLease(name: "not-a-uuid", root: actualRoot)
+        XCTAssertFalse(try VeilImportStagingLeasePolicy.removeOwnedCopy(bogus, root: actualRoot))
+        XCTAssertTrue(fm.fileExists(atPath: bogus.path))
+    }
+
+    func testSweepKeepsFreshLease() throws {
+        let root = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let current = try createLease(root: root)
+        let result = try VeilImportStagingLeasePolicy.sweepExpired(root: root, now: Date(), lifetime: 3600)
+        XCTAssertEqual(result.removed, 0)
+        XCTAssertTrue(fm.fileExists(atPath: current.path))
+    }
+
+    func testSweepRemovesOnlyExpiredLease() throws {
+        let root = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let old = try createLease(root: root)
+        let fresh = try createLease(root: root)
+        let futureNow = Date().addingTimeInterval(100000)
+        try fm.setAttributes([.modificationDate: futureNow], ofItemAtPath: fresh.deletingLastPathComponent().path)
+        let result = try VeilImportStagingLeasePolicy.sweepExpired(root: root, now: futureNow, lifetime: 3600)
+        XCTAssertEqual(result.removed, 1)
+        XCTAssertFalse(fm.fileExists(atPath: old.path))
+        XCTAssertTrue(fm.fileExists(atPath: fresh.path))
+    }
+
+    func testSweepHonorsRemovalBudget() throws {
+        let root = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        let old = try (0..<3).map { _ in try createLease(root: root) }
+        let futureNow = Date().addingTimeInterval(100000)
+        let result = try VeilImportStagingLeasePolicy.sweepExpired(root: root, now: futureNow, lifetime: 3600, maxRemovals: 1)
+        XCTAssertEqual(result.removed, 1)
+        XCTAssertEqual(old.filter { fm.fileExists(atPath: $0.path) }.count, 2)
+    }
+
+    func testRejectsSymlinkLease() throws {
+        let root = VeilImportStagingLeasePolicy.stagingRoot(temporaryDirectory: temp)
+        try fm.createDirectory(at: root, withIntermediateDirectories: true)
+        let outside = temp.appendingPathComponent("outside", isDirectory: true)
+        try fm.createDirectory(at: outside, withIntermediateDirectories: true)
+        let file = outside.appendingPathComponent("snapshot.zip")
+        XCTAssertTrue(fm.createFile(atPath: file.path, contents: Data([1])))
+        let linked = root.appendingPathComponent(UUID().uuidString)
+        try fm.createSymbolicLink(at: linked, withDestinationURL: outside)
+        let spoof = linked.appendingPathComponent("snapshot.zip")
+        XCTAssertFalse(VeilImportStagingLeasePolicy.owns(spoof, root: root))
+        let result = try VeilImportStagingLeasePolicy.sweepExpired(root: root, now: Date().addingTimeInterval(1_000_000), lifetime: 1)
+        XCTAssertEqual(result.removed, 0)
+        XCTAssertTrue(fm.fileExists(atPath: file.path))
+    }
+}
