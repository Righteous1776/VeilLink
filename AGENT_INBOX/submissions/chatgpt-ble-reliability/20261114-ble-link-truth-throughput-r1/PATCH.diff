+    func testQueueStallDoesNotDestroyLiveGATTSessionRegardlessOfSignalQuality() {
+        // RSSI is intentionally absent from this decision. Weak signal is not
+        // an independent reason to declare a radio link disconnected.
+        XCTAssertEqual(
+            BLELinkReliabilityPolicy.stalledQueueAction(
+                physicalConnected: true, gattReady: true
+            ), .probeLiveChannel
+        )
+        XCTAssertEqual(
+            BLELinkReliabilityPolicy.stalledQueueAction(
+                physicalConnected: true, gattReady: false
+            ), .awaitGATTRecovery
+        )
+        XCTAssertEqual(
+            BLELinkReliabilityPolicy.stalledQueueAction(
+                physicalConnected: false, gattReady: false
+            ), .recycleAfterSystemDisconnect
+        )
+        // A stale GATT-ready flag cannot override an OS-confirmed PHY loss.
+        XCTAssertEqual(
+            BLELinkReliabilityPolicy.stalledQueueAction(
+                physicalConnected: false, gattReady: true
+            ), .recycleAfterSystemDisconnect
+        )
+    }
